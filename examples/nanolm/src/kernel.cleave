// nanoLM: a character-level language model of Zola's French (`doc/plan-nanolm.md`). The corpus
// is prepared and batched by the Rust host (`corpus.rs`, `data.rs`); line-for-line twin in
// `bench/nanolm-pytorch`.
//
// For now, the baseline every model must beat: a bigram model, the probability of a character
// given the one before, counted over training batches (add-one smoothing) and measured on the
// validation book.
use num;
use convert;

// Batches of 32 sequences of 128 characters, flattened, filled by the host.
extern fn train_inputs(i: i32) -> [i32; 4096];
extern fn train_targets(i: i32) -> [i32; 4096];
extern fn val_inputs(i: i32) -> [i32; 4096];
extern fn val_targets(i: i32) -> [i32; 4096];

// Mean cross-entropy, in nats per character, of the bigram model counted over `train_batches`
// batches, on `val_batches` validation batches.
export fn bigram_baseline(train_batches: i32, val_batches: i32) -> f32 {
    let mut counts: [[f32; 104]; 104] = mlir::memref::alloc();
    for a in 0..104 { for b in 0..104 { counts[a, b] = 1.0; }; };
    for s in 0..train_batches {
        let x = train_inputs(s);
        let y = train_targets(s);
        for k in 0..4096 { counts[x[k], y[k]] = counts[x[k], y[k]] + 1.0; };
    };
    let mut row_total: [f32; 104] = mlir::memref::alloc();
    for a in 0..104 {
        let mut t = 0.0;
        for b in 0..104 { t = t + counts[a, b]; };
        row_total[a] = t;
    };
    // Per batch in f32, across batches in f64: 200k terms summed into one f32 lose the third
    // decimal.
    let mut total: f64 = 0.0;
    for s in 0..val_batches {
        let x = val_inputs(s);
        let y = val_targets(s);
        let mut batch_total = 0.0;
        for k in 0..4096 { batch_total = batch_total + log(row_total[x[k]]) - log(counts[x[k], y[k]]); };
        total = total + batch_total.to();
    };
    (total / (val_batches * 4096).to()).to()
}
