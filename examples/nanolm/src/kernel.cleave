// nanoLM: a language model of 19th-century French (`doc/plan-nanolm.md`), over BPE tokens. The
// corpus is prepared, tokenized and batched by the Rust host (`corpus.rs`, `bpe.rs`, `data.rs`);
// line-for-line twin in `bench/nanolm-pytorch`. Losses are in nats per token (the host also
// reports them per character).
//
// For now, the baseline every model must beat: a bigram model, the probability of a token given
// the one before, counted over training batches (add-one smoothing) and measured on the
// validation book. Then the same model learned by gradient descent, which must converge to it.
use num;
use convert;
use nn;
use io;
use checkpoint;

// Batches of 32 sequences of `CONTEXT` tokens (`ROWS` in all), flattened, filled by the host.
extern fn train_inputs(i: i32) -> [i32; ROWS];
extern fn train_targets(i: i32) -> [i32; ROWS];
extern fn val_inputs(i: i32) -> [i32; ROWS];
extern fn val_targets(i: i32) -> [i32; ROWS];

// Mean cross-entropy, in nats per character, of the bigram model counted over `train_batches`
// batches, on `val_batches` validation batches.
export fn bigram_baseline(train_batches: i32, val_batches: i32) -> f32 {
    let mut counts: [[f32; VOCAB]; VOCAB] = mlir::memref::alloc();
    for a in 0..VOCAB { for b in 0..VOCAB { counts[a, b] = 1.0; }; };
    for s in 0..train_batches {
        let x = train_inputs(s);
        let y = train_targets(s);
        for k in 0..ROWS { counts[x[k], y[k]] = counts[x[k], y[k]] + 1.0; };
    };
    let mut row_total: [f32; VOCAB] = mlir::memref::alloc();
    for a in 0..VOCAB {
        let mut t = 0.0;
        for b in 0..VOCAB { t = t + counts[a, b]; };
        row_total[a] = t;
    };
    // Per batch in f32, across batches in f64: 200k terms summed into one f32 lose the third
    // decimal.
    let mut total: f64 = 0.0;
    for s in 0..val_batches {
        let x = val_inputs(s);
        let y = val_targets(s);
        let mut batch_total = 0.0;
        for k in 0..ROWS { batch_total = batch_total + log(row_total[x[k]]) - log(counts[x[k], y[k]]); };
        total = total + batch_total.to();
    };
    (total / (val_batches * ROWS).to()).to()
}

// The bigram model learned: row `a` of the table holds the logits of the character after `a`.
struct Bigram { table: Tensor<f32, VOCAB, VOCAB> }
impl Trainable<Bigram> {}

// Summed over the batch's `ROWS` predictions (`lr` is scaled accordingly by Adam's normalization).
fn loss(x: [i32; ROWS], y: [i32; ROWS], m: Bigram) -> f32 {
    sparse_cross_entropy(embed(m.table, x), y)
}

model_grad = grad(loss, m);

// Mean cross-entropy in nats per character over `batches` validation batches.
fn validation_loss(m: Bigram, batches: i32) -> f32 {
    let mut total: f64 = 0.0;
    for s in 0..batches { total = total + loss(val_inputs(s), val_targets(s), m).to(); };
    (total / (batches * ROWS).to()).to()
}

// `rounds` of 100 Adam steps, the validation loss printed after each.
export fn train_bigram(rounds: i32, lr: f32, seed: i64) -> f32 {
    rand_seed(seed);
    let mut m = Bigram(table: Init::xavier());
    let opt = Adam(lr: lr, beta1: 0.9, beta2: 0.999, eps: 0.00000001);
    let mut state = init_state(opt, m);
    println(("step 0, validation: ", validation_loss(m, 10)));
    for r in 0..rounds {
        for k in 0..100 {
            let s = r * 100 + k;
            (m, state) = step(opt, m, model_grad(train_inputs(s), train_targets(s), m), state);
        };
        println(("step ", (r + 1) * 100, ", validation: ", validation_loss(m, 10)));
    };
    validation_loss(m, 50)
}

// The first network: each character's id to a vector (`emb`), then a two-layer MLP with GELU to the
// logits of the next character. Still one character of context, so it can do no better than the
// bigram; it's the whole gradient path (embedding, dense layers, GELU, loss) checked against the
// PyTorch twin (`bench/nanolm-pytorch/mlp.py`), from the same initial weights.
struct Lm { emb: Tensor<f32, VOCAB, 64>, l1: Dense<f32, 64, 256>, l2: Dense<f32, 256, VOCAB> }
impl Trainable<Lm> {}

fn logits(x: [i32; ROWS], m: Lm) -> Tensor<f32, ROWS, VOCAB> {
    m.l2.dense_forward(gelu(m.l1.dense_forward(embed(m.emb, x))))
}

fn lm_loss(x: [i32; ROWS], y: [i32; ROWS], m: Lm) -> f32 {
    sparse_cross_entropy(logits(x, m), y)
}

lm_grad = grad(lm_loss, m);

fn lm_validation_loss(m: Lm, batches: i32) -> f32 {
    let mut total: f64 = 0.0;
    for s in 0..batches { total = total + lm_loss(val_inputs(s), val_targets(s), m).to(); };
    (total / (batches * ROWS).to()).to()
}

// Writes the initial weights to `lm_init.ckpt` (in the working directory) for the twin, then
// trains `rounds` of 100 Adam steps.
export fn train_lm(rounds: i32, lr: f32, seed: i64) -> f32 {
    rand_seed(seed);
    let mut m = Lm(emb: Init::xavier(), l1: Init::he(), l2: Init::xavier());
    save("lm_init.ckpt", m);
    let opt = Adam(lr: lr, beta1: 0.9, beta2: 0.999, eps: 0.00000001);
    let mut state = init_state(opt, m);
    println(("step 0, validation: ", lm_validation_loss(m, 10)));
    for r in 0..rounds {
        for k in 0..100 {
            let s = r * 100 + k;
            (m, state) = step(opt, m, lm_grad(train_inputs(s), train_targets(s), m), state);
        };
        println(("step ", (r + 1) * 100, ", validation: ", lm_validation_loss(m, 10)));
    };
    lm_validation_loss(m, 50)
}

// ------------------------------------------------------------------ the transformer
//
// A GPT with the recipe of today's transformers (Llama, Qwen, Gemma), at a size set by the
// `define`s below (overridable from `build.rs`): a token embedding of width `WIDTH`, `LAYERS` blocks,
// a final RMSNorm, and the output scored against the same embedding (a tied head,
// `embedding_logits`). Activations are `[ROWS, WIDTH]` matrices, the 32 sequences of a batch
// (`data.rs`) stacked as rows. Each block is pre-norm: `x + attention(rms_norm(x))`, then `x +
// swiglu(rms_norm(x))`; the attention is causal over heads `HEAD` wide, its queries and keys
// rotated by their position (RoPE, so no position table); the MLP is SwiGLU, `WIDTH -> HIDDEN ->
// WIDTH`. Trained by Muon (hidden matrices) and AdamW (embedding, gains, biases), the gradient
// clipped. The twin (`bench/nanolm-pytorch/gpt.py`) reads its sizes from these `define`s.

define WIDTH: i32 = 384;
define LAYERS: i32 = 8;
define HEAD: i32 = 64;
// SwiGLU's three matrices at 8/3 `WIDTH` hold what a GELU MLP's two hold at 4 `WIDTH`.
define HIDDEN: i32 = 1024;
// Tokens per sequence and rows per batch: `data.rs`'s `T` and `B * T`.
define CONTEXT: i32 = 256;
define ROWS: i32 = 32 * CONTEXT;
// Tokens: `bpe.rs`'s vocabulary, the 104 characters and the merges learned over them.
define VOCAB: i32 = 4096;

// Linear warmup over `WARMUP` steps, then a linear decay to a tenth of the rate at `DECAY_STEPS`,
// flat after: a function of the step alone, so a resumed run continues the same schedule. Muon's
// rate follows the same schedule from its own base.
define WARMUP: i32 = 200;
define DECAY_STEPS: i32 = 20000;
define MUON_LR: f32 = 0.02;
// The gradient's norm is clipped at 1 per row: the loss is summed over the batch's `ROWS`.
define CLIP_PER_ROW: f32 = 1.0;

struct Block {
    n1: Tensor<f32, 1, WIDTH>,
    wq: Dense<f32, WIDTH, WIDTH>, wk: Dense<f32, WIDTH, WIDTH>, wv: Dense<f32, WIDTH, WIDTH>, wo: Dense<f32, WIDTH, WIDTH>,
    n2: Tensor<f32, 1, WIDTH>,
    mlp: SwiGlu<f32, WIDTH, HIDDEN>
}
impl Trainable<Block> {}

struct Gpt {
    tok: Embedding<f32, VOCAB, WIDTH>,
    blocks: [Block; LAYERS],
    nf: Tensor<f32, 1, WIDTH>
}
impl Trainable<Gpt> {}

// The model's size, for the host to name its checkpoint directory (`main.rs`).
export fn gpt_width() -> i32 { WIDTH }
export fn gpt_layers() -> i32 { LAYERS }

fn ones() -> Tensor<f32, 1, WIDTH> { [for i in 0..1: [for j in 0..WIDTH: 1.0]] }

fn new_block() -> Block {
    Block(
        n1: ones(),
        wq: Init::xavier(), wk: Init::xavier(), wv: Init::xavier(), wo: Init::xavier(),
        n2: ones(),
        mlp: Init::xavier()
    )
}

fn new_gpt() -> Gpt {
    Gpt(tok: Init::xavier(), blocks: [for i in 0..LAYERS: new_block()], nf: ones())
}

// Not inlined: called `LAYERS` times per forward pass, each call a whole block of work, compiled
// once per row count instead of once per layer (the training gradient is synthesized from its body by the
// e-graph, unaffected). Rows are whole sequences of `CONTEXT`: row `r` is position `r mod CONTEXT`.
#[no_inline]
fn block<const N: i32>(x: Tensor<f32, N, WIDTH>, b: Block) -> Tensor<f32, N, WIDTH> {
    let shape = AttentionShape::<CONTEXT, HEAD>();
    let h = rms_norm(x, b.n1);
    let q = rope(b.wq.dense_forward(h), shape);
    let k = rope(b.wk.dense_forward(h), shape);
    let a = causal_attention(q, k, b.wv.dense_forward(h), shape);
    let x2 = x + b.wo.dense_forward(a);
    x2 + b.mlp.swiglu_forward(rms_norm(x2, b.n2))
}

// Any number of rows `N`, whole sequences of `CONTEXT`: a micro-batch (`MICRO`), or the one
// sequence generation reads (`CONTEXT`).
fn gpt_logits<const N: i32>(x: [i32; N], m: Gpt) -> Tensor<f32, N, VOCAB> {
    let h0 = embedding_forward(m.tok, x);
    let mut h = h0;
    for i in 0..LAYERS { h = block(h, m.blocks[i]); };
    embedding_logits(m.tok, rms_norm(h, m.nf))
}

// Data parallelism (`doc/plan-spawn.md`): a batch's `ROWS` split into `SPLIT`
// micro-batches of whole sequences, each one's gradient computed in its own
// task, the gradients summed. The loss is a sum over rows, so the sum of the
// parts' gradients is the batch's gradient (up to the order of the float
// additions).
define SPLIT: i32 = 8;
define MICRO: i32 = ROWS / SPLIT;

fn gpt_loss_micro(x: [i32; MICRO], y: [i32; MICRO], m: Gpt) -> f32 {
    sparse_cross_entropy(gpt_logits(x, m), y)
}

gpt_grad_micro = grad(gpt_loss_micro, m);

// Micro-batch `j` of a batch: rows `j * MICRO ..`.
fn micro(a: [i32; ROWS], j: i32) -> [i32; MICRO] { [for k in 0..MICRO: a[j * MICRO + k]] }

fn parallel_grad(x: [i32; ROWS], y: [i32; ROWS], m: Gpt) -> Gpt {
    let g = [for j in 0..SPLIT: spawn gpt_grad_micro(micro(x, j), micro(y, j), m)];
    // A balanced tree, in a fixed order: the same result whatever the thread count.
    accumulate(accumulate(accumulate(g[0], g[1]), accumulate(g[2], g[3])), accumulate(accumulate(g[4], g[5]), accumulate(g[6], g[7])))
}

// A batch's summed loss, its micro-batches evaluated in parallel as the gradient's are, summed in
// a fixed order.
fn parallel_loss(x: [i32; ROWS], y: [i32; ROWS], m: Gpt) -> f64 {
    let parts = [for j in 0..SPLIT: spawn gpt_loss_micro(micro(x, j), micro(y, j), m)];
    let mut total: f64 = 0.0;
    for j in 0..SPLIT { total = total + parts[j].to(); };
    total
}

fn gpt_validation_loss(m: Gpt, batches: i32) -> f32 {
    let mut total: f64 = 0.0;
    for s in 0..batches { total = total + parallel_loss(val_inputs(s), val_targets(s), m); };
    (total / (batches * ROWS).to()).to()
}

// The loss on training batches `first..first + batches` (the round's last ones, just trained on):
// next to the validation loss, whether the model under- or over-fits.
fn gpt_train_loss(m: Gpt, first: i32, batches: i32) -> f32 {
    let mut total: f64 = 0.0;
    for s in first..first + batches { total = total + parallel_loss(train_inputs(s), train_targets(s), m); };
    (total / (batches * ROWS).to()).to()
}

fn learning_rate(s: i32, base: f32) -> f32 {
    if s < WARMUP {
        base * (s + 1).to() / WARMUP.to()
    } else {
        let t: f32 = (s - WARMUP).to() / (DECAY_STEPS - WARMUP).to();
        if t < 1.0 { base * (1.0 - 0.9 * t) } else { base * 0.1 }
    }
}

// Step `s`'s optimizer: Muon on the hidden matrices, AdamW (base rate `lr`) on the rest.
fn optimizer(s: i32, lr: f32) -> Muon {
    Muon(
        lr: learning_rate(s, MUON_LR), momentum: 0.95, weight_decay: 0.0,
        adamw: AdamW(lr: learning_rate(s, lr), beta1: 0.9, beta2: 0.95, eps: 0.00000001, weight_decay: 0.0)
    )
}

// The end of a round, for the host to report with timings (`main.rs`).
extern fn round_done(step: i32, train_loss: f32, validation_loss: f32, rate: f32);

// Writes the initial weights to `gpt_init.ckpt` for the twin, trains `rounds` of `per_round`
// steps starting at step `first` (batches and learning rates are functions of the step, so a
// resumed run continues the same sequence), checkpointing the model, optimizer state and random
// generator to `gpt.ckpt` after each round. Checkpoints live in the working directory, one per
// model size (`main.rs`). `lr` is AdamW's base rate, the one reported.
export fn train_gpt(first: i32, rounds: i32, per_round: i32, lr: f32, seed: i64, resume: bool) -> f32 {
    rand_seed(seed);
    let clip: f32 = CLIP_PER_ROW * ROWS.to();
    let fresh = new_gpt();
    let mut m = fresh;
    let mut state = init_state(optimizer(first, lr), fresh);
    if resume {
        let (rm, rs, rseed) = restore("gpt.ckpt", (fresh, init_state(optimizer(first, lr), fresh), 0:i64));
        m = rm;
        state = rs;
        rand_seed(rseed);
    } else {
        save("gpt_init.ckpt", m);
    };
    round_done(first, 0.0, gpt_validation_loss(m, 4), learning_rate(first, lr));
    for r in 0..rounds {
        for k in 0..per_round {
            let s = first + r * per_round + k;
            let g = clip_grad_norm(parallel_grad(train_inputs(s), train_targets(s), m), clip);
            (m, state) = step(optimizer(s, lr), m, g, state);
        };
        save("gpt.ckpt", (m, state, rand_state()));
        let next = first + (r + 1) * per_round;
        round_done(next, gpt_train_loss(m, next - 4, 4), gpt_validation_loss(m, 4), learning_rate(next, lr));
    };
    gpt_validation_loss(m, 20)
}

// ------------------------------------------------------------------ generation

// The prompt, encoded by the host (`main.rs`), left-aligned in a context of `CONTEXT`; its length.
extern fn prompt_ids() -> [i32; CONTEXT];
extern fn prompt_len() -> i32;
// Prints one generated token.
extern fn emit_token(t: i32);

// Continues the prompt for `count` tokens with the model saved in `gpt.ckpt`, each drawn from the
// next-token distribution at `temperature`, among the nucleus of the most likely tokens holding
// `top_p` of the probability (`sample_row_top_p`; 1 keeps every token). The context slides once
// it holds `CONTEXT`.
export fn generate(count: i32, temperature: f32, top_p: f32, seed: i64) -> i32 {
    let fresh = new_gpt();
    let (m, _, _) = restore("gpt.ckpt", (fresh, init_state(optimizer(0, 0.001), fresh), 0:i64));
    rand_seed(seed);
    let mut ctx = prompt_ids();
    let mut len = prompt_len();
    for g in 0..count {
        let c = sample_row_top_p(gpt_logits(ctx, m), len - 1, temperature, top_p);
        emit_token(c);
        if len < CONTEXT {
            ctx[len] = c;
            len = len + 1;
        } else {
            for k in 0..CONTEXT - 1 { ctx[k] = ctx[k + 1]; };
            ctx[CONTEXT - 1] = c;
        };
    };
    count
}
