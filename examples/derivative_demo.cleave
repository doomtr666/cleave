use io;

// `doc/backlog-done.md`'s own auto-diff items -- two separate keywords,
// two separate algorithms, both mechanically synthesized by e-graph
// rewriting (`egraph.rs`), neither ever hand-derived:
//
// - `derive(f, param)` -- forward-mode, general-purpose: works for any
//   return shape (`doc/backlog.md`'s own "gradient w.r.t. a struct
//   parameter" item), but each call costs O(graph size) *per parameter
//   named* -- a genuine multi-parameter Jacobian needs one separate
//   `derive(f, param)` declaration per parameter (below), not one call
//   computing all of them together.
// - `grad(f, param)` -- reverse-mode (real backprop), narrower on purpose:
//   `f` must return a scalar (`f32`/`f64`), the same contract every real ML
//   framework's own `grad`/`backward` has -- a real training loop
//   (`examples/xor_tensor.cleave`) uses `derive()` still, `examples/
//   digits-interop`'s own `Network` uses `grad()` -- picking the right one
//   is a real, per-function decision, not "always prefer the newer one".
//
// **Both keywords used to also accept a bare `f`, with no named parameter
// at all, synthesizing every parameter's own gradient at once into an
// n-tuple.** Removed, deliberately, not merely deprecated
// (`grammar.pest`'s own `derive_decl` doc comment has the full "why" --
// found, precisely, to have cost a real, measured `~31%` more FLOPs than
// strictly needed in `examples/mnist-interop`'s own real training loop, a
// whole discarded gradient computed and thrown away every single batch).
// A genuine Jacobian (both `dx`/`dy` below, actually read) is exactly as
// cheap either way -- two independent, single-target calls, neither one
// ever computing the other's own share of the work -- so there's no longer
// a tuple-returning form to reach for by accident.
//
// `loss(x, y) = x^2 + y^2` -- a toy squared-error-style loss, exactly the
// shape a real gradient-descent step would need the gradient of.
fn loss(x: f32, y: f32) -> f32 { x * x + y * y }
dloss_x = derive(loss, x);
dloss_y = derive(loss, y);
gloss_x = grad(loss, x);
gloss_y = grad(loss, y);

fn main() -> i32 {
    print(dloss_x(3.0, 4.0)); // 6.0  =  2 * 3.0
    print(dloss_y(3.0, 4.0)); // 8.0  =  2 * 4.0

    // Reverse-mode agrees exactly -- same math, a different algorithm.
    print(gloss_x(3.0, 4.0)); // 6.0
    print(gloss_y(3.0, 4.0)); // 8.0
    0
}
