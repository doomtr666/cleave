use io;
use nn;
use linalg;

// The tensorial reformulation of `examples/xor.cleave` -- same 2-input,
// 2-hidden-neuron, 1-output network, same SGD training loop, same truth
// table -- but the weights are packed into real `linalg::Tensor` matrices
// and the linear part of each layer is a real `matmul`, not nine separate
// scalar multiplies. `doc/backlog.md`'s own "toward tensorial ML" roadmap
// item this example was the whole point of.
//
// Getting here needed three real, separate compiler bugs found and fixed
// (`doc/backlog.md`'s own "Differentiating a struct/array construction" and
// "Toward a matmul-based tensorial XOR" entries have the full story):
// differentiating a `Tensor` *construction* itself (`d(Tensor(data:[w1,
// w2]))`) had no rule at all; `MatMul<A,B,C>`'s own new product-rule
// derivative needed a real per-parameter type environment (a multi-target
// algebra's own "add" call resolves at `C` alone, not the whole "A,B,C"
// combined type); and `derivative-independent-zero` needed to build a real
// *tensor*-shaped zero, not a bare scalar `0.0`, for an independent tensor
// value (the input `x`) -- plus a genuine monomorphization-ordering gap
// (`Ring<Tensor<...>>::add`, a generic impl nothing here calls directly,
// needed preemptive seeding once a `derivative` rule turned out to
// reference it).
//
// Still scoped, deliberately, not a full framework: `Activation<Tensor<T,
// Dims...>>` is only declared for *rank 1* (`impl<T,const N:i32> Activation
// <Tensor<T,N>>`, `stdlib/nn/nn.cleave`) -- extending it to the same
// pack-generic shape `Ring<Tensor<T,Dims...>>` already has is real,
// separate stdlib work, not attempted here. `sigmoid2` below applies the
// ordinary scalar `sigmoid` element-by-element instead (extract via
// `Index`, apply, rebuild via construction) -- a real, common pattern when
// a framework has no fused elementwise op for a given rank, not a
// workaround for a compiler bug: every mechanism it uses (`Index`'s own
// `derivative` rule, the construction-derivative rule, scalar `sigmoid`'s
// own composed derivative) was already proven correct independently before
// this example was written.
fn sigmoid2(t: Tensor<f32, 1, 2>) -> Tensor<f32, 1, 2> {
    Tensor::<f32, 1, 2>(data: [[sigmoid(t[0, 0]), sigmoid(t[0, 1])]])
}

// `x` is a `1x2` row (a single training example, not a batch -- SGD, same
// reasoning `examples/xor.cleave` itself documents: batching all four
// points into one `derive()`d function pushes e-graph saturation past its
// own time limit) so it can be a real `matmul` left operand directly.
fn forward(x1: f32, x2: f32, w1: f32, w2: f32, w3: f32, w4: f32, b1a: f32, b1b: f32, w5: f32, w6: f32, b2a: f32) -> f32 {
    let x = Tensor::<f32, 1, 2>(data: [[x1, x2]]);
    let w = Tensor::<f32, 2, 2>(data: [[w1, w2], [w3, w4]]);
    let b1 = Tensor::<f32, 1, 2>(data: [[b1a, b1b]]);
    let h = sigmoid2(matmul(x, w) + b1);
    let w2m = Tensor::<f32, 2, 1>(data: [[w5], [w6]]);
    let b2 = Tensor::<f32, 1, 1>(data: [[b2a]]);
    let out = matmul(h, w2m) + b2;
    sigmoid(out[0, 0])
}

fn loss(x1: f32, x2: f32, y: f32, w1: f32, w2: f32, w3: f32, w4: f32, b1a: f32, b1b: f32, w5: f32, w6: f32, b2a: f32) -> f32 {
    let pred = forward(x1, x2, w1, w2, w3, w4, b1a, b1b, w5, w6, b2a);
    let err = pred - y;
    err * err
}

grad = derive(loss);

fn main() -> i32 {
    // Same broken-symmetry init `examples/xor.cleave` uses, same reason:
    // identical starting weights for both hidden neurons would keep them
    // computing the same function forever.
    let mut w1: f32 = 0.5; let mut w2: f32 = 0.5;
    let mut w3: f32 = 0.5; let mut w4: f32 = -0.5;
    let mut b1a: f32 = -0.2; let mut b1b: f32 = -0.2;
    let mut w5: f32 = 1.0; let mut w6: f32 = -1.0;
    let mut b2a: f32 = 0.0;
    let lr: f32 = 1.0;

    let x1s: [f32; 4] = [0.0, 0.0, 1.0, 1.0];
    let x2s: [f32; 4] = [0.0, 1.0, 0.0, 1.0];
    let ys: [f32; 4] = [0.0, 1.0, 1.0, 0.0];

    print("training...");
    for step in 0..4000 {
        let i: i32 = step - (step / 4) * 4;
        // `grad`'s own returned Jacobian has one entry per `loss` parameter,
        // in declared order -- indices 0-2 are the unused partials w.r.t.
        // the data (`x1`, `x2`, `y`), 3-11 are the nine real weights/biases.
        let g = grad(x1s[i], x2s[i], ys[i], w1, w2, w3, w4, b1a, b1b, w5, w6, b2a);
        w1 = w1 - lr * g[3]; w2 = w2 - lr * g[4];
        w3 = w3 - lr * g[5]; w4 = w4 - lr * g[6];
        b1a = b1a - lr * g[7]; b1b = b1b - lr * g[8];
        w5 = w5 - lr * g[9]; w6 = w6 - lr * g[10];
        b2a = b2a - lr * g[11];
    };
    print("done !");

    // Expected: close to 0, 1, 1, 0.
    print(forward(0.0, 0.0, w1, w2, w3, w4, b1a, b1b, w5, w6, b2a));
    print(forward(0.0, 1.0, w1, w2, w3, w4, b1a, b1b, w5, w6, b2a));
    print(forward(1.0, 0.0, w1, w2, w3, w4, b1a, b1b, w5, w6, b2a));
    print(forward(1.0, 1.0, w1, w2, w3, w4, b1a, b1b, w5, w6, b2a));
    0
}
