use io;
use nn;
use linalg;

// The tensorial reformulation of `examples/xor.cleave` -- same 2-input,
// 2-hidden-neuron, 1-output network, same SGD training loop, same truth
// table -- with the weights bundled into a real `Network` struct of `Dense`
// layers (`stdlib/nn/nn.cleave`) instead of eleven loose scalar parameters
// passed by hand. That original, flatter version is what first prompted
// this rewrite -- raised directly, not a hypothetical: a real `forward`
// taking 11 positional `f32`s in a row was unreadable and error-prone to
// call correctly, and gave no way to grow the network without growing the
// parameter list further.
//
// Three more real, separate compiler bugs were found and fixed getting
// *here*, none anticipated by the plan that scoped this rewrite (`doc/
// backlog.md`'s own "toward tensorial ML" entries have the fuller story,
// alongside the derive()-on-a-struct-parameter work this itself builds on):
// a generic inherent-impl method's body (`Dense::forward`) calling a still-
// generic algebra method (`matmul`) was silently dropped by `monomorphize`'s
// own single-pass, non-fixed-point worklist draining -- no prior inherent
// method had ever called anything but a concrete/extern op, so this never
// came up before `Dense`; two-level struct nesting (`Network` containing a
// `Dense` containing a `Tensor`) for `derive()` needed no fix at all, worth
// noting since it was genuinely unverified before this file (confirmed
// directly with a minimal probe first, not assumed); and updating a
// `Tensor`-typed weight via SGD (`w = w - lr * grad`) needed a real new
// `Scale<Container,T>` algebra (`stdlib/linalg/tensor.cleave`) -- `Ring<T>`
// alone can't express a scalar-times-tensor broadcast, both its own
// operands always being the same type.
//
// `x` is a `1x2` row (a single training example, not a batch -- SGD, same
// reasoning `examples/xor.cleave` itself documents: batching all four
// points into one `derive()`d function pushes e-graph saturation past its
// own time limit) so it can be a real `matmul` left operand directly.
struct Network { l1: Dense<f32, 2, 2>, l2: Dense<f32, 2, 1> }

fn forward(x1: f32, x2: f32, net: Network) -> f32 {
    let x = Tensor::<f32, 1, 2>(data: [[x1, x2]]);
    let h = sigmoid(net.l1.forward(x));
    let out = sigmoid(net.l2.forward(h));
    out[0, 0]
}

fn loss(x1: f32, x2: f32, y: f32, net: Network) -> f32 {
    let pred = forward(x1, x2, net);
    let err = pred - y;
    err * err
}

grad = derive(loss);

fn main() -> i32 {
    // Real Xavier/Glorot init now (`Init<T>::xavier`, `stdlib/nn/nn.cleave`)
    // -- the standard choice for a `sigmoid`-activated network like this one
    // -- instead of a hand-picked literal. Still achieves the same "broken-
    // symmetry" property `examples/xor.cleave` documents needing (identical
    // starting weights for both hidden neurons would keep them computing the
    // same function forever): `xavier()` draws every weight independently,
    // so the two hidden neurons start different almost surely. `rand_seed`
    // (transitively available -- `use nn;` above already pulls in `use
    // rand;`, `stdlib/nn/nn.cleave`'s own doc comment) fixes this example's
    // own run to be reproducible; this particular seed is simply one that's
    // been confirmed to converge well within the step budget below, not
    // special otherwise -- any seed does, this one's just pinned for a
    // stable, repeatable `--run`.
    rand_seed(2);
    let mut net: Network = Network(l1: Init::xavier(), l2: Init::xavier());
    let lr: f32 = 1.0;

    let x1s: [f32; 4] = [0.0, 0.0, 1.0, 1.0];
    let x2s: [f32; 4] = [0.0, 1.0, 0.0, 1.0];
    let ys: [f32; 4] = [0.0, 1.0, 1.0, 0.0];

    print("training...");
    for step in 0..4000 {
        let i: i32 = step - (step / 4) * 4;
        // `grad`'s own returned Jacobian has one entry per `loss` parameter,
        // in declared order -- `g.0`/`g.1`/`g.2` are the unused partials
        // w.r.t. the data (`x1`, `x2`, `y`), `g.3` is the real one: a whole
        // `Network`-shaped gradient, one `Tensor` per `Dense` field, same
        // shape as `net` itself.
        let g = grad(x1s[i], x2s[i], ys[i], net);
        net.l1.w = Ring::sub(net.l1.w, Scale::scale(g.3.l1.w, lr));
        net.l1.b = Ring::sub(net.l1.b, Scale::scale(g.3.l1.b, lr));
        net.l2.w = Ring::sub(net.l2.w, Scale::scale(g.3.l2.w, lr));
        net.l2.b = Ring::sub(net.l2.b, Scale::scale(g.3.l2.b, lr));
    };
    print("done !");

    // Expected: close to 0, 1, 1, 0.
    print(forward(0.0, 0.0, net));
    print(forward(0.0, 1.0, net));
    print(forward(1.0, 0.0, net));
    print(forward(1.0, 1.0, net));
    0
}
