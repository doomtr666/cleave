// MNIST handwritten digits (28x28 grayscale, 10 classes): a 784 -> 512 -> 256 -> 128 -> 10 ReLU MLP,
// trained with plain SGD on a sum-of-squares loss against one-hot targets. The data is loaded by the
// Rust host (`data.rs`) and handed over one batch per `extern` call. Line-for-line twin of
// `bench/mnist-pytorch/mnist_bench.py`.
use nn;
use linalg;
use io;

extern fn train_len() -> i32;
extern fn test_len() -> i32;
extern fn test_label(sample: i32) -> i32;
extern fn train_batch_pixels(sample: i32, out: [[f32; 784]; 32]);
extern fn train_batch_targets(sample: i32, out: [[f32; 10]; 32]);
extern fn test_batch_pixels(sample: i32, out: [[f32; 784]; 80]);
// Marks the end of training, so the host times training alone (`main.rs`).
extern fn training_done();

struct Network {
    l1: Dense<f32, 784, 512>,
    l2: Dense<f32, 512, 256>,
    l3: Dense<f32, 256, 128>,
    l4: Dense<f32, 128, 10>
}
struct NetworkState<StateL1, StateL2, StateL3, StateL4> {
    l1: StateL1,
    l2: StateL2,
    l3: StateL3,
    l4: StateL4
}

impl<Opt, StateL1, StateL2, StateL3, StateL4>
    Optimizer<Opt, Network, NetworkState<StateL1, StateL2, StateL3, StateL4>>
{
    fn init_state(opt, model) {
        NetworkState(
            l1: init_state(opt, model.l1),
            l2: init_state(opt, model.l2),
            l3: init_state(opt, model.l3),
            l4: init_state(opt, model.l4)
        )
    }
    fn step(opt, model, grad, state) {
        let (l1, s1) = step(opt, model.l1, grad.l1, state.l1);
        let (l2, s2) = step(opt, model.l2, grad.l2, state.l2);
        let (l3, s3) = step(opt, model.l3, grad.l3, state.l3);
        let (l4, s4) = step(opt, model.l4, grad.l4, state.l4);
        (
            Network(l1: l1, l2: l2, l3: l3, l4: l4),
            NetworkState(l1: s1, l2: s2, l3: s3, l4: s4)
        )
    }
}

fn load_train_batch_input(batch_start: i32) -> Tensor<f32, 32, 784> {
    let mut pixels: [[f32; 784]; 32] = mlir::memref::alloc();
    train_batch_pixels(batch_start, pixels);
    Tensor(data: pixels)
}

fn load_train_batch_target(batch_start: i32) -> Tensor<f32, 32, 10> {
    let mut t: [[f32; 10]; 32] = mlir::memref::alloc();
    train_batch_targets(batch_start, t);
    Tensor(data: t)
}

fn load_test_batch_input(batch_start: i32) -> Tensor<f32, 80, 784> {
    let mut pixels: [[f32; 784]; 80] = mlir::memref::alloc();
    test_batch_pixels(batch_start, pixels);
    Tensor(data: pixels)
}

// Raw logits, no final activation.
fn forward(x, net: Network) {
    let h1 = relu(net.l1.dense_forward(x));
    let h2 = relu(net.l2.dense_forward(h1));
    let h3 = relu(net.l3.dense_forward(h2));
    net.l4.dense_forward(h3)
}

// A sum over the batch, not a mean: `lr` is divided by the batch size instead.
fn loss(x: Tensor<f32, 32, 784>, y: Tensor<f32, 32, 10>, net: Network) -> f32 {
    let err = forward(x, net) - y;
    sum(err * err)
}

net_grad = grad(loss, net);

fn argmax_row(pred: Tensor<f32, 80, 10>, r: i32) -> i32 {
    let mut best = 0;
    let mut best_val = pred[r, 0];
    for c in 1..10 {
        if pred[r, c] > best_val {
            best_val = pred[r, c];
            best = c;
        };
    };
    best
}

// Batches of 80: 10,000 divides evenly, and a row count that isn't a multiple of 8 doesn't compile
// yet (`doc/backlog.md`, "A matmul whose row count isn't a multiple of the schedule's row tile").
fn evaluate(net: Network) -> f32 {
    let num_batches = test_len() / 80;
    let mut correct = 0;
    for s in 0..num_batches {
        let pred = forward(load_test_batch_input(s * 80), net);
        for r in 0..80 {
            if argmax_row(pred, r) == test_label(s * 80 + r) { correct = correct + 1; };
        };
    };
    correct.to() / (num_batches * 80).to()
}

export fn train_and_evaluate(epochs: i32, lr: f32, seed: i64) -> f32 {
    rand_seed(seed);
    // He init for the ReLU layers, Xavier for the output layer.
    let mut net = Network(l1: Init::he(), l2: Init::he(), l3: Init::he(), l4: Init::xavier());
    let opt = Sgd(lr: lr / 32.0);
    let mut state = init_state(opt, net);

    for epoch in 0..epochs {
        for s in 0..train_len() / 32 {
            let g = net_grad(load_train_batch_input(s * 32), load_train_batch_target(s * 32), net);
            (net, state) = step(opt, net, g, state);
        };
        println(("Epoch=", epoch));
    };
    training_done();
    evaluate(net)
}
