use io;

// A small, custom struct with its own declared algebra impl (`Ring<vec3<T>>`
// — same mechanism `doc/user_guide.md`'s own "Algebras: how operators
// actually work" section introduces with `Vec2`) plus real domain-specific
// operations `stdlib/linalg`'s generic `Tensor<T, Dims...>` genuinely can't
// give you for free: a 3-vector-specific *cross* product and a *dot*
// product. `Ring<Tensor<T,3>>`'s own `+`/`-` already cover the elementwise
// part (`examples/tensor_demo.cleave`) — this file is about the case where
// you still want your *own* struct: an operation with no generic-rank
// equivalent, and a name (`cross`) that would make no sense as an
// `algebra` at all (nothing else in this codebase would ever implement it).
struct vec3<T: Float> {
    x: T,
    y: T,
    z: T,
}

impl<T: Float> Ring<vec3<T>> {
    fn add(v1, v2) {
        vec3(x: v1.x + v2.x, y: v1.y + v2.y, z: v1.z + v2.z)
    }
    fn sub(v1, v2) {
        vec3(x: v1.x - v2.x, y: v1.y - v2.y, z: v1.z - v2.z)
    }
}

// Plain top-level `fn`s -- inherent impls (`impl struct vec3<T> { ... }`)
// aren't a language concept any more at all (`doc/backlog-done.md`'s own
// "impls inhérents" entry has the full story: `v.method(args)` is pure
// sugar over an ordinary top-level call now, so a method never needed its
// own separate declaration form in the first place). Originally written this
// way as a workaround, not a preference: a real, found-by-testing compiler
// bug, back when inherent impls still existed, meant a generic inherent
// method returning a *fresh* instance of the exact same struct type its own
// `impl` block targets (`fn cross(a, b) -> vec3<T> { vec3(...) }`, inside
// `impl<T: Float> struct vec3<T> { ... }`) failed at CPS/monomorphization
// time ("could not resolve method call `vec3::cross`"), even though the
// *identical* body worked fine as an ordinary top-level generic `fn` --
// moot now that the whole mechanism it was a bug *in* no longer exists.
fn cross<T: Float>(a: vec3<T>, b: vec3<T>) -> vec3<T> {
    vec3(
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x
    )
}
fn dot<T: Float>(a: vec3<T>, b: vec3<T>) -> T {
    a.x * b.x + a.y * b.y + a.z * b.z
}

fn print_vec(v) {
    print(v.x);
    print(v.y);
    print(v.z);
}

fn main() -> i32 {
    // The standard basis vectors -- i x j = k is the textbook check.
    let i = vec3(x: 1.0, y: 0.0, z: 0.0);
    let j = vec3(x: 0.0, y: 1.0, z: 0.0);
    let k = cross(i, j);
    print_vec(k); // (0, 0, 1)

    // `+`/`-` still dispatch through the declared `Ring<vec3<T>>` impl.
    let sum = i + j;
    let diff = j - i;
    print_vec(sum);  // (1, 1, 0)
    print_vec(diff); // (-1, 1, 0)

    // An array literal of struct-typed elements -- each `vec3` retained
    // correctly for as long as `points` itself is alive (`doc/backlog-
    // done.md`'s own "an array literal of struct-typed elements got no
    // Retain at all" entry — the exact shape that item's own regression
    // test uses).
    let points: [vec3<f32>; 3] = [i, j, k];
    print(dot(points[0], points[1])); // i . j = 0 (orthogonal)
    print(dot(points[2], points[2])); // k . k = 1 (unit length)

    0
}
