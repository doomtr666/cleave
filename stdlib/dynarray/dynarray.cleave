// `DynArray<T>` — a growable sequence, the default target of a comprehension
// whose length is only known at run time (`[for i in 0..n: ...]`). Plain
// stdlib over `Buffer<T>` (`stdlib/buffer`), which holds its elements and
// releases them when the last reference to it goes: a `DynArray` is a
// struct, hence a reference, mutated in place by `push`/`set` (`mut v`), and
// its buffer is its own, never handed out, so growing it in place is seen by
// every holder of the `DynArray`. `use dynarray;` explicitly: a program that
// never builds one sees no change.
use buffer;

struct DynArray<T> { buf: Buffer<T>, len: i32 }

// An empty `DynArray` with room for `initial_cap` elements before it grows.
fn dynarray_new<T>(initial_cap: i32) -> DynArray<T> {
    DynArray(buf: buffer_alloc(initial_cap), len: 0)
}

// `v.push(x)`/`v.pop()`/`v.get(i)`/`v.set(i, x)`/`v.len()`: plain top-level `fn`s,
// reached through dot syntax (`v.push(x)` is `push(v, x)`). Indices aren't
// checked.
fn push<T>(mut v: DynArray<T>, x: T) {
    let cap = buffer_capacity(v.buf);
    if v.len == cap {
        buffer_grow(v.buf, if cap == 0 { 4 } else { 2 * cap });
    };
    buffer_set(v.buf, v.len, x);
    v.len = v.len + 1;
}
// The last element, removed. The `DynArray` must not be empty.
fn pop<T>(mut v: DynArray<T>) -> T {
    v.len = v.len - 1;
    buffer_take(v.buf, v.len)
}
fn get<T>(v: DynArray<T>, i: i32) -> T { buffer_get(v.buf, i) }
fn set<T>(v: DynArray<T>, i: i32, x: T) { buffer_set(v.buf, i, x); }
impl<T> Len<DynArray<T>> {
    fn len(v) { v.len }
}

// `v[i]` (read), through `Index` as a tensor's element. Writing goes through
// `v.set(i, x)`: `infer.rs` rejects a non-array `Index` assignment target.
impl<T> Index<DynArray<T>, T> {
    fn index(v: DynArray<T>, idx: [i32; 1]) -> T { buffer_get(v.buf, idx[0]) }
}

// A `DynArray` seeded by a comprehension (`Generate`, `stdlib/core`).
impl<T> Generate<DynArray<T>, T> {
    fn generate(start, end, f) {
        let mut v: DynArray<T> = dynarray_new(end - start + 1);
        for k in start..end { push(v, f(k)); };
        v
    }
}
