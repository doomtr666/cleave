// One `print` per numeric width, dispatched the same way `Ring`/`Ord` are
// (`stdlib/num/num.cleave`) -- a caller just writes `print(x)`, and which
// concrete impl (hence which real C symbol) gets called falls out of `x`'s
// own type, same as `+`/`<` already do. `extern(...)`'s own parenthesized
// override is what makes this possible: every impl here shares the *same*
// cleave-level method name (`print`), but each needs to bind a genuinely
// different backing symbol -- `print_i32`, `print_i64`, ... -- since a bare
// `extern fn print(...)` (no override, symbol == name) could only ever mean
// one of them. Each real symbol is a `cleave-rt` function, prints its
// argument's decimal form plus a newline, and returns it unchanged (see
// `cleave-rt/src/lib.rs`).
// `use dynarray;`/`use display;` -- needed by the new `Display<T>`-backed
// `Print<T>` impls further down (arrays/tensors of a `Display`-able
// element type), not by the scalar/string/tuple impls above them, which
// predate `Display<T>` entirely and stay untouched.
use dynarray;
use display;

// Flushes a `DynArray<i8>`'s own already-built buffer straight to stdout --
// `stdlib/display/display.cleave`'s own doc comment (`Display<T>`) explains
// why this is a separate primitive from `print_bytes` (an ordinary `[i8;N]`
// array's own ABI) rather than reusing it: `out.buf` is already a bare
// opaque pointer (`RawBuf`, `stdlib/dynarray/dynarray.cleave`), not an
// array value needing `mlir_lower.rs`'s own array-aware extraction.
extern fn print_dynarray_bytes(buf: RawBuf, len: i32) -> i32;

algebra Print<T> {
    fn print(x: T) -> T;
}

impl Print<i8> { extern(print_i8) fn print(x: i8) -> i8; }
impl Print<i16> { extern(print_i16) fn print(x: i16) -> i16; }
impl Print<i32> { extern(print_i32) fn print(x: i32) -> i32; }
impl Print<i64> { extern(print_i64) fn print(x: i64) -> i64; }
impl Print<f32> { extern(print_f32) fn print(x: f32) -> f32; }
impl Print<f64> { extern(print_f64) fn print(x: f64) -> f64; }

// A string is a plain `[i8; N]` array (see `doc/backlog.md`'s own "No
// string support at all" item) — no new representation, just an ordinary
// generic impl over an array-shaped target, one specialization per
// distinct literal length actually reached (the same "monomorphize once
// per concrete instantiation" discipline every other generic construct in
// this codebase already gets). `print_bytes` (`cleave-rt`) writes the raw
// bytes to stdout and returns their count as a plain `i64` — a real ABI
// mismatch against this impl's own declared `[i8; N]` return, resolved by
// `mlir_lower.rs`'s own array-return reconciliation (discards the extern
// call's own scalar result, threads the original array through instead,
// matching every other `Print<T>` impl's "prints and returns unchanged"
// contract).
impl<const N: i32> Print<[i8; N]> { extern(print_bytes) fn print(x: [i8; N]) -> [i8; N]; }

// A heterogeneous, fixed-arity `print` — `print(("x=", x, "y=", y))`,
// `println` too (a plain `T: Print`-bound wrapper, below — a tuple
// satisfies that bound exactly like any scalar does) — needs its own impl
// per arity actually used. Unlike `stdlib/linalg/tensor.cleave`'s own
// `Tensor<T, const Dims...: i32>`, real variadic generics (`doc/
// backlog.md`'s own "Variadic generics" item) don't help *this* problem: a
// pack there is homogeneous (every dim is the same kind of thing, an `i32`)
// and never itself iterated per-element at the *type* level, but `("x=", x,
// "y=", y)`'s own elements are genuinely different types needing genuinely
// different `print` dispatches — a still-separate, deferred problem (`doc/
// backlog.md`'s own note on why a heterogeneous compile-time unroll is a
// different mechanism, not the same one). A
// tuple's own type/literal/field-access syntax (`(A,B)`/`(a,b)`/`x.0`) is
// ordinary generic-struct sugar (`ast::tuple_struct_name`, `driver.rs::
// synthesize_tuple_structs`) — these impls are otherwise completely
// unremarkable generic algebra impls, needing no tuple-specific machinery of
// their own at all. `A: Print`/`B: Print`/... bounds each element's own
// recursive `print(x.N)` call to a real, concrete dispatch once monomorphized
// (a bare, unbounded `A` would leave `print(x.0)` unresolvable).
//
// One impl per arity 2..=16 — matching `driver.rs::MAX_TUPLE_ARITY`, the
// same ceiling every other tuple-consuming mechanism in this codebase
// already shares (`derive()`'s own synthesized Jacobian, in particular) —
// not just the original 2..=4: this is genuinely this project's own most
// practical structured-logging idiom today (`doc/backlog.md`'s own "no
// `format!`-style interpolated string" item stays deliberately unattempted;
// this is what fills that gap in the meantime), so capping it well below
// what a real, multi-value log line might need would have undercut the
// whole point.
impl<A: Print, B: Print> Print<(A, B)> {
    fn print(x: (A, B)) -> (A, B) {
        print(x.0);
        print(x.1);
        x
    }
}
impl<A: Print, B: Print, C: Print> Print<(A, B, C)> {
    fn print(x: (A, B, C)) -> (A, B, C) {
        print(x.0);
        print(x.1);
        print(x.2);
        x
    }
}
impl<A: Print, B: Print, C: Print, D: Print> Print<(A, B, C, D)> {
    fn print(x: (A, B, C, D)) -> (A, B, C, D) {
        print(x.0);
        print(x.1);
        print(x.2);
        print(x.3);
        x
    }
}
impl<A: Print, B: Print, C: Print, D: Print, E: Print> Print<(A, B, C, D, E)> {
    fn print(x: (A, B, C, D, E)) -> (A, B, C, D, E) {
        print(x.0);
        print(x.1);
        print(x.2);
        print(x.3);
        print(x.4);
        x
    }
}
impl<A: Print, B: Print, C: Print, D: Print, E: Print, F: Print> Print<(A, B, C, D, E, F)> {
    fn print(x: (A, B, C, D, E, F)) -> (A, B, C, D, E, F) {
        print(x.0);
        print(x.1);
        print(x.2);
        print(x.3);
        print(x.4);
        print(x.5);
        x
    }
}
impl<A: Print, B: Print, C: Print, D: Print, E: Print, F: Print, G: Print> Print<(A, B, C, D, E, F, G)> {
    fn print(x: (A, B, C, D, E, F, G)) -> (A, B, C, D, E, F, G) {
        print(x.0);
        print(x.1);
        print(x.2);
        print(x.3);
        print(x.4);
        print(x.5);
        print(x.6);
        x
    }
}
impl<A: Print, B: Print, C: Print, D: Print, E: Print, F: Print, G: Print, H: Print> Print<(A, B, C, D, E, F, G, H)> {
    fn print(x: (A, B, C, D, E, F, G, H)) -> (A, B, C, D, E, F, G, H) {
        print(x.0);
        print(x.1);
        print(x.2);
        print(x.3);
        print(x.4);
        print(x.5);
        print(x.6);
        print(x.7);
        x
    }
}
