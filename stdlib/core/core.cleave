// The prelude's collection algebras (`doc/plan-compile-time-sequences.md`).
//
// `Len` gives every collection its number of elements: an array's is its
// size, a `DynArray`'s its current length, and every struct or tuple gets one
// synthesized by the compiler (its number of fields, `driver.rs::
// synthesize_len_impls`) unless the program writes its own.
algebra Len<C> {
    fn len(c: C) -> i32;
}

impl<T, const N: i32> Len<[T; N]> {
    fn len(c) { N }
}

// What a comprehension (`[for i in a..b: e]`) builds: its copies of `e` form
// a tuple, then `collect` turns that tuple into the type the context asks
// for, like a number literal's type comes from its context. `let net:
// Network = [for ...]` rebuilds a struct; `let v: [f32; 3] = [for ...]` an
// array. When nothing decides, the default (`infer.rs`, `CollectDefault`):
// an array when every element has the same scalar (or array) type, the
// tuple itself otherwise. The struct and array impls are synthesized by the compiler
// (`driver.rs::synthesize_collect_impls`); a program can write its own for a
// struct (or for any type: a tensor initialized by formula).
algebra Collect<Target, Source> {
    fn collect(x: Source) -> Target;
}

impl<T> Collect<T, T> {
    fn collect(x) { x }
}

// What a comprehension whose elements all have one type becomes: its
// collection filled at run time, one call of `f` per index from `start` to
// `end`, without materializing anything first (a comprehension over a
// struct or tuple is unrolled into `Collect` instead). Any collection can be
// seeded this way by implementing it: `[T; N]` here, `Tensor` in `linalg`,
// `DynArray` (whose length is only known at run time) in `dynarray`. With no
// context, the target is an array when the bounds are known at compile
// time, a `DynArray` otherwise (`infer.rs`, `CollectDefault`).
algebra Generate<C, T> {
    fn generate(start: i32, end: i32, f: (i32) -> T) -> C;
}

impl<T, const N: i32> Generate<[T; N], T> {
    fn generate(start, end, f) {
        let mut a: [T; N] = mlir::memref::alloc();
        for k in 0..N { a[k] = f(start + k); };
        a
    }
}

// Indexing a homogeneous collection with run-time indices (`m[i, j]`): one
// call per bracket group, every index gathered into one `[i32; K]` array
// (`cps.rs`'s `ExprKind::Index`). Implemented by `Tensor` (`stdlib/linalg`),
// `DynArray` (`stdlib/dynarray`) and any user collection; a struct or tuple
// with no `Index` impl is indexed by position instead (`x[0]` is its first
// field, `infer.rs::is_positional_struct`).
algebra Index<Container, Elem, const K: i32> {
    fn index(c: Container, idx: [i32; K]) -> Elem;

    // `d/dx[c[idx]] = (dc/dx)[idx]` — reading one element out of a
    // container and differentiating commute: the derivative of "the value
    // at position `idx`" is "the derivative, read at that same position."
    // `idx` itself is never wrapped in `d(...)` — an array of integer
    // indices isn't a differentiable quantity, it's reused as-is, exactly
    // the same shape `Ring<T>`'s own product rule already uses for an
    // operand that stays undifferentiated on one side (`mul(a, d(b))`).
    // Found missing directly: indexing into a `Tensor` had no path to a
    // derivative at all before this — `doc/backlog.md`'s own "toward
    // tensorial ML" item.
    derivative index(c, idx): index(d(c), idx);
}

// Writing one element of a collection that is a value rather than storage (a
// `Tensor`): `c[i, j] = v` on a variable `c` of such a type is `c = set(c, [i,
// j], v)` (`cps.rs`), the collection with that element replaced, rebound to
// the variable. An array is written in place instead (`PrimOp::Store`).
algebra IndexSet<Container, Elem, const K: i32> {
    fn set(c: Container, idx: [i32; K], v: Elem) -> Container;
}
