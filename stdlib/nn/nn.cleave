// The activation/reduction half of `doc/backlog.md`'s own "toward simple
// ML" roadmap item — ordinary stdlib algebras and `mlir::...` bodies, no
// new compiler mechanism: `relu`/`sigmoid`/`tanh` are each a one-or-two-line
// `mlir::...` call, exactly the same shape every `Ring`/`Ord` impl already
// uses; `sum`/`mean`/`max_of` are plain cleave source (a `for` loop plus
// `Tensor`'s own real multi-index `Index` read), needing no MLIR-level
// reduction op at all.
//
// This is the first stdlib crate to reference *another* stdlib crate's own
// types (`Tensor`) — `use linalg;` right below is followed transitively by
// `driver.rs`'s own `compile` (real DFS-based crate resolution, with cycle
// detection, not the former "one level deep only" limitation that used to
// make this line functionally inert: a program writing only `use nn;`,
// with no `use linalg;` of its own, sees `Tensor`/`Ring<Tensor<T,N>>`/etc.
// anyway — `cleave/tests/mlir_lower.rs`'s own `nn` tests are the real proof,
// none of them write `use linalg;` themselves). `mean`'s own `.to()` call
// needs `convert` too, transitively resolved the identical way. `dense_
// xavier`/`dense_he`'s own `uniform`/`normal` calls need `rand` the same
// way; `Trainable<Dense<T,In,Out>>` below needs `optim` (`Trainable`, and
// the `Optimizer` impls a `Dense` is trained by) for the identical reason.
use linalg;
use blas;
use convert;
use rand;
use optim;

algebra Activation<T> {
    fn relu(x: T) -> T;
    fn sigmoid(x: T) -> T;
    fn tanh(x: T) -> T;

    // No `derivative` rule of its own for `tanh` (or anything else) --
    // `tanh`'s own derivative belongs to `Transcendental<T>` (`stdlib/num/
    // num.cleave`), the math function itself, not this ML-specific
    // wrapper algebra that merely exposes it under a uniform activation
    // interface -- see that algebra's own doc comment for why. `Activation
    // <T>::tanh`'s own impls below delegate to it via a qualified call
    // (`Transcendental::tanh(x)`), so its derivative composes for free
    // through the delegation, no rule needed here at all.

    // `relu`'s own real `adjoint` rule -- correctly missing until now
    // (this algebra's own original doc comment used to say so directly:
    // "a known, narrower, separate gap... differentiating through either
    // one isn't exercised anywhere reached by `derive()` yet") -- needed
    // the moment `grad()` differentiates through a real `ReLU`-activated
    // network deep enough that `sigmoid`'s own vanishing-gradient problem
    // matters (`examples/mnist-interop`). `relu'(x) = 1` where `x > 0`,
    // `0` otherwise (the subgradient convention at exactly `x = 0` doesn't
    // matter in practice) -- `Step<T>::step` below, a small, dedicated
    // algebra existing only to carry this one value as an adjoint rule's
    // own payload, never itself a `derive()`/`grad()` target.
    adjoint relu(x), u: mul(u, step(x));

    // GELU in its `tanh` form, `0.5 x (1 + tanh(sqrt(2/pi) (x + 0.044715
    // x^3)))` (PyTorch's `gelu(x, approximate='tanh')`, GPT-2's): a smooth
    // ReLU, the usual activation inside a transformer's MLP. Its derivative
    // is declared (`gelu_grad`), in closed form, rather than derived through
    // the cube and the `tanh`.
    fn gelu(x: T) -> T;
    fn gelu_grad(x: T) -> T;
    adjoint gelu(x), u: mul(u, gelu_grad(x));

    // SiLU (or swish), `x * sigmoid(x)`: the activation inside SwiGLU
    // (`swiglu_forward`), Llama's MLP. Its derivative is declared in closed
    // form, `s (1 + x (1 - s))` with `s = sigmoid(x)`.
    fn silu(x: T) -> T;
    fn silu_grad(x: T) -> T;
    adjoint silu(x), u: mul(u, silu_grad(x));
}

// `relu`'s own adjoint (just above) needs this, and only this -- not a
// general-purpose "sign" or "Heaviside" primitive for the rest of the
// stdlib to reach for, kept exactly as narrow as the one real need.
algebra Step<T> {
    fn step(x: T) -> T;
}

// `arith.uitofp` (unsigned-int-to-float, `i1`'s own `0`/`1` reads correctly
// as an unsigned bit pattern either way), not `arith.select` -- found
// directly, by testing: building a real `arith.select` through this
// project's own fully-generic `mlir::...` mechanism (`lower_raw_mlir_op`)
// crashes MLIR's own internal type/attribute uniquing (`StorageUniquer
// Support.h`, an assertion failure, not a clean verifier error) even with
// every operand already a properly-typed value — `Convert<i32,f32>`'s own
// `arith.sitofp` (`stdlib/convert/convert.cleave`) already proves the
// *general* "operand type differs from result type" shape works fine
// through this same generic mechanism, so the problem is specific to
// `select`'s own 3-operand shape somehow, not heterogeneous types in
// general — not investigated further (a real, separate compiler gap,
// `select` specifically unusable via `mlir::...` today), just routed
// around with a single-operand conversion instead, which needs no `zero`/
// `one` operand pair, no `select` at all, one op fewer besides.
impl Step<f32> {
    fn step(x) {
        let cond: bool = Ord::gt(x, 0.0);
        mlir::arith::uitofp(cond)
    }
}

impl Step<f64> {
    fn step(x) {
        let cond: bool = Ord::gt(x, 0.0);
        mlir::arith::uitofp(cond)
    }
}

// The `Tensor<T,Dims...>` counterpart, elementwise -- `arith.cmpf`/`arith.
// uitofp` apply structurally over a shaped operand exactly the way `arith.
// maximumf` already does for `Activation<Tensor<T,Dims...>>::relu` itself,
// confirmed directly the same way. `cond`'s own real MLIR type is a same-
// shaped tensor of `i1` (`Tensor<bool, Dims...>`'s own native form, `ty_to_
// mlir`'s `bool -> i1` mapping composing with `Tensor`'s own pack-generic
// shape the same way it already does for `T = f32`/`i32`/etc.) -- checked
// directly, not assumed.
//
// `zero`'s own construction is `mlir::tensor::splat`, not `[0.0; Dims...]`
// -- the exact same array-repeat cost `Ring<Tensor<T,Dims...>>::zero()`
// (`stdlib/linalg/tensor.cleave`) was already found and fixed for, just
// never carried over here when `Step<T>` was added: `[0.0; Dims...]`
// evaluates its own value expression *independently* at every leaf
// position, right for `Init::xavier`'s own genuinely-independent random
// draws but wasted on the *identical* value at every position. Found
// directly, not assumed, at real MNIST scale (`examples/mnist-interop`):
// `Step::step<Tensor<f32,1,512>>` alone reached over 13,000 lines of MLIR
// for what should be a same-sized elementwise compare — `net_grad`'s own
// backward pass calls this once per hidden layer, so this alone dominated
// its total size. `z`'s own explicit `T` annotation is load-bearing, not
// stylistic — see `Ring::zero()`'s own identical fix for why (`mlir::...`
// calls never type-check their own arguments against the op's real
// signature).
impl<T: Float, const Dims...: i32> Step<Tensor<T, Dims...>> {
    fn step(x) {
        let z: T = zero();
        let zero: Tensor<T, Dims...> = mlir::tensor::splat(z);
        let cond: Tensor<bool, Dims...> = mlir::arith::cmpf(x, zero, predicate: "2 : i64");
        mlir::arith::uitofp(cond)
    }
}

// `arith.maximumf(x, 0.0)`/`1.0 + ...` — a bare literal operand here is
// fine (unlike the `arith.index_cast`-on-a-bare-literal rough edge `doc/
// backlog.md` tracks): that gap is specifically about an op whose operand
// type genuinely differs from its result type (`index_cast`'s own `i32 ->
// index`); every op here has identical operand/result types, so `lower_
// raw_mlir_op`'s own "infer operand type from a `CVal::Var` sibling, else
// fall back to the result type" heuristic is correct either way.
//
// `sigmoid`/`tanh` are now built entirely from named, individually-
// differentiable primitives (`Ring`'s `div`/`neg`, `Transcendental`'s
// `exp`/`tanh` — `stdlib/num/num.cleave`) rather than raw `mlir::...`
// calls — no derivative rule of their own needed on `Activation` at all,
// see that algebra's own doc comment. `Transcendental::tanh(x)` is a
// *qualified* call, not a bare `tanh(x)` — `Activation<T>` and
// `Transcendental<T>` both declare a 1-arg `tanh`, so an unqualified call
// here would be genuinely ambiguous (`TypeErrorKind::AmbiguousOperator`),
// not just resolve to "the obviously intended one". `exp` has no such
// collision (only `Transcendental` declares it), so it's called bare.
impl Activation<f32> {
    fn relu(x) { mlir::arith::maximumf(x, 0.0) }
    fn sigmoid(x) { 1.0 / (1.0 + exp(-x)) }
    fn tanh(x) { Transcendental::tanh(x) }
    fn gelu(x) { 0.5 * x * (1.0 + Transcendental::tanh(0.7978845608 * (x + 0.044715 * x * x * x))) }
    fn gelu_grad(x) {
        let t = Transcendental::tanh(0.7978845608 * (x + 0.044715 * x * x * x));
        0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * 0.7978845608 * (1.0 + 0.134145 * x * x)
    }
    fn silu(x) { x / (1.0 + exp(-x)) }
    fn silu_grad(x) {
        let s = 1.0 / (1.0 + exp(-x));
        s * (1.0 + x * (1.0 - s))
    }
}

impl Activation<f64> {
    fn relu(x) { mlir::arith::maximumf(x, 0.0) }
    fn sigmoid(x) { 1.0 / (1.0 + exp(-x)) }
    fn tanh(x) { Transcendental::tanh(x) }
    fn gelu(x) { 0.5 * x * (1.0 + Transcendental::tanh(0.7978845608 * (x + 0.044715 * x * x * x))) }
    fn gelu_grad(x) {
        let t = Transcendental::tanh(0.7978845608 * (x + 0.044715 * x * x * x));
        0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * 0.7978845608 * (1.0 + 0.134145 * x * x)
    }
    fn silu(x) { x / (1.0 + exp(-x)) }
    fn silu_grad(x) {
        let s = 1.0 / (1.0 + exp(-x));
        s * (1.0 + x * (1.0 - s))
    }
}

// The `Tensor<T,Dims...>` counterpart — pack-generic over *any* rank (was
// rank-1-only, `Tensor<T,N>`, until this generalization): `relu`/`tanh` stay
// raw `mlir::...` calls applied directly over the tensor-backed operand
// (`arith.maximumf`/`math.tanh` apply structurally at any rank exactly the
// way `Ring<Tensor<T,Dims...>>::add`'s own `arith.addf` already does,
// confirmed directly — `cleave/tests/mlir_lower.rs::relu_sigmoid_tanh_
// compute_correctly_on_vectors`) — `relu`/`tanh` have no `derivative` rule
// of their own either way, scalar or `Tensor`, a known, narrower, separate
// gap this impl doesn't attempt to close (differentiating *through* either
// one isn't exercised anywhere reached by `derive()` yet).
//
// `sigmoid` is different: `Dense::forward` (`examples/xor_tensor.cleave`)
// needs to differentiate all the way *through* it, so it composes from real,
// named, individually-differentiable calls -- `Ring::neg`/`add`/`div` (this
// same file's own `Ring<Tensor<T,Dims...>>` above) and `Transcendental::exp`
// (`stdlib/linalg/tensor.cleave`'s new `impl<T,Dims...> Transcendental<
// Tensor<T,Dims...>>`) -- the *exact* same shape its own scalar sibling just
// above already uses (`1.0 / (1.0 + exp(-x))`), not the raw `mlir::arith::
// negf`/`addf`/`divf` calls an earlier version of this impl used. Found
// directly, by testing `Dense`/`Network`: a raw-op body, even though
// numerically identical, is *purely* a chain of pure primops with no real
// call in it at all -- `egraph.rs::is_straight_line` -- so `Forward::walk`
// treated it as one opaque, unnamed node (the same treatment a genuinely
// atomic op like `matmul` gets, correctly, because *it* has a declared
// `derivative` rule to match against). `sigmoid` has no such rule (by
// design -- see `Activation<T>`'s own doc comment: its derivative is meant
// to compose automatically from its own primitives), so an opaque `sigmoid`
// node could never differentiate at all -- silently stuck as a raw,
// unresolved `derivative(...)` marker for *any* leaf reachable only through
// it, rather than a clean error. `stdlib/num/num.cleave`'s own `Transcendental
// <T>` doc comment already tells this identical story for the scalar case
// ("sigmoid... had no path to a derivative at all short of its own hand-
// written closed form... moving `exp` here... means sigmoid's derivative now
// composes automatically via ordinary chain-rule saturation") -- this is
// that same fix, just not yet carried over to the pack-generic case until
// now. `one`/`zero`, a same-shape broadcast tensor, still can't be avoided
// (`Ring::add`/`div`/`maximumf` require *matching* operand types, and a
// bare `0.0`/`1.0` literal is `T`, not `Tensor<T,Dims...>`) -- built via
// `mlir::tensor::splat`, not `[value; Dims...]` -- `Step<Tensor<T,Dims
// ...>>::step`'s own identical fix, just above, has the full story (the
// same array-repeat cost, found at real MNIST scale: `Activation::relu<
// Tensor<f32,1,512>>` alone reached nearly 13,000 lines of MLIR).
impl<T: Float, const Dims...: i32> Activation<Tensor<T, Dims...>> {
    // `mlir::linalg::relu`, not a `tensor.splat` zero plus a plain
    // `arith.maximumf` applied directly to the whole tensor operand (this
    // impl's own previous shape) -- `mlir_lower.rs::build_relu_elemwise`'s
    // own doc comment has the full story: a plain `arith.*` op on a
    // `tensor<...>` never implements `TilingInterface` in this LLVM build,
    // so it can never be pulled into a shared parallel region the way a
    // real `linalg.generic` can. No separate zero tensor needed any more
    // either -- the zero is a real `arith.constant` built directly inside
    // the new op's own payload region.
    fn relu(x) {
        mlir::linalg::relu(x)
    }
    fn sigmoid(x) {
        let o: T = one();
        let one: Tensor<T, Dims...> = mlir::tensor::splat(o);
        one / (one + exp(-x))
    }
    fn tanh(x) { mlir::math::tanh(x) }
    fn gelu(x) {
        let half_s: T = 0.5;
        let half: Tensor<T, Dims...> = mlir::tensor::splat(half_s);
        let one_s: T = 1.0;
        let one: Tensor<T, Dims...> = mlir::tensor::splat(one_s);
        half * x * (one + mlir::math::tanh(gelu_inner(x)))
    }
    // `d/dx = 0.5 (1 + t) + 0.5 x (1 - t^2) sqrt(2/pi) (1 + 3 * 0.044715 x^2)`,
    // `t` the `tanh` above.
    fn gelu_grad(x) {
        let half_s: T = 0.5;
        let half: Tensor<T, Dims...> = mlir::tensor::splat(half_s);
        let one_s: T = 1.0;
        let one: Tensor<T, Dims...> = mlir::tensor::splat(one_s);
        let c_s: T = 0.7978845608;
        let c: Tensor<T, Dims...> = mlir::tensor::splat(c_s);
        let k3_s: T = 0.134145;
        let k3: Tensor<T, Dims...> = mlir::tensor::splat(k3_s);
        let t = mlir::math::tanh(gelu_inner(x));
        half * (one + t) + half * x * (one - t * t) * c * (one + k3 * x * x)
    }
    fn silu(x) {
        let one_s: T = 1.0;
        let one: Tensor<T, Dims...> = mlir::tensor::splat(one_s);
        x / (one + exp(-x))
    }
    fn silu_grad(x) {
        let one_s: T = 1.0;
        let one: Tensor<T, Dims...> = mlir::tensor::splat(one_s);
        let s = one / (one + exp(-x));
        s * (one + x * (one - s))
    }
}

// `sqrt(2/pi) (x + 0.044715 x^3)`, GELU's `tanh` argument.
fn gelu_inner<T: Float, const Dims...: i32>(x: Tensor<T, Dims...>) -> Tensor<T, Dims...> {
    let c_s: T = 0.7978845608;
        let c: Tensor<T, Dims...> = mlir::tensor::splat(c_s);
    let k_s: T = 0.044715;
        let k: Tensor<T, Dims...> = mlir::tensor::splat(k_s);
    c * (x + k * x * x * x)
}

// A fully-connected layer -- ordinary stdlib struct, `dense_forward` below
// (a plain top-level generic `fn`, dot-called as `layer.dense_forward(x)`)
// is just `matmul` (`linalg::matrix.cleave`) followed by a bias add
// (`Ring<Tensor<...>>::add`, via `+`), both already proven independently.
// This is the `Dense` the session's own `Network`/`xor_tensor.cleave`
// rewrite bundles multiple of, replacing the eleven loose scalar parameters
// that example used to take.
//
// Deliberately *no* activation baked in here -- an earlier version of this
// impl called `sigmoid` directly at the end of `forward`, inherited
// unquestioned from `examples/xor_tensor.cleave`'s own pre-`Dense`
// `sigmoid2` helper (which *did* fuse linear+activation), without stepping
// back to ask whether that was the right split. It wasn't: a real, reusable
// `Dense` needs to stay just the affine transform, exactly like `nn.Linear`
// in every other framework -- the *caller* composes whichever activation it
// wants (`sigmoid`, `relu`, or none at all, for a final logit) on top,
// ordinarily, as a real separate call. Nothing about `derive()` needs the
// activation fused in either way -- confirmed directly, not assumed: `Ring
// ::neg`/`add`/`div`/`Transcendental::exp` (`sigmoid`'s own composition,
// above) differentiate correctly through an ordinary call site exactly like
// `Dense::forward`'s own call site does.
struct Dense<T: Float, const In: i32, const Out: i32> { w: Tensor<T, In, Out>, b: Tensor<T, 1, Out> }

// `Dense::forward` (single-row, `Tensor<T,1,In> -> Tensor<T,1,Out>`, an
// inherent impl) used to live here, alongside `dense_forward` below (the
// batched generalization) -- removed, not migrated, once impls inherents
// stopped existing as a language concept (`doc/backlog-done.md`'s own entry
// has the full story): `dense_forward` already handles `B=1` correctly
// (`broadcast0`'s own `Tensor<T,1,M> -> Tensor<T,B,M>` is defined for *any*
// `B`, `1` included -- a real, if trivial, identity-shaped broadcast, not a
// degenerate case it special-cases away) -- the only reason both existed
// side by side was that an inherent method's own generics weren't picked up
// by inference at all (`dense_forward`'s own doc comment below), a gap that
// applied *only* to inherent impls and no longer has anything left to apply
// to. Every former `layer.forward(x)` call site keeps its dot-call syntax
// unchanged -- only the method name moved, `layer.dense_forward(x)` --
// dot-call is sugar for a bare call, not a reason to write one out by hand
// (`examples/mnist-interop/src/kernel.cleave`'s own bare `dense_forward
// (net.l1, x)` predates this migration entirely and is unrelated: `Dense::
// forward` never existed there in the first place, only `dense_forward`
// always did, called bare by original choice).


// `Init<T>::xavier`/`he` -- real weight initialization, `doc/backlog.md`'s
// own "No weight-initialization helpers" item finally closed now that `rand`
// (`stdlib/rand/rand.cleave`) exists to build it on.
//
// An algebra, not a generic `fn`, because it has several implementations
// chosen by the result type (`Tensor` and `Dense` below), exactly like
// `Ring::zero()`: `let d: Dense<f32, 2, 2> = he();` and a `Tensor`-typed
// field both pick theirs from the expected type. (A nullary generic `fn`
// returning a `Dense` works too — `cleave/tests/mlir_lower.rs`, `a_nullary_
// generic_fn_is_instantiated_per_call_site` — but it is one implementation
// per name.)
algebra Init<T> {
    fn xavier() -> T;
    fn he() -> T;
}

// A genuine nested loop, not `[[uniform(lo, hi); Out]; In]`'s own array-
// repeat -- `array-repeat` evaluates its own value expression independently
// at every leaf position (correct: real per-element-independent draws), but
// unrolled into one fully-inlined copy of the *entire* draw expression per
// element at MLIR-generation time -- `doc/backlog.md`'s own "digits-interop"
// perf item found this costing 27,033 lines of MLIR for one real 64x32
// layer. `cleave`'s own `for`/`while` loops already lower to a genuine `scf.
// while` (confirmed directly, `mlir_lower.rs::lower_loop`) -- independent of
// `In`*`Out`, this pays for exactly *one* `Rand::uniform`/`Rand::normal` call
// site in the generated MLIR, the loop itself never unrolled.
// `rand.cleave`'s own module doc comment anticipated exactly this shape
// ("needs a genuine loop with indexed writes... left to `Dense`'s own future
// init helpers to use, not built here") -- built here now.
//
// `buf`'s own initial value is `mlir::memref::alloc()` (a raw, zero-operand
// `memref.alloc` -- the whole shape is compile-time-static, no dynamic-size
// operands needed), not an ordinary `[[0.0; Out]; In]` array-repeat literal
// -- found directly, by re-measuring: every position gets overwritten by the
// loop immediately below regardless, so a zero-fill initializer is *dead*,
// but `array-repeat` on a bare (non-`Tensor`) array type still unrolls into
// one `memref.store` per element (unlike `Ring<Tensor<T,Dims...>>::zero()`'s
// own `tensor.splat`-based fix above -- this is a *plain* `[T;In,Out]` local,
// not a tagged `Tensor`) -- paying the exact same per-element cost this
// whole rewrite exists to avoid, just for a value nothing ever reads.
//
// `w`'s own construction is `mlir::bufferization::to_tensor(buf, restrict:
// "unit")`, not `Tensor::<T,In,Out>(data: buf)` -- found necessary chasing a
// real user report that the loop above was *still* effectively fully
// unrolled end to end, despite lowering to a genuine `scf.while` on its own:
// ordinary `Tensor`-construction (`lower_tagged_struct_construct`, `mlir_
// lower.rs`) always flattens its own source array element-by-element
// (`flatten_memref_elements` -- one `memref.load` per position -- into
// `tensor.from_elements`, an operand list literally as long as the tensor
// has elements) regardless of *how* that source array was populated, undoing
// the loop's own O(1) win the moment its result gets handed to `Tensor(...)`
// -- confirmed directly, and by design: `tensor.from_elements`'s own real
// MLIR arity *requires* one SSA operand per element, there's no bulk form.
// `bufferization.to_tensor` is that bulk form instead -- a single op
// converting an entire memref's own contents to a tensor value in one step,
// real MLIR, no new Rust code (`mlir::...` calls already handle a plain,
// non-`linalg.`-prefixed, non-region op like this one generically). Its own
// `restrict` attribute (a bare MLIR unit attribute, `"unit"`) is required by
// one-shot-bufferize's own analysis -- asserts this memref is never aliased/
// written through again after this point, true here (`buf` is a `let mut`
// local, never referenced again past this line) -- omitting it is a real,
// distinct MLIR verifier error (`to_tensor ops without 'restrict' are not
// supported by One-Shot Analysis`), found directly, not guessed. Verified:
// the dumped MLIR now has exactly one `bufferization.to_tensor ... restrict`
// op regardless of `In`/`Out`, confirmed numerically correct (`--run` on a
// small loop-populated `Tensor` prints the expected, genuinely independent
// per-position draws), and the real training-loop tests below stay green.
//
// **On `Tensor<T,In,Out>` itself, not `Dense`** -- raised directly: the
// actual random-fill logic below has nothing `Dense`-specific about it at
// all (it never reads `layer.w`/`layer.b`, just produces a raw `Tensor`),
// so tying it to `Dense` meant there was no way to Xavier/He-initialize a
// bare weight tensor without wrapping it in a `Dense` first. `Init<T>`
// being an *algebra* (not a `Dense`-inherent method or a plain top-level
// function -- see this file's own history above for exactly why) already
// dispatches on its own *target* type, so nothing here actually needed
// `Dense` in the picture; `Init<Dense<T,In,Out>>` right below is now a
// thin composition on top instead of owning the loop itself.
impl<T: Float + Rand + Ring, const In: i32, const Out: i32> Init<Tensor<T, In, Out>> {
    // Xavier/Glorot uniform (Glorot & Bengio, 2010) -- `limit = sqrt(6 /
    // (fan_in + fan_out))`, weight ~ `Uniform(-limit, limit)` -- the standard
    // choice for a `sigmoid`/`tanh`-activated layer (`examples/xor_tensor.
    // cleave`'s own).
    fn xavier() {
        let fan_in: T = In.to();
        let fan_out: T = Out.to();
        let limit: T = mlir::math::sqrt(6.0 / (fan_in + fan_out));
        let mut buf: [T; In, Out] = mlir::memref::alloc();
        for i in 0..In {
            for j in 0..Out { buf[i, j] = uniform(-limit, limit); };
        };
        mlir::bufferization::to_tensor(buf, restrict: "unit")
    }

    // He normal (He et al., 2015) -- `std = sqrt(2 / fan_in)`, weight ~
    // `Normal(0, std)` -- the standard choice for a `relu`-activated layer.
    // Not used by `examples/xor_tensor.cleave` (its own network is `sigmoid`
    // throughout, so `xavier` above is the one it actually needs), but real
    // and tested independently -- a network with a `relu` hidden layer needs
    // exactly this.
    fn he() {
        let fan_in: T = In.to();
        let std: T = mlir::math::sqrt(2.0 / fan_in);
        let mut buf: [T; In, Out] = mlir::memref::alloc();
        for i in 0..In {
            for j in 0..Out { buf[i, j] = normal(0.0, std); };
        };
        mlir::bufferization::to_tensor(buf, restrict: "unit")
    }
}

// Bias is zero-initialized in both -- the standard convention, and `Ring::
// zero()` already does exactly this for a `Tensor`-typed field. `Init::
// xavier()`/`he()` here (no explicit target) resolve to the `Tensor<T,In,
// Out>` impl just above through the identical output-type-driven algebra
// dispatch `Ring::zero()` itself already relies on for `b` -- `Dense.w`'s
// own declared field type is what pins it, the same way `Ring::zero()`'s
// own call is pinned by `Dense.b`'s.
impl<T: Float + Rand + Ring, const In: i32, const Out: i32> Init<Dense<T, In, Out>> {
    fn xavier() { Dense(w: Init::xavier(), b: Ring::zero()) }
    fn he() { Dense(w: Init::he(), b: Ring::zero()) }
}

// A layer is trained field by field (`w`, `b`), by `optim`'s one impl for
// every `Trainable` model.
impl<T: Float, const In: i32, const Out: i32> Trainable<Dense<T, In, Out>> {}

// Softmax cross-entropy: a batch of logits (one row per sample) against
// target distributions of the same shape (one-hot rows for classification),
// `-sum_c y[b, c] * log(softmax(z)[b, c])` summed over the batch, as
// PyTorch's `cross_entropy(..., reduction='sum')`. Computed through a
// max-shifted log-sum-exp per row, so `exp` never overflows.
//
// Its gradient is declared rather than derived through `log`/`exp`: the
// classic `softmax(z) - y` per row (times the upstream `u`; with targets
// that don't sum to one, `softmax(z) * sum(y_row) - y`), the numerically
// sound form every framework uses. The targets' own gradient, `-log_
// softmax(z) * u`, is there because a rule gives one per parameter.
algebra CrossEntropy<Logits, T> {
    fn cross_entropy(z: Logits, y: Logits) -> T;
    fn cross_entropy_grad_logits(z: Logits, y: Logits, u: T) -> Logits;
    fn cross_entropy_grad_targets(z: Logits, y: Logits, u: T) -> Logits;

    adjoint cross_entropy(z, y), u: (cross_entropy_grad_logits(z, y, u), cross_entropy_grad_targets(z, y, u));
}

impl<T: Float, const B: i32, const C: i32> CrossEntropy<Tensor<T, B, C>, T> {
    fn cross_entropy(z, y) {
        let mut total: T = zero();
        for b in 0..B {
            let lse = log_sum_exp_row(z, b);
            for c in 0..C { total = total + y[b, c] * (lse - z[b, c]); };
        };
        total
    }
    // Filled in place rather than by nested comprehensions: those build one
    // array per row and copy it in (`doc/backlog.md`, "A nested
    // comprehension allocates and copies each row"), which on a hot path
    // (every training step) costs far more than the arithmetic.
    fn cross_entropy_grad_logits(z, y, u) {
        let mut g: [[T; C]; B] = mlir::memref::alloc();
        for b in 0..B {
            let lse = log_sum_exp_row(z, b);
            let mut mass: T = zero();
            for c in 0..C { mass = mass + y[b, c]; };
            for c in 0..C { g[b, c] = (exp(z[b, c] - lse) * mass - y[b, c]) * u; };
        };
        Tensor(data: g)
    }
    fn cross_entropy_grad_targets(z, y, u) {
        [for b in 0..B: { let lse = log_sum_exp_row(z, b); [for c in 0..C: (lse - z[b, c]) * u] }]
    }
}

// Softmax of each row: `exp(z - logsumexp(row))`, the attention weights of a
// transformer. Its gradient is declared in closed form, `y * (u -
// rowsum(u * y))` with `y = softmax(z)`, rather than derived through the
// exponentials and the division.
algebra Softmax<X> {
    fn softmax(z: X) -> X;
    fn softmax_grad(z: X, u: X) -> X;
    adjoint softmax(z), u: softmax_grad(z, u);
}

impl<T: Float, const R: i32, const C: i32> Softmax<Tensor<T, R, C>> {
    fn softmax(z) {
        let mut p: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let lse = log_sum_exp_row(z, r);
            for c in 0..C { p[r, c] = exp(z[r, c] - lse); };
        };
        Tensor(data: p)
    }
    fn softmax_grad(z, u) {
        let mut g: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let lse = log_sum_exp_row(z, r);
            let mut dot: T = zero();
            for c in 0..C { dot = dot + u[r, c] * exp(z[r, c] - lse); };
            for c in 0..C { g[r, c] = exp(z[r, c] - lse) * (u[r, c] - dot); };
        };
        Tensor(data: g)
    }
}

// Layer normalization (Ba, Kiros & Hinton, 2016), as in a transformer: each
// row (one position's vector) brought to mean 0 and variance 1, then scaled
// by a learned gain `g` and shifted by a learned bias `b`, one per column.
// `eps` is PyTorch's default, 1e-5. With `xhat` the normalized row and
// `rstd = 1 / sqrt(var + eps)`, the gradients are the standard ones:
// `dx = rstd * (u g - mean(u g) - xhat * mean(u g xhat))` per row, `dg` the
// column sums of `u * xhat`, `db` the column sums of `u`.
algebra LayerNorm<X, P> {
    fn layer_norm(x: X, g: P, b: P) -> X;
    fn layer_norm_grad_x(x: X, g: P, u: X) -> X;
    fn layer_norm_grad_g(x: X, g: P, u: X) -> P;
    fn layer_norm_grad_b(x: X, g: P, u: X) -> P;
    adjoint layer_norm(x, g, b), u: (layer_norm_grad_x(x, g, u), layer_norm_grad_g(x, g, u), layer_norm_grad_b(x, g, u));
}

// `#[no_inline]` on each method: see `CausalAttention`'s impl.
impl<T: Float, const R: i32, const C: i32> LayerNorm<Tensor<T, R, C>, Tensor<T, 1, C>> {
    #[no_inline]
    fn layer_norm(x, g, b) {
        let mut y: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let (mean, rstd) = row_moments(x, r);
            for c in 0..C { y[r, c] = (x[r, c] - mean) * rstd * g[0, c] + b[0, c]; };
        };
        Tensor(data: y)
    }
    #[no_inline]
    fn layer_norm_grad_x(x, g, u) {
        let n: T = C.to();
        let mut d: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let (mean, rstd) = row_moments(x, r);
            let mut s1: T = zero();
            let mut s2: T = zero();
            for c in 0..C {
                let ug = u[r, c] * g[0, c];
                s1 = s1 + ug;
                s2 = s2 + ug * (x[r, c] - mean) * rstd;
            };
            let m1 = s1 / n;
            let m2 = s2 / n;
            for c in 0..C { d[r, c] = rstd * (u[r, c] * g[0, c] - m1 - (x[r, c] - mean) * rstd * m2); };
        };
        Tensor(data: d)
    }
    #[no_inline]
    fn layer_norm_grad_g(x, g, u) {
        let mut d: [[T; C]; 1] = mlir::memref::alloc();
        for c in 0..C { d[0, c] = zero(); };
        for r in 0..R {
            let (mean, rstd) = row_moments(x, r);
            for c in 0..C { d[0, c] = d[0, c] + u[r, c] * (x[r, c] - mean) * rstd; };
        };
        Tensor(data: d)
    }
    #[no_inline]
    fn layer_norm_grad_b(x, g, u) {
        let mut d: [[T; C]; 1] = mlir::memref::alloc();
        for c in 0..C { d[0, c] = zero(); };
        for r in 0..R { for c in 0..C { d[0, c] = d[0, c] + u[r, c]; }; };
        Tensor(data: d)
    }
}

// RMS normalization (Zhang & Sennrich, 2019), LayerNorm's lighter variant used
// by Llama, Qwen, Gemma and most transformers since: each row divided by its
// root mean square, no centering, then scaled by a learned gain `g` (no bias).
// `eps` 1e-5, as `layer_norm`. With `rrms = 1 / sqrt(mean(x²) + eps)` and
// `xhat = x * rrms`: `dx = rrms * (u g - xhat * mean(u g xhat))` per row, `dg`
// the column sums of `u * xhat`.
algebra RmsNorm<X, P> {
    fn rms_norm(x: X, g: P) -> X;
    fn rms_norm_grad_x(x: X, g: P, u: X) -> X;
    fn rms_norm_grad_g(x: X, g: P, u: X) -> P;
    adjoint rms_norm(x, g), u: (rms_norm_grad_x(x, g, u), rms_norm_grad_g(x, g, u));
}

// `1 / sqrt(mean(x[r]²) + 1e-5)`.
fn row_rrms<T: Float, const R: i32, const C: i32>(x: Tensor<T, R, C>, r: i32) -> T {
    let n: T = C.to();
    let eps: T = 0.00001;
    let mut s: T = zero();
    for c in 0..C { s = s + x[r, c] * x[r, c]; };
    let one: T = one();
    one / mlir::math::sqrt(s / n + eps)
}

// `#[no_inline]` on each method: see `CausalAttention`'s impl.
impl<T: Float, const R: i32, const C: i32> RmsNorm<Tensor<T, R, C>, Tensor<T, 1, C>> {
    #[no_inline]
    fn rms_norm(x, g) {
        let mut y: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let rrms = row_rrms(x, r);
            for c in 0..C { y[r, c] = x[r, c] * rrms * g[0, c]; };
        };
        Tensor(data: y)
    }
    #[no_inline]
    fn rms_norm_grad_x(x, g, u) {
        let n: T = C.to();
        let mut d: [[T; C]; R] = mlir::memref::alloc();
        for r in 0..R {
            let rrms = row_rrms(x, r);
            let mut s: T = zero();
            for c in 0..C { s = s + u[r, c] * g[0, c] * x[r, c] * rrms; };
            let m = s / n;
            for c in 0..C { d[r, c] = rrms * (u[r, c] * g[0, c] - x[r, c] * rrms * m); };
        };
        Tensor(data: d)
    }
    #[no_inline]
    fn rms_norm_grad_g(x, g, u) {
        let mut d: [[T; C]; 1] = mlir::memref::alloc();
        for c in 0..C { d[0, c] = zero(); };
        for r in 0..R {
            let rrms = row_rrms(x, r);
            for c in 0..C { d[0, c] = d[0, c] + u[r, c] * x[r, c] * rrms; };
        };
        Tensor(data: d)
    }
}

// What causal attention needs to know beyond its matrices' shapes: `L`
// positions per sequence, heads `DH` wide. A marker, built with a turbofish
// (`AttentionShape::<128, 32>()`), its values read as const generics.
struct AttentionShape<const L: i32, const DH: i32> {}

// Rotary position embedding (RoPE; Su et al., 2021), applied to the queries
// and keys before attention instead of adding a learned position table to the
// input. Within each head, dimension `j < DH/2` is paired with `j + DH/2` (the
// convention of Llama and GPT-NeoX), and the pair is rotated by `pos *
// 10000^(-2j/DH)`, `pos` the row's position in its sequence (rows as in
// `causal_attention`: `N / L` sequences of `L` positions). A rotation of `q` at
// `i` and `k` at `j` leaves `q·k` depending on `i - j` only: attention sees
// relative positions, and nothing caps the context at a table's length. Linear
// and orthogonal, so its adjoint is the inverse rotation.
algebra Rope<X, S> {
    fn rope(x: X, shape: S) -> X;
    fn rope_inverse(x: X, shape: S) -> X;
    adjoint rope(x, shape), u: (rope_inverse(u, shape), _);
}

// `x` with each head's pairs rotated by `sign` times their angle, row `r` at position `first + r
// mod L`.
fn rope_rotate<T: Float, const N: i32, const D: i32, const L: i32, const DH: i32>(x: Tensor<T, N, D>, shape: AttentionShape<L, DH>, sign: T, first: i32) -> Tensor<T, N, D> {
    let half = DH / 2;
    let ln_base: T = 9.210340372;
    let two: T = 2.0;
    let dh: T = DH.to();
    let mut y: [[T; D]; N] = mlir::memref::alloc();
    for r in 0..N {
        let pos: T = (first + r - (r / L) * L).to();
        for h in 0..D / DH {
            for j in 0..half {
                let jt: T = j.to();
                let theta = pos * exp(zero() - two * jt / dh * ln_base);
                let c = cos(theta);
                let s = sign * sin(theta);
                let a = x[r, h * DH + j];
                let b = x[r, h * DH + j + half];
                y[r, h * DH + j] = a * c - b * s;
                y[r, h * DH + j + half] = b * c + a * s;
            };
        };
    };
    Tensor(data: y)
}

impl<T: Float, const N: i32, const D: i32, const L: i32, const DH: i32> Rope<Tensor<T, N, D>, AttentionShape<L, DH>> {
    #[no_inline]
    fn rope(x, shape) { rope_rotate(x, shape, one(), 0) }
    #[no_inline]
    fn rope_inverse(x, shape) { rope_rotate(x, shape, zero() - one(), 0) }
}

// `rope` for rows of one sequence starting at position `first` rather than 0: the queries and keys
// of the tokens a decoder adds one at a time (`cached_attention`). The position isn't wrapped at
// `L`: a key cache that slides keeps its keys rotated by their absolute positions, and the scores
// depend on differences only.
fn rope_at<T: Float, const N: i32, const D: i32, const L: i32, const DH: i32>(x: Tensor<T, N, D>, first: i32, shape: AttentionShape<L, DH>) -> Tensor<T, N, D> {
    rope_rotate(x, shape, one(), first)
}

// Causal multi-head self-attention (Vaswani et al., 2017), the heart of a
// transformer block. `q`, `k`, `v` are `[N, D]`: `N / L` sequences of `L`
// positions stacked as rows, `D / DH` heads side by side as columns. For each
// sequence and head, with `Q`, `K`, `V` its `[L, DH]` blocks:
// `softmax(mask(Q Kᵀ / sqrt(DH))) V`, where the mask keeps position `i` from
// seeing any position after it (`-inf` scores, zero weights). The result has
// the layout of `q`.
//
// Its gradient is declared as a whole, in one pass per block that recomputes
// the attention weights `P` once (rather than storing them from the forward
// pass): `dV = Pᵀ dO`, `dP = dO Vᵀ`, `dS = P * (dP - rowsum(dP * P)) /
// sqrt(DH)`, `dQ = dS K`, `dK = dSᵀ Q`. The three gradients come back as one
// tuple, read three times by the rule: one call (one e-class), computed once.
// The shape isn't differentiable (`_`).
algebra CausalAttention<X, S> {
    fn causal_attention(q: X, k: X, v: X, shape: S) -> X;
    fn causal_attention_backward(q: X, k: X, v: X, shape: S, u: X) -> (X, X, X);
    adjoint causal_attention(q, k, v, shape), u: (
        causal_attention_backward(q, k, v, shape, u)[0],
        causal_attention_backward(q, k, v, shape, u)[1],
        causal_attention_backward(q, k, v, shape, u)[2],
        _
    );
}

// The per-head products are `sgemm`s (`stdlib/blas`): at 128 x 128 x 64 the `linalg` matmul
// schedule ran at about a quarter of peak, `sgemm` twice as fast, and inside these out-of-line
// methods there is nothing around a product to fuse it with. Each head's blocks of `q`, `k`, `v`
// (and `u`) are slices, read by `sgemm` where they are, with their real row stride; each product
// that is a block of a result is computed into that block's slice and put back by `update`, so
// written in place (`cleave_mlir::elide_block_copies`). `sgemm` is called here rather than
// the `blas_*` helpers: a slice passed to a function is copied at its boundary (`doc/backlog.md`,
// "Views as first-class descriptors").
//
// `#[no_inline]` on each method here and on `LayerNorm`'s: each lowers to thousands of lines of
// vectorized loops, and a transformer calls them once per block forward and again per gradient.
// Inlined, every call site got its own copy: nanoLM's training step became one function of 700k
// lines, which LLVM's loop passes (`IndVarSimplify` above all) handle superlinearly, most of a
// 3-minute compile. Called instead, each instance is compiled once; the matmuls and elementwise
// operations inside still inline into it, so a step runs at the same speed (measured).
impl<const N: i32, const D: i32, const L: i32, const DH: i32> CausalAttention<Tensor<f32, N, D>, AttentionShape<L, DH>> {
    #[no_inline]
    fn causal_attention(q, k, v, shape) {
        let mut out: Tensor<f32, N, D> = uninitialized();
        for s in 0..N / L {
            for h in 0..D / DH {
                let r0 = s * L;
                let c0 = h * DH;
                let qh: Tensor<f32, L, DH> = slice(q, r0, c0);
                let kh: Tensor<f32, L, DH> = slice(k, r0, c0);
                let vh: Tensor<f32, L, DH> = slice(v, r0, c0);
                let scores: Tensor<f32, L, L> = sgemm(false, true, 1.0, qh, kh, 0.0, uninitialized());
                let p = causal_softmax(scores, DH);
                let oh: Tensor<f32, L, DH> = slice(out, r0, c0);
                out = update(out, sgemm(false, false, 1.0, p, vh, 0.0, oh), r0, c0);
            };
        };
        out
    }
    // `(dQ, dK, dV)`, every block's weights and score gradient computed once.
    #[no_inline]
    fn causal_attention_backward(q, k, v, shape, u) {
        let mut dq: Tensor<f32, N, D> = uninitialized();
        let mut dk: Tensor<f32, N, D> = uninitialized();
        let mut dv: Tensor<f32, N, D> = uninitialized();
        for s in 0..N / L {
            for h in 0..D / DH {
                let r0 = s * L;
                let c0 = h * DH;
                let qh: Tensor<f32, L, DH> = slice(q, r0, c0);
                let kh: Tensor<f32, L, DH> = slice(k, r0, c0);
                let vh: Tensor<f32, L, DH> = slice(v, r0, c0);
                let uh: Tensor<f32, L, DH> = slice(u, r0, c0);
                let scores: Tensor<f32, L, L> = sgemm(false, true, 1.0, qh, kh, 0.0, uninitialized());
                let p = causal_softmax(scores, DH);
                let dp: Tensor<f32, L, L> = sgemm(false, true, 1.0, uh, vh, 0.0, uninitialized());
                let ds = attention_score_grad(p, dp, DH);
                let gq: Tensor<f32, L, DH> = slice(dq, r0, c0);
                let gk: Tensor<f32, L, DH> = slice(dk, r0, c0);
                let gv: Tensor<f32, L, DH> = slice(dv, r0, c0);
                dq = update(dq, sgemm(false, false, 1.0, ds, kh, 0.0, gq), r0, c0);
                dk = update(dk, sgemm(true, false, 1.0, ds, qh, 0.0, gk), r0, c0);
                dv = update(dv, sgemm(true, false, 1.0, p, uh, 0.0, gv), r0, c0);
            };
        };
        (dq, dk, dv)
    }
}

// Attention over a key/value cache, the decoding side of `causal_attention`: each of the `N`
// query rows attends to the first `count` rows of `k` and `v`, `[L, D]` with heads `DH` wide, the
// keys and values of the tokens seen so far (the newest included). Rows are slots, not positions:
// the order doesn't matter (a softmax over a set), so a cache full at `L` slides as a ring, the
// newest key overwriting the oldest's slot, its rotation (`rope_at`) carrying its position.
// Matrix-vector work, for which a loop is as good as a product.
#[no_inline]
fn cached_attention<const N: i32, const D: i32, const L: i32, const DH: i32>(q: Tensor<f32, N, D>, k: Tensor<f32, L, D>, v: Tensor<f32, L, D>, count: i32, shape: AttentionShape<L, DH>) -> Tensor<f32, N, D> {
    let width: f32 = DH.to();
    let scale = 1.0 / mlir::math::sqrt(width);
    let mut out: [[f32; D]; N] = mlir::memref::alloc();
    let mut p: [f32; L] = mlir::memref::alloc();
    for r in 0..N {
        for h in 0..D / DH {
            let c0 = h * DH;
            for j in 0..count {
                let mut s = 0.0;
                for c in 0..DH { s = s + q[r, c0 + c] * k[j, c0 + c]; };
                p[j] = s * scale;
            };
            let mut m = p[0];
            for j in 1..count { if p[j] > m { m = p[j]; }; };
            let mut z = 0.0;
            for j in 0..count { p[j] = exp(p[j] - m); z = z + p[j]; };
            let rz = 1.0 / z;
            for c in 0..DH { out[r, c0 + c] = 0.0; };
            for j in 0..count {
                let w = p[j] * rz;
                for c in 0..DH { out[r, c0 + c] = out[r, c0 + c] + w * v[j, c0 + c]; };
            };
        };
    };
    Tensor(data: out)
}

// A tensor whose every element its producer writes (`sgemm` with `beta` 0, a block-by-block
// result): no initialization to pay for.
fn uninitialized<const R: i32, const C: i32>() -> Tensor<f32, R, C> {
    let buffer: [f32; R, C] = mlir::memref::alloc();
    mlir::bufferization::to_tensor(buffer, restrict: "unit")
}

// `softmax(mask(scores / sqrt(DH)))` for one block, `scores = Q Kᵀ`: row `i` spread over positions
// `0..=i`, zero after.
fn causal_softmax<const L: i32>(scores: Tensor<f32, L, L>, dh: i32) -> Tensor<f32, L, L> {
    let width: f32 = dh.to();
    let scale = 1.0 / mlir::math::sqrt(width);
    let mut p: [[f32; L]; L] = mlir::memref::alloc();
    // The exponentials, the sum and the normalization in separate loops: the exponential loop then
    // has no reduction in it (a float sum can't be reordered, so it kept the whole loop scalar) and
    // vectorizes, the softmax 2.4x faster.
    for i in 0..L {
        let mut m = scores[i, 0];
        for j in 1..i + 1 { if scores[i, j] > m { m = scores[i, j]; }; };
        for j in 0..i + 1 { p[i, j] = exp((scores[i, j] - m) * scale); };
        let mut z = 0.0;
        for j in 0..i + 1 { z = z + p[i, j]; };
        let rz = 1.0 / z;
        for j in 0..i + 1 { p[i, j] = p[i, j] * rz; };
        for j in i + 1..L { p[i, j] = 0.0; };
    };
    Tensor(data: p)
}

// `dS = P * (dP - rowsum(dP * P)) / sqrt(DH)`, the gradient of the scaled
// scores from that of the weights (masked entries have `P = 0`, so `dS = 0`).
fn attention_score_grad<const L: i32>(p: Tensor<f32, L, L>, dp: Tensor<f32, L, L>, dh: i32) -> Tensor<f32, L, L> {
    let width: f32 = dh.to();
    let scale = 1.0 / mlir::math::sqrt(width);
    let mut ds: [[f32; L]; L] = mlir::memref::alloc();
    for i in 0..L {
        let mut dot = 0.0;
        for j in 0..L { dot = dot + dp[i, j] * p[i, j]; };
        for j in 0..L { ds[i, j] = p[i, j] * (dp[i, j] - dot) * scale; };
    };
    Tensor(data: ds)
}

// Draws a class from row `r` of a matrix of logits: class `c` with
// probability `softmax(z[r] / temperature)[c]`. Below 1 the temperature
// sharpens the distribution toward the likeliest classes, above 1 it
// flattens it. Shifted by the row's maximum, so `exp` never overflows.
fn sample_row<const R: i32, const C: i32>(z: Tensor<f32, R, C>, r: i32, temperature: f32) -> i32 {
    let mut m = z[r, 0];
    for c in 1..C { if z[r, c] > m { m = z[r, c]; }; };
    let mut total = 0.0;
    for c in 0..C { total = total + exp((z[r, c] - m) / temperature); };
    let target = rand_uniform_f32() * total;
    let mut acc = 0.0;
    let mut chosen = C - 1;
    let mut found = false;
    for c in 0..C {
        acc = acc + exp((z[r, c] - m) / temperature);
        if not found and acc > target { chosen = c; found = true; };
    };
    chosen
}

// Nucleus (top-p) sampling (Holtzman et al., 2019): as `sample_row`, but drawn
// only among the most likely tokens that together hold a fraction `top_p` of
// the probability (the nucleus), renormalized. The long tail of individually
// unlikely tokens, which together weigh a lot, is cut; how many tokens are
// kept follows the model's confidence (one or two when it is sure, dozens when
// many continuations fit). `top_p` of 1 keeps every token.
//
// The nucleus is every token whose weight `exp((z - max) / temperature)`, in
// `(0, 1]`, is at least a threshold: the largest threshold still keeping
// `top_p` of the total, found by bisection rather than by sorting the row.
fn sample_row_top_p<const R: i32, const C: i32>(z: Tensor<f32, R, C>, r: i32, temperature: f32, top_p: f32) -> i32 {
    let mut m = z[r, 0];
    let mut best = 0;
    for c in 1..C { if z[r, c] > m { m = z[r, c]; best = c; }; };
    let mut w: [f32; C] = mlir::memref::alloc();
    let mut total = 0.0;
    for c in 0..C { w[c] = exp((z[r, c] - m) / temperature); total = total + w[c]; };
    let wanted = top_p * total;
    let mut lo = 0.0;
    let mut hi = 1.0;
    for i in 0..40 {
        let mid = (lo + hi) * 0.5;
        let mut kept = 0.0;
        for c in 0..C { if w[c] >= mid { kept = kept + w[c]; }; };
        if kept >= wanted { lo = mid; } else { hi = mid; };
    };
    let mut nucleus = 0.0;
    for c in 0..C { if w[c] >= lo { nucleus = nucleus + w[c]; }; };
    let target = rand_uniform_f32() * nucleus;
    let mut acc = 0.0;
    let mut chosen = best;
    let mut found = false;
    for c in 0..C {
        if w[c] >= lo {
            acc = acc + w[c];
            if not found and acc > target { chosen = c; found = true; };
        };
    };
    chosen
}

// The mean of row `r` and `1 / sqrt(variance + 1e-5)` (the biased variance,
// as PyTorch's `layer_norm`).
fn row_moments<T: Float, const R: i32, const C: i32>(x: Tensor<T, R, C>, r: i32) -> (T, T) {
    let n: T = C.to();
    let eps: T = 0.00001;
    let mut s: T = zero();
    for c in 0..C { s = s + x[r, c]; };
    let mean = s / n;
    let mut v: T = zero();
    for c in 0..C { v = v + (x[r, c] - mean) * (x[r, c] - mean); };
    let one: T = one();
    (mean, one / mlir::math::sqrt(v / n + eps))
}

// Cross-entropy against integer targets: `y[b]` is the class of row `b`,
// `-sum_b log(softmax(z)[b, y[b]])`, as PyTorch's `cross_entropy(z, y,
// reduction='sum')` with class indices. The same loss as `cross_entropy`
// against one-hot rows, without building them: for a language model's
// thousands of rows of ~100 classes, the one-hot targets alone would weigh
// more than the logits. The targets aren't differentiable (`_`).
algebra SparseCrossEntropy<Logits, Targets, T> {
    fn sparse_cross_entropy(z: Logits, y: Targets) -> T;
    fn sparse_cross_entropy_grad(z: Logits, y: Targets, u: T) -> Logits;

    adjoint sparse_cross_entropy(z, y), u: (sparse_cross_entropy_grad(z, y, u), _);
}

impl<T: Float, const B: i32, const C: i32> SparseCrossEntropy<Tensor<T, B, C>, [i32; B], T> {
    fn sparse_cross_entropy(z, y) {
        let mut total: T = zero();
        for b in 0..B { total = total + log_sum_exp_row(z, b) - z[b, y[b]]; };
        total
    }
    // `(softmax(z) - onehot(y)) * u`, row by row.
    fn sparse_cross_entropy_grad(z, y, u) {
        let mut g: [[T; C]; B] = mlir::memref::alloc();
        for b in 0..B {
            let lse = log_sum_exp_row(z, b);
            for c in 0..C { g[b, c] = exp(z[b, c] - lse) * u; };
            g[b, y[b]] = g[b, y[b]] - u;
        };
        Tensor(data: g)
    }
}

// An embedding: row `ids[n]` of a `[V, D]` table for each of `N` ids, the
// first layer of a language model (a character's id to its vector). Its
// gradient is the transpose of that gather: each upstream row added back
// into the table row it was read from, so a row read twice gets both
// contributions and a row never read stays zero. The ids aren't
// differentiable (`_`).
algebra Embed<Table, Ids, Rows> {
    fn embed(table: Table, ids: Ids) -> Rows;
    // `table` only gives the result its shape.
    fn embed_grad(table: Table, ids: Ids, u: Rows) -> Table;

    adjoint embed(table, ids), u: (embed_grad(table, ids, u), _);
}

impl<T: Float, const V: i32, const D: i32, const N: i32> Embed<Tensor<T, V, D>, [i32; N], Tensor<T, N, D>> {
    fn embed(table, ids) {
        let mut rows: [[T; D]; N] = mlir::memref::alloc();
        for n in 0..N {
            let r = ids[n];
            for d in 0..D { rows[n, d] = table[r, d]; };
        };
        Tensor(data: rows)
    }
    fn embed_grad(table, ids, u) {
        let mut g: [[T; D]; V] = mlir::memref::alloc();
        for v in 0..V { for d in 0..D { g[v, d] = zero(); }; };
        for n in 0..N {
            let r = ids[n];
            for d in 0..D { g[r, d] = g[r, d] + u[n, d]; };
        };
        Tensor(data: g)
    }
}

// `log(sum_c exp(z[b, c]))` for row `b`, shifted by the row's maximum.
fn log_sum_exp_row<T: Float, const B: i32, const C: i32>(z: Tensor<T, B, C>, b: i32) -> T {
    let mut m: T = z[b, 0];
    for c in 1..C { if z[b, c] > m { m = z[b, c]; }; };
    let mut s: T = zero();
    for c in 0..C { s = s + exp(z[b, c] - m); };
    m + log(s)
}

algebra Sum<Container, T> {
    fn sum(c: Container) -> T;
    // `d(sum(c))/du = broadcast(u)` — the adjoint of "add every element
    // together" is "scatter the upstream scalar back onto every element
    // equally" (`⟨sum(v), u⟩ = ⟨v, u·1⟩` — `sum`'s own Jacobian is the row
    // vector of all-ones, so its adjoint is that same vector times `u`,
    // i.e. `u` broadcast into `c`'s own shape). Declared as a *same*-
    // algebra sibling method, not a separate `Broadcast<T,Container>`
    // algebra — tried specifically to sidestep `egraph.rs::build_pattern`'s
    // own cross-algebra single-`agreed`-type limitation (`Transpose`'s own
    // adjoint rule, `stdlib/linalg/matrix.cleave`, already hits that one).
    // **Still not actually reachable, a real, separate, deeper gap found
    // this way**: `monomorphize.rs::find_impl_for_target`'s own resolution
    // is *positional*, not name-directed — it assumes the one concrete
    // type it has (`u`'s own type `T`) corresponds to `Sum<Container,T>`'s
    // own *first* declared generic (`Container`), because that happened to
    // be true for `Transpose<A,B>` (`transpose`'s own sole parameter `a`
    // has type `A`, the first generic) — here `u`'s own type is `T`, the
    // *second* generic, so the match is tried against the wrong position
    // and fails silently (`Sum::broadcast<Tensor<...>,f32>` never gets
    // monomorphized at all, confirmed directly, not assumed). Fixing this
    // for real needs `find_impl_for_target` to resolve by the algebra's own
    // declared generic *name* (via `registry.fn_sig`), not by positional
    // index — not attempted yet (`doc/backlog.md`).
    fn broadcast(u: T) -> Container;
    adjoint sum(c), u: broadcast(u);
}

algebra Mean<Container, T> {
    fn mean(c: Container) -> T;
}

// Named `max_of`, not `max` — no real collision exists today, but `max`
// reads oddly right next to a hypothetical future scalar `max(a,b)`.
algebra Max<Container, T> {
    fn max_of(c: Container) -> T;
}

impl<T: Float, const N: i32> Sum<Tensor<T, N>, T> {
    fn sum(v) {
        let mut acc: T = Ring::zero();
        for i in 0..N { acc = acc + v[i]; };
        acc
    }
    fn broadcast(u) { Tensor::<T, N>(data: [u; N]) }
}

// Rank-2-specific, like `MatMul`/`Transpose` (`stdlib/linalg/matrix.cleave`'s
// own doc comment on why those aren't pack-generic either) — no pack-generic
// `[i32; K]`-style index array read here, an ordinary nested `for` loop is
// enough. An ordinary `for` loop *would* be a real problem for `derive()`
// (forward-mode differentiation needs to see through a differentiated
// function's own body directly, `Forward::try_unroll_for_loop`), but not
// here: `sum` is an *algebra* method, not a plain top-level `fn` — every
// existing algebra method already stays an opaque `Op` node in the e-graph
// (`MatMul::matmul`'s own real `linalg.matmul` body is never "looked
// inside" either, confirmed directly via `egraph.rs::tests::adjoint_matmul_
// rule_...`'s own extracted expression, which names `MatMul::matmul<...>`
// itself, never its own internal op), addressed purely through its own
// declared `derivative`/`adjoint` rule — `sum`'s own forward implementation
// detail is invisible to reverse-mode differentiation regardless of shape.
impl<T: Float, const N: i32, const M: i32> Sum<Tensor<T,N,M>, T> {
    fn sum(c) {
        let mut acc: T = Ring::zero();
        for i in 0..N {
            for j in 0..M { acc = acc + c[i, j]; };
        };
        acc
    }
    fn broadcast(u) {
        Tensor::<T,N,M>(data: [[u; M]; N])
    }
}

// `Broadcast0<Row,Batch>` — real batch-dimension broadcast, added for
// `dense_forward`'s own broadcast bias-add below: `Dense<T,In,Out>::b` is
// stored `Tensor<T,1,Out>` for every `Dense` value regardless of how many
// rows a given call batches together, so adding it to a `Tensor<T,B,Out>`
// batch of activations needs a real broadcast along axis 0 first —
// `Ring<Tensor<T,Dims...>>::add` only ever accepts two operands of the
// *identical* shape, no implicit broadcasting. Mirrors `Sum<Container,T>`/
// `Sum::broadcast` immediately above exactly — a real reduce/broadcast
// adjoint pair, `reduce0` undoing `broadcast0` and vice versa (`⟨
// broadcast0(r), u⟩ = ⟨r, reduce0(u)⟩` — the same "adjoint of a linear map
// built from a 0/1 selection matrix is its own transpose" reasoning
// `Sum`'s own doc comment already has), declared as a *same*-algebra
// sibling pair for the identical reason `Sum`'s own avoids a second
// cross-algebra reference. Reduces only along axis 0 (never *all* axes
// down to a bare scalar), so this never hits the "0-rank tensor" wall a
// full reduction would (`doc/backlog.md`) — `reduce0`'s own result is a
// genuine rank-2 `Tensor<T,1,M>`, not a scalar.
algebra Broadcast0<Row, Batch> {
    fn broadcast0(r: Row) -> Batch;
    fn reduce0(b: Batch) -> Row;
    adjoint broadcast0(r), u: reduce0(u);
    adjoint reduce0(b), u: broadcast0(u);
    // Both a real gap, found while retiring `Dense::forward` in favor of
    // `dense_forward` (`doc/backlog-done.md`'s own "impls inhérents" entry):
    // `Dense::forward`'s own plain `+` only ever needed `Ring::add`'s
    // already-declared forward-mode rule, so `Broadcast0` itself never
    // needed one before — `derive()`'s own forward-mode differentiation
    // through `dense_forward` (which routes the bias through `broadcast0`)
    // failed outright without it ("no derivative rule for..."). Both maps
    // are linear, so each one's own derivative is just itself applied to
    // the input's derivative — exactly the same shape any other linear
    // stdlib op's `derivative` rule already takes.
    derivative broadcast0(r): broadcast0(d(r));
    derivative reduce0(b): reduce0(d(b));
}

impl<T: Float, const B: i32, const M: i32> Broadcast0<Tensor<T,1,M>, Tensor<T,B,M>> {
    // Same manual-counter-for-the-second-generic shape `Sum::sum` above
    // already established, for the identical reason (`doc/backlog.md`) —
    // `B`/`M` are two different const generics of this same impl; only one
    // of the two indices used inside `data[i,j]`/`r[0,j]`/`b[i,j]` may come
    // from a real `for`-loop-bound variable at a time, or their own value-
    // vars get silently unified together during this impl's own body
    // type-check.
    // Both now a real `linalg.generic` (`mlir_lower.rs::build_broadcast0`/
    // `build_reduce0`'s own doc comments have the full story) instead of a
    // hand-written scalar `for` loop — found the hard way, chasing why a
    // real MLIR loop-fusion pass never fired anywhere on the real kernel
    // (`doc/backlog.md`): this scalar copy sat between every consecutive
    // pair of matmuls, real runtime cost, zero vectorization, on every
    // layer, every batch.
    fn broadcast0(r) {
        mlir::linalg::broadcast(r)
    }
    fn reduce0(b) {
        mlir::linalg::reduce(b)
    }
}

// The one real `Dense`-forward function now that `Dense::forward` (above)
// is gone — a plain top-level generic `fn`, batched over `B` (a generic
// *owned by the call itself*, varying per call site, never per `Dense`
// value) and correct for `B=1` too via `broadcast0`'s own identity-shaped
// case. Originally written as a *workaround* for an inherent-impl method's
// own generics not being picked up by inference at all (`doc/backlog.md`'s
// own former "An inherent-impl method's own generics..." item) — now simply
// the only `Dense`-forward function, that gap having nothing left to apply
// to. A proven-working shape well before this, regardless (`dynarray_new<T>`,
// every algebra-impl method, and — combining a bound *and* several const
// generics at once — `cleave/tests/mlir_lower.rs`'s own `a_top_level_fn_
// combines_a_bounded_type_generic_with_several_const_generics`).
fn dense_forward<T: Float, const B: i32, const In: i32, const Out: i32>(layer: Dense<T,In,Out>, x: Tensor<T,B,In>) -> Tensor<T,B,Out> {
    matmul(x, layer.w) + broadcast0(layer.b)
}

// A gated MLP, SwiGLU (Shazeer, 2020), the MLP of Llama and most transformers
// since: `down(silu(gate(x)) * up(x))`, `D -> H -> D`. The gate decides, per
// hidden unit, how much of `up`'s value passes. Three matrices instead of two,
// so `H` is usually `8/3 D` rather than `4 D` for the same parameter count.
struct SwiGlu<T: Float, const D: i32, const H: i32> { gate: Dense<T, D, H>, up: Dense<T, D, H>, down: Dense<T, H, D> }

impl<T: Float + Rand + Ring, const D: i32, const H: i32> Init<SwiGlu<T, D, H>> {
    fn xavier() { SwiGlu(gate: Init::xavier(), up: Init::xavier(), down: Init::xavier()) }
    fn he() { SwiGlu(gate: Init::he(), up: Init::he(), down: Init::he()) }
}

impl<T: Float, const D: i32, const H: i32> Trainable<SwiGlu<T, D, H>> {}

fn swiglu_forward<T: Float, const B: i32, const D: i32, const H: i32>(m: SwiGlu<T, D, H>, x: Tensor<T, B, D>) -> Tensor<T, B, D> {
    m.down.dense_forward(silu(m.gate.dense_forward(x)) * m.up.dense_forward(x))
}

// A table of learned vectors, one row per token: `embedding_forward` reads the
// rows of a batch of ids, `embedding_logits` scores a batch of vectors against
// every row, the output layer of a language model whose head is tied to its
// input embedding (one table for both, its gradient the sum of both uses).
// `Parameters` but not `Trainable`: an elementwise optimizer updates its table
// as any tensor, `Muon` keeps it on AdamW (a table isn't a hidden matrix).
struct Embedding<T: Float, const V: i32, const D: i32> { table: Tensor<T, V, D> }

impl<T: Float, const V: i32, const D: i32> Parameters<Embedding<T, V, D>> {}

impl<T: Float + Rand + Ring, const V: i32, const D: i32> Init<Embedding<T, V, D>> {
    fn xavier() { Embedding(table: Init::xavier()) }
    fn he() { Embedding(table: Init::he()) }
}

fn embedding_forward<T: Float, const V: i32, const D: i32, const N: i32>(e: Embedding<T, V, D>, ids: [i32; N]) -> Tensor<T, N, D> {
    embed(e.table, ids)
}

fn embedding_logits<const V: i32, const D: i32, const N: i32>(e: Embedding<f32, V, D>, h: Tensor<f32, N, D>) -> Tensor<f32, N, V> {
    matmul_transpose_b(h, e.table)
}

impl<Opt: ElementwiseOptimizer, T: Float, const V: i32, const D: i32, S> Optimizer<Opt, Embedding<T, V, D>, S> {
    fn init_state(opt, e) { init_state(opt, e.table) }
    fn step(opt, e, grad, state) {
        let (table, next) = step(opt, e.table, grad.table, state);
        (Embedding(table: table), next)
    }
}

impl<const V: i32, const D: i32> Optimizer<Muon, Embedding<f32, V, D>, AdamState<f32, V, D>> {
    fn init_state(opt, e) { init_state(opt.adamw, e.table) }
    fn step(opt, e, grad, state) {
        let (table, next) = step(opt.adamw, e.table, grad.table, state);
        (Embedding(table: table), next)
    }
}

// Gradient clipping by global norm, as `torch.nn.utils.clip_grad_norm_`: the
// norm of the whole gradient (every tensor of the model as one vector), and
// when it exceeds `max_norm`, the whole gradient scaled by `max_norm / (norm +
// 1e-6)`. A rare huge gradient (a bad batch, an unstable early step) moves the
// weights no further than `max_norm` would.
algebra GradNorm<M> {
    fn squared_norm(m: M) -> f32;
    fn scaled(m: M, s: f32) -> M;
}

impl<const N: i32> GradNorm<Tensor<f32, N>> {
    fn squared_norm(m) { sum(m * m) }
    fn scaled(m, s) { Scale::scale(m, s) }
}

impl<const R: i32, const C: i32> GradNorm<Tensor<f32, R, C>> {
    fn squared_norm(m) { sum(m * m) }
    fn scaled(m, s) { Scale::scale(m, s) }
}

// Every `Parameters` struct, field by field.
impl<M: Parameters> GradNorm<M> {
    fn squared_norm(m) {
        let parts = [for i in 0..m.len(): squared_norm(m[i])];
        let mut total = 0.0;
        for i in 0..parts.len() { total = total + parts[i]; };
        total
    }
    fn scaled(m, s) { [for i in 0..m.len(): scaled(m[i], s)] }
}

fn clip_grad_norm<M: GradNorm>(g: M, max_norm: f32) -> M {
    let norm = sqrt(squared_norm(g));
    if norm > max_norm { scaled(g, max_norm / (norm + 0.000001)) } else { g }
}

impl<T: Float, const N: i32> Mean<Tensor<T, N>, T> {
    fn mean(v) {
        let n: T = N.to();
        sum(v) / n
    }
}

impl<T: Float, const N: i32> Max<Tensor<T, N>, T> {
    fn max_of(v) {
        let mut acc = v[0];
        for i in 1..N {
            if v[i] > acc { acc = v[i]; };
        };
        acc
    }
}
