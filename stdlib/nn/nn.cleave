// The activation/reduction half of `doc/backlog.md`'s own "toward simple
// ML" roadmap item — ordinary stdlib algebras and `mlir::...` bodies, no
// new compiler mechanism: `relu`/`sigmoid`/`tanh` are each a one-or-two-line
// `mlir::...` call, exactly the same shape every `Ring`/`Ord` impl already
// uses; `sum`/`mean`/`max_of` are plain cleave source (a `for` loop plus
// `Tensor`'s own real multi-index `Index` read), needing no MLIR-level
// reduction op at all.
//
// This is the first stdlib crate to reference *another* stdlib crate's own
// types (`Tensor`) — `use linalg;` right below is followed transitively by
// `driver.rs`'s own `compile` (real DFS-based crate resolution, with cycle
// detection, not the former "one level deep only" limitation that used to
// make this line functionally inert: a program writing only `use nn;`,
// with no `use linalg;` of its own, sees `Tensor`/`Ring<Tensor<T,N>>`/etc.
// anyway — `cleave/tests/mlir_lower.rs`'s own `nn` tests are the real proof,
// none of them write `use linalg;` themselves). `mean`'s own `.to()` call
// needs `convert` too, transitively resolved the identical way. `dense_
// xavier`/`dense_he`'s own `uniform`/`normal` calls need `rand` the same
// way; `Optimizer<Opt, Dense<T,In,Out>>` below needs `optim` (`Optimizer`
// itself, plus `Sgd`/`Momentum`'s own leaf-level `Tensor` impls it forwards
// into) for the identical reason.
use linalg;
use convert;
use rand;
use optim;

algebra Activation<T> {
    fn relu(x: T) -> T;
    fn sigmoid(x: T) -> T;
    fn tanh(x: T) -> T;

    // No `derivative` rule of its own for `tanh` (or anything else) --
    // `tanh`'s own derivative belongs to `Transcendental<T>` (`stdlib/num/
    // num.cleave`), the math function itself, not this ML-specific
    // wrapper algebra that merely exposes it under a uniform activation
    // interface -- see that algebra's own doc comment for why. `Activation
    // <T>::tanh`'s own impls below delegate to it via a qualified call
    // (`Transcendental::tanh(x)`), so its derivative composes for free
    // through the delegation, no rule needed here at all.
}

// `arith.maximumf(x, 0.0)`/`1.0 + ...` — a bare literal operand here is
// fine (unlike the `arith.index_cast`-on-a-bare-literal rough edge `doc/
// backlog.md` tracks): that gap is specifically about an op whose operand
// type genuinely differs from its result type (`index_cast`'s own `i32 ->
// index`); every op here has identical operand/result types, so `lower_
// raw_mlir_op`'s own "infer operand type from a `CVal::Var` sibling, else
// fall back to the result type" heuristic is correct either way.
//
// `sigmoid`/`tanh` are now built entirely from named, individually-
// differentiable primitives (`Ring`'s `div`/`neg`, `Transcendental`'s
// `exp`/`tanh` — `stdlib/num/num.cleave`) rather than raw `mlir::...`
// calls — no derivative rule of their own needed on `Activation` at all,
// see that algebra's own doc comment. `Transcendental::tanh(x)` is a
// *qualified* call, not a bare `tanh(x)` — `Activation<T>` and
// `Transcendental<T>` both declare a 1-arg `tanh`, so an unqualified call
// here would be genuinely ambiguous (`TypeErrorKind::AmbiguousOperator`),
// not just resolve to "the obviously intended one". `exp` has no such
// collision (only `Transcendental` declares it), so it's called bare.
impl Activation<f32> {
    fn relu(x) { mlir::arith::maximumf(x, 0.0) }
    fn sigmoid(x) { 1.0 / (1.0 + exp(-x)) }
    fn tanh(x) { Transcendental::tanh(x) }
}

impl Activation<f64> {
    fn relu(x) { mlir::arith::maximumf(x, 0.0) }
    fn sigmoid(x) { 1.0 / (1.0 + exp(-x)) }
    fn tanh(x) { Transcendental::tanh(x) }
}

// The `Tensor<T,Dims...>` counterpart — pack-generic over *any* rank (was
// rank-1-only, `Tensor<T,N>`, until this generalization): `relu`/`tanh` stay
// raw `mlir::...` calls applied directly over the tensor-backed operand
// (`arith.maximumf`/`math.tanh` apply structurally at any rank exactly the
// way `Ring<Tensor<T,Dims...>>::add`'s own `arith.addf` already does,
// confirmed directly — `cleave/tests/mlir_lower.rs::relu_sigmoid_tanh_
// compute_correctly_on_vectors`) — `relu`/`tanh` have no `derivative` rule
// of their own either way, scalar or `Tensor`, a known, narrower, separate
// gap this impl doesn't attempt to close (differentiating *through* either
// one isn't exercised anywhere reached by `derive()` yet).
//
// `sigmoid` is different: `Dense::forward` (`examples/xor_tensor.cleave`)
// needs to differentiate all the way *through* it, so it composes from real,
// named, individually-differentiable calls -- `Ring::neg`/`add`/`div` (this
// same file's own `Ring<Tensor<T,Dims...>>` above) and `Transcendental::exp`
// (`stdlib/linalg/tensor.cleave`'s new `impl<T,Dims...> Transcendental<
// Tensor<T,Dims...>>`) -- the *exact* same shape its own scalar sibling just
// above already uses (`1.0 / (1.0 + exp(-x))`), not the raw `mlir::arith::
// negf`/`addf`/`divf` calls an earlier version of this impl used. Found
// directly, by testing `Dense`/`Network`: a raw-op body, even though
// numerically identical, is *purely* a chain of pure primops with no real
// call in it at all -- `egraph.rs::is_straight_line` -- so `Forward::walk`
// treated it as one opaque, unnamed node (the same treatment a genuinely
// atomic op like `matmul` gets, correctly, because *it* has a declared
// `derivative` rule to match against). `sigmoid` has no such rule (by
// design -- see `Activation<T>`'s own doc comment: its derivative is meant
// to compose automatically from its own primitives), so an opaque `sigmoid`
// node could never differentiate at all -- silently stuck as a raw,
// unresolved `derivative(...)` marker for *any* leaf reachable only through
// it, rather than a clean error. `stdlib/num/num.cleave`'s own `Transcendental
// <T>` doc comment already tells this identical story for the scalar case
// ("sigmoid... had no path to a derivative at all short of its own hand-
// written closed form... moving `exp` here... means sigmoid's derivative now
// composes automatically via ordinary chain-rule saturation") -- this is
// that same fix, just not yet carried over to the pack-generic case until
// now. `one`, a same-shape broadcast tensor of `1.0`, still can't be
// avoided (`Ring::add`/`div` require *matching* operand types, and a bare
// `1.0` literal is `T`, not `Tensor<T,Dims...>`) -- built via `[value;
// Dims...]` plus `Tensor::<T,Dims...>(data:...)`, same as `relu` below.
impl<T: Float, const Dims...: i32> Activation<Tensor<T, Dims...>> {
    fn relu(x) {
        let zero = Tensor::<T, Dims...>(data: [0.0; Dims...]);
        mlir::arith::maximumf(x, zero)
    }
    fn sigmoid(x) {
        let one: Tensor<T, Dims...> = Tensor::<T, Dims...>(data: [1.0; Dims...]);
        one / (one + exp(-x))
    }
    fn tanh(x) { mlir::math::tanh(x) }
}

// A fully-connected layer -- ordinary stdlib struct plus inherent impl, same
// shape as `Complex<T>::magnitude`/`magnitude_sq` (`stdlib/complex/
// complex.cleave`), no new compiler mechanism: `forward` is just `matmul`
// (`linalg::matrix.cleave`) followed by a bias add (`Ring<Tensor<...>>::
// add`, via `+`), both already proven independently. This is the `Dense`
// the session's own `Network`/`xor_tensor.cleave` rewrite bundles multiple
// of, replacing the eleven loose scalar parameters that example used to
// take.
//
// Deliberately *no* activation baked in here -- an earlier version of this
// impl called `sigmoid` directly at the end of `forward`, inherited
// unquestioned from `examples/xor_tensor.cleave`'s own pre-`Dense`
// `sigmoid2` helper (which *did* fuse linear+activation), without stepping
// back to ask whether that was the right split. It wasn't: a real, reusable
// `Dense` needs to stay just the affine transform, exactly like `nn.Linear`
// in every other framework -- the *caller* composes whichever activation it
// wants (`sigmoid`, `relu`, or none at all, for a final logit) on top,
// ordinarily, as a real separate call. Nothing about `derive()` needs the
// activation fused in either way -- confirmed directly, not assumed: `Ring
// ::neg`/`add`/`div`/`Transcendental::exp` (`sigmoid`'s own composition,
// above) differentiate correctly through an ordinary call site exactly like
// `Dense::forward`'s own call site does.
struct Dense<T: Float, const In: i32, const Out: i32> { w: Tensor<T, In, Out>, b: Tensor<T, 1, Out> }

impl<T: Float, const In: i32, const Out: i32> struct Dense<T, In, Out> {
    // `x` is a single `1 x In` row (one training example), matching
    // `matmul`'s own `Tensor<T,N,M> x Tensor<T,M,K> -> Tensor<T,N,K>` shape
    // with `N=1` -- the same single-example-at-a-time reasoning `examples/
    // xor.cleave`/`xor_tensor.cleave` already document for their own SGD
    // loop.
    fn forward(layer, x: Tensor<T, 1, In>) -> Tensor<T, 1, Out> {
        matmul(x, layer.w) + layer.b
    }
}

// `Init<T>::xavier`/`he` -- real weight initialization, `doc/backlog.md`'s
// own "No weight-initialization helpers" item finally closed now that `rand`
// (`stdlib/rand/rand.cleave`) exists to build it on.
//
// A real, if narrow, algebra -- not `Dense`-inherent methods (an inherent
// method call always needs a real receiver whose own type drives dispatch,
// `registry.rs`'s own `inherent_method` doc comment: "dispatch always starts
// from a resolved struct name" -- a constructor has no `Dense` value yet to
// call one on) -- and, a real, found-by-testing surprise, *not* a plain top-
// level generic function either, even though that's the shape every other
// helper in this file (`random_matrix`, this session's own validation probe)
// already used successfully. `fn dense_xavier<T,In,Out>() -> Dense<T,In,Out>`
// (zero real value parameters, every one of its three generics determined
// *purely* by the caller's own expected-type context, e.g. `let d: Dense<f32,
// 2,2> = dense_xavier();`) hit a genuine compiler gap: unlike `Ring::zero()`
// (also zero-arg, also purely output-type-determined, and already proven to
// work everywhere), an ordinary top-level generic *function* call in this
// same shape doesn't get that expected-type context propagated into its own
// body at all -- confirmed directly: `.to()` (`Convert`) inside the body came
// back "ambiguous dispatch ... could resolve to Convert<i32,f32> or
// Convert<i32,f64>" even with the call site's own type fully pinned one level
// up. Turbofish doesn't rescue it either -- a *second*, independent bug: any
// call to a zero-*value*-parameter generic function with an explicit turbofish
// (`dense_xavier::<f32>()`) is misdiagnosed as a real *argument* ("expects 0
// argument(s), found 1"), the turbofish's own generic count apparently
// counted as call arguments. Neither investigated further here (both flagged
// in `doc/backlog.md`) -- routing through `Init<T>` instead sidesteps both at
// once, reusing `Ring::zero()`'s own already-proven algebra-dispatch
// resolution path rather than the broken one.
algebra Init<T> {
    fn xavier() -> T;
    fn he() -> T;
}

// `[[uniform(lo, hi); Out]; In]` -- `array-repeat` now evaluates its own
// value expression independently at every leaf position (fixed directly in
// `cps.rs`, no longer "evaluate once, broadcast"), so this fills the whole
// tensor with independent draws in one expression, same as it always could
// for a pure value like `Ring::zero()`.
//
// `In`/`Out` (bare const generics) can't be handed to `.to()` directly --
// the same `Ty::Const`-vs-`Ty::Con` gap `Mean::mean`'s own doc comment above
// already documents and works around, identically here: `mlir::arith::addi
// (In, 0)` forces each into a real, computed `i32` value first.
//
// Bias is zero-initialized in both -- the standard convention, and `Ring::
// zero()` already does exactly this for a `Tensor`-typed field.
impl<T: Float + Rand + Ring, const In: i32, const Out: i32> Init<Dense<T, In, Out>> {
    // Xavier/Glorot uniform (Glorot & Bengio, 2010) -- `limit = sqrt(6 /
    // (fan_in + fan_out))`, weight ~ `Uniform(-limit, limit)` -- the standard
    // choice for a `sigmoid`/`tanh`-activated layer (`examples/xor_tensor.
    // cleave`'s own).
    fn xavier() {
        let fan_in_i: i32 = mlir::arith::addi(In, 0);
        let fan_out_i: i32 = mlir::arith::addi(Out, 0);
        let fan_in: T = fan_in_i.to();
        let fan_out: T = fan_out_i.to();
        let limit: T = mlir::math::sqrt(6.0 / (fan_in + fan_out));
        Dense(w: Tensor::<T, In, Out>(data: [[uniform(-limit, limit); Out]; In]), b: Ring::zero())
    }

    // He normal (He et al., 2015) -- `std = sqrt(2 / fan_in)`, weight ~
    // `Normal(0, std)` -- the standard choice for a `relu`-activated layer.
    // Not used by `examples/xor_tensor.cleave` (its own network is `sigmoid`
    // throughout, so `xavier` above is the one it actually needs), but real
    // and tested independently -- a network with a `relu` hidden layer needs
    // exactly this.
    fn he() {
        let fan_in_i: i32 = mlir::arith::addi(In, 0);
        let fan_in: T = fan_in_i.to();
        let std: T = mlir::math::sqrt(2.0 / fan_in);
        Dense(w: Tensor::<T, In, Out>(data: [[normal(0.0, std); Out]; In]), b: Ring::zero())
    }
}

// `doc/backlog.md`'s own "Optimizer" item -- one impl, generic over `Opt`
// itself, covers *every* optimizer `optim.cleave` ever declares a leaf-level
// impl for (`Sgd`, `Momentum`, and anything added later) -- the body never
// calls a method on `opt` directly, only forwards it into `Optimizer::step`/
// `init_state` on `.w`/`.b`, which redispatch on their own to whichever
// concrete optimizer `opt` actually is. No bound needed on `Opt` at all.
impl<Opt, T: Float + Ring, const In: i32, const Out: i32> Optimizer<Opt, Dense<T, In, Out>> {
    fn init_state(opt, model) {
        Dense(w: Optimizer::init_state(opt, model.w), b: Optimizer::init_state(opt, model.b))
    }
    fn step(opt, model, grad, state) {
        let rw = Optimizer::step(opt, model.w, grad.w, state.w);
        let rb = Optimizer::step(opt, model.b, grad.b, state.b);
        (Dense(w: rw.0, b: rb.0), Dense(w: rw.1, b: rb.1))
    }
}

algebra Sum<Container, T> {
    fn sum(c: Container) -> T;
}

algebra Mean<Container, T> {
    fn mean(c: Container) -> T;
}

// Named `max_of`, not `max` — no real collision exists today, but `max`
// reads oddly right next to a hypothetical future scalar `max(a,b)`.
algebra Max<Container, T> {
    fn max_of(c: Container) -> T;
}

impl<T: Float, const N: i32> Sum<Tensor<T, N>, T> {
    fn sum(v) {
        let mut acc = v[0];
        for i in 1..N { acc = acc + v[i]; };
        acc
    }
}

impl<T: Float, const N: i32> Mean<Tensor<T, N>, T> {
    // `N.to()` (`stdlib/convert/convert.cleave`'s own `Convert<i32,T>`
    // sugar) — used to be a `mlir::arith::sitofp` workaround instead: an
    // output-only-generic premature-commit bug meant `N.to()` here would
    // permanently bind *this* impl's own `T` the moment `From` (`i32`)
    // looked ready, during mere declaration-checking, well before any real
    // instantiation ever ran — `doc/backlog.md`'s own "Convert/output-only-
    // generic premature-commit bug" item, fixed for real now (`infer.rs`'s
    // `infer_algebra_call` defers instead of committing whenever a still-
    // open generic fn/impl's own declaration is what's being checked).
    // `N` still can't be handed to `.to()` bare, though — a bare const
    // generic used as an ordinary value hits a separate, still-open
    // `Ty::Const`-vs-`Ty::Con` gap (`doc/backlog.md`), unrelated to the bug
    // above — `mlir::arith::addi(N, 0)` forces it into a genuine computed
    // `i32` value first, the same pattern this rough edge already needs
    // elsewhere.
    fn mean(v) {
        let n_i: i32 = mlir::arith::addi(N, 0);
        sum(v) / n_i.to()
    }
}

impl<T: Float, const N: i32> Max<Tensor<T, N>, T> {
    fn max_of(v) {
        let mut acc = v[0];
        for i in 1..N {
            if v[i] > acc { acc = v[i]; };
        };
        acc
    }
}
