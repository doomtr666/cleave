// `doc/backlog.md`'s own "No `Optimizer` abstraction" item: a real,
// generic, stateful optimizer -- `Optimizer<Opt, Model, State>`, `Opt` a
// plain hyperparameter-holder struct (`Sgd { lr }`, `Momentum { lr, beta }`,
// `Adam { lr, beta1, beta2, eps }`), not a value threaded through call
// arguments the way `Scale<Container,T>`'s own scalar factor is -- each
// optimizer needs genuinely different hyperparameters, so each gets its own
// struct field set, the same "config lives in struct fields" shape
// `Dense`/`Init` already use, rather than forcing every optimizer's `step`
// to share one fixed argument list.
//
// **`State` is its own, independent target -- not `Model` reused directly.**
// An earlier design *did* reuse `Model` directly (a velocity has exactly the
// same shape as a weight, so no need for a separate "shadow" struct, or so
// it seemed) -- true for `Sgd` (no state at all) and `Momentum` (one
// velocity, same shape as the weight), but genuinely false the moment an
// optimizer needs *more* than one accumulator of that shape: raised
// directly ("l'API de l'optimiseur est zarbi... pas de support de
// plusieurs simplement (adam, adamw etc.)") -- `Adam` needs *two* (first
// and second moment estimates), which a `fn init_state(...) -> Model`
// signature could never express at all (`Model` names exactly one shape,
// structurally incapable of being "two tensors").
// `Optimizer<Opt, Model, State>` is the real, general fix -- a third,
// independent target, exactly the same heterogeneous-algebra shape
// `MatMul<A, B, C>` (`stdlib/linalg/matrix.cleave`) already established for
// the identical reason (operands and result needing different types/shapes
// at once). `Sgd`/`Momentum` below simply pick `State = Model` again, now
// as an explicit choice rather than the only option; `Adam` picks a real,
// different `AdamState<T, Dims...>` instead.
//
// **A real, deep compiler limitation had to be fixed to make this design
// usable at all** (`doc/backlog.md`'s own "composing algebra impl generic
// over `Opt`..." entry has the full story) -- composing this algebra
// through struct nesting (`stdlib/nn/nn.cleave`'s own `Dense`-level impl,
// a user's own `Network`-level one, ...) used to silently break the moment
// more than one leaf `Opt` impl existed, or leftover free type variables
// reached MLIR lowering outright. Fixed via a real, general re-inference
// fallback in `monomorphize.rs`, not worked around here.
use linalg;
use convert;

struct Sgd { lr: f32 }
struct Momentum { lr: f32, beta: f32 }
struct Adam { lr: f32, beta1: f32, beta2: f32, eps: f32 }
// AdamW (Loshchilov & Hutter, 2019): Adam with *decoupled* weight decay. The
// weights shrink by `lr * weight_decay` of themselves at each step, apart
// from the gradient, rather than through an L2 term in the loss that Adam's
// per-parameter normalization would rescale. As `torch.optim.AdamW`, every
// tensor is decayed (biases and norm gains included).
struct AdamW { lr: f32, beta1: f32, beta2: f32, eps: f32, weight_decay: f32 }
// Muon (Keller Jordan, 2024): for the hidden matrices of a network, the
// momentum of the gradient orthogonalized (`newton_schulz5`) before the step,
// so every direction of the matrix moves by a comparable amount instead of the
// few that dominate the raw gradient. Converges in markedly fewer steps than
// Adam on transformers. Only for matrices: rows of one (biases, norm gains)
// and `Embedding` tables are updated by `adamw` instead.
struct Muon { lr: f32, momentum: f32, weight_decay: f32, adamw: AdamW }

// The optimizers that update every number of a model the same way, whatever
// the tensor stands for (`Muon` doesn't: matrices and the rest differ).
// `stdlib/nn`'s `Embedding` forwards these to its table.
algebra ElementwiseOptimizer<Opt> {}
impl ElementwiseOptimizer<Sgd> {}
impl ElementwiseOptimizer<Momentum> {}
impl ElementwiseOptimizer<Adam> {}
impl ElementwiseOptimizer<AdamW> {}

algebra Optimizer<Opt, Model, State> {
    fn init_state(opt: Opt, model: Model) -> State;
    fn step(opt: Opt, model: Model, grad: Model, state: State) -> (Model, State);
}

// A struct made of parameters: every field a tensor or itself `Parameters`.
// What can be handled field by field whatever the fields are: saved
// (`Checkpoint`), summed (`Accumulate`), measured (`GradNorm`). Opt-in, never
// every struct: a marked struct is exactly what those impls cover, so it can't
// overlap a leaf impl (`doc/plan-compile-time-sequences.md`, "No blanket impl
// over every struct").
algebra Parameters<M> {}

// A model made of parts the optimizer already knows how to update, field by
// field (`impl Trainable<Network> {}`, written next to the struct); every
// `Trainable` is `Parameters`. A `Parameters` struct that isn't `Trainable`
// chooses its own update instead (`stdlib/nn`'s `Embedding`, kept on AdamW
// under `Muon`).
algebra Trainable<M> : Parameters {}

// An array of parameters is parameters, an array of trainable parts is
// trainable (`doc/plan-struct-arrays.md`): a model's layers can be one field,
// `layers: [Layer; LAYERS]`, its depth a constant, and every algebra that
// walks a model part by part (`Optimizer`, `Accumulate`, `GradNorm`,
// checkpoints) walks the array element by element, `len` and `[i]` being
// the same on an array as on a struct.
impl<T: Parameters, const N: i32> Parameters<[T; N]> {}
impl<T: Trainable, const N: i32> Trainable<[T; N]> {}

// Every `Trainable` model, for every optimizer: each field updated by its own
// `Optimizer` impl, the model rebuilt from the new fields (`Collect`, pinned
// to `M` by `step`'s own signature), the state one entry per field (a
// tuple). Nothing here knows
// the field names, their number, or which optimizer runs: the comprehensions
// unroll once per concrete model (`unroll.rs`).
impl<Opt, M: Trainable, S> Optimizer<Opt, M, S> {
    fn init_state(opt, model) {
        [for i in 0..model.len(): init_state(opt, model[i])]
    }
    // Each field's update is its own task (`doc/plan-spawn.md`): fields are
    // independent, and a model's tree of fields (a transformer's blocks, each
    // block's layers) becomes a tree of tasks — parallel without the caller
    // writing anything.
    fn step(opt, model, grad, state) {
        let updated = [for i in 0..model.len(): spawn step(opt, model[i], grad[i], state[i])];
        ([for i in 0..updated.len(): updated[i][0]], [for i in 0..updated.len(): updated[i][1]])
    }
}

// The sum of two gradients (or models) field by field: what combines the
// gradients of a batch's parts computed separately — data parallelism, each
// part's gradient in its own `spawn`ed task (`doc/plan-spawn.md`). A loss
// summed over a batch has the sum of its parts' gradients as its gradient.
algebra Accumulate<M> {
    fn accumulate(a: M, b: M) -> M;
}

impl<T: Float + Ring, const Dims...: i32> Accumulate<Tensor<T, Dims...>> {
    fn accumulate(a, b) { a + b }
}

// Every `Parameters` struct: field by field, the struct rebuilt from the sums
// (`Collect`, pinned to `M` by the signature), as `Optimizer::step` does.
impl<M: Parameters> Accumulate<M> {
    // Field by field, each sum its own task, like `Optimizer::step`.
    fn accumulate(a, b) {
        let sums = [for i in 0..a.len(): spawn accumulate(a[i], b[i])];
        sums
    }
}

// Leaf level -- the only level that actually needs to know what an
// optimizer *is*; every level above this one (`stdlib/nn/nn.cleave`'s own
// `Dense`-level impl, and any user struct's own `Network`-level one) is
// generic over `Opt`/`State` themselves and never touches these bodies at
// all, just forwards into them.
impl<T: Float + Ring, const Dims...: i32> Optimizer<Sgd, Tensor<T, Dims...>, Tensor<T, Dims...>> {
    fn init_state(opt, model) { Ring::zero() }
    fn step(opt, model, grad, state) {
        (Ring::sub(model, Scale::scale(grad, opt.lr)), state)
    }
}

// Momentum (exponential moving average of the gradient, the standard
// formulation): `v <- beta*v + (1-beta)*grad`, `model <- model - lr*v`.
// `state` carries `v` between steps -- the whole reason this algebra
// threads `state` through `step` at all, rather than `Sgd`'s simpler
// "ignore it" shape.
impl<T: Float + Ring, const Dims...: i32> Optimizer<Momentum, Tensor<T, Dims...>, Tensor<T, Dims...>> {
    fn init_state(opt, model) { Ring::zero() }
    fn step(opt, model, grad, state) {
        let v: Tensor<T, Dims...> = Ring::add(Scale::scale(state, opt.beta), Scale::scale(grad, 1.0 - opt.beta));
        (Ring::sub(model, Scale::scale(v, opt.lr)), v)
    }
}

// Adam (Kingma & Ba, 2015): `m <- beta1*m + (1-beta1)*grad` (first moment,
// an EMA of the gradient itself, exactly `Momentum`'s own `v`), `v <-
// beta2*v + (1-beta2)*grad^2` (second moment, an EMA of the squared
// gradient -- a per-parameter estimate of its own recent gradient
// *magnitude*, what makes Adam adapt its own effective step size per
// parameter instead of using one fixed learning rate everywhere). Both
// biased toward zero early on (both start at exactly zero, so an EMA with
// few real samples behind it is still mostly zero) -- `beta1_pow`/
// `beta2_pow` track `beta1^t`/`beta2^t` incrementally (multiplied by their
// own `opt.beta1`/`opt.beta2` once per step, in `state` itself) instead of
// a real exponentiation call (no `pow` primitive exists in this stdlib at
// all, and none is needed here): `m_hat = m/(1-beta1^t)`, `v_hat =
// v/(1-beta2^t)` corrects exactly this early bias. `update = lr * m_hat /
// (sqrt(v_hat) + eps)` -- `eps` (never zero) is what keeps this from
// dividing by zero the moment `v_hat` itself is still near zero.
struct AdamState<T: Float, const Dims...: i32> {
    m: Tensor<T, Dims...>,
    v: Tensor<T, Dims...>,
    beta1_pow: f32,
    beta2_pow: f32,
}

impl<T: Float + Ring, const Dims...: i32> Optimizer<Adam, Tensor<T, Dims...>, AdamState<T, Dims...>> {
    fn init_state(opt, model) {
        // Explicit turbofish: `m`/`v` are both `Ring::zero()`, still fully
        // generic here (its return type is pinned by the field it's assigned
        // to, not the other way around), so the field values fit any number
        // of `Dims` -- an indeterminacy the compiler rejects rather than
        // guesses (`infer.rs::infer_struct_lit_pack_arity`).
        AdamState::<T, Dims...>(m: Ring::zero(), v: Ring::zero(), beta1_pow: 1.0, beta2_pow: 1.0)
    }
    // Not inlined: a model has one leaf per weight tensor (102 in nanoLM's transformer) but only a
    // handful of distinct shapes. Inlined, this step's ten tensor operations were copied for every
    // leaf, most of the compiled code of a training step; called, it's compiled once per shape.
    // The operations inside still inline into it and fuse, and each call works on a whole tensor:
    // the step runs at the same speed.
    #[no_inline]
    fn step(opt, model, grad, state) {
        let (direction, next) = adam_direction(grad, state, opt.beta1, opt.beta2, opt.eps);
        (model - Scale::scale(direction, opt.lr), next)
    }
}

impl<T: Float + Ring, const Dims...: i32> Optimizer<AdamW, Tensor<T, Dims...>, AdamState<T, Dims...>> {
    fn init_state(opt, model) {
        AdamState::<T, Dims...>(m: Ring::zero(), v: Ring::zero(), beta1_pow: 1.0, beta2_pow: 1.0)
    }
    // Not inlined, as `Adam`'s.
    #[no_inline]
    fn step(opt, model, grad, state) {
        let (direction, next) = adam_direction(grad, state, opt.beta1, opt.beta2, opt.eps);
        (Scale::scale(model, 1.0 - opt.lr * opt.weight_decay) - Scale::scale(direction, opt.lr), next)
    }
}

// What `Adam` and `AdamW` share: the updated moments and the direction of the
// step, `m_hat / (sqrt(v_hat) + eps)`, before the learning rate.
fn adam_direction<T: Float + Ring, const Dims...: i32>(grad: Tensor<T, Dims...>, state: AdamState<T, Dims...>, beta1: f32, beta2: f32, eps: f32) -> (Tensor<T, Dims...>, AdamState<T, Dims...>) {
    let m: Tensor<T, Dims...> = Ring::add(Scale::scale(state.m, beta1), Scale::scale(grad, 1.0 - beta1));
    let grad_sq: Tensor<T, Dims...> = grad * grad;
    let v: Tensor<T, Dims...> = Ring::add(Scale::scale(state.v, beta2), Scale::scale(grad_sq, 1.0 - beta2));
    let beta1_pow: f32 = state.beta1_pow * beta1;
    let beta2_pow: f32 = state.beta2_pow * beta2;
    let m_hat: Tensor<T, Dims...> = Scale::scale(m, 1.0 / (1.0 - beta1_pow));
    let v_hat: Tensor<T, Dims...> = Scale::scale(v, 1.0 / (1.0 - beta2_pow));
    // `mlir::math::sqrt`, called directly on a `Tensor`-typed value, not
    // through any declared algebra -- `Transcendental<T>` only ever
    // impls scalar `f32`/`f64` (`stdlib/num/num.cleave`), and `sqrt`
    // itself was never wrapped in *any* algebra even at scalar width
    // (`Complex<T>::magnitude`, `stdlib/complex/complex.cleave`, calls
    // it the identical raw way). MLIR's own `math.sqrt` is elementwise-
    // mappable, the same structural property `arith.addf`/`mulf`
    // already lean on for `Ring<Tensor<T,Dims...>>` above -- confirmed
    // directly, not assumed: a tensor-typed operand here lowers and
    // runs correctly with zero new Rust code.
    let sqrt_v_hat: Tensor<T, Dims...> = mlir::math::sqrt(v_hat);
    // A broadcast add, not `Ring::add` (which needs *both* operands
    // already `Tensor`-shaped) -- `mlir::tensor::splat`, the exact same
    // primitive `Scale::scale`'s own body already uses internally to
    // turn one scalar into a same-shaped tensor.
    let eps_bcast: Tensor<T, Dims...> = mlir::tensor::splat(eps);
    let denom: Tensor<T, Dims...> = sqrt_v_hat + eps_bcast;
    (m_hat / denom, AdamState::<T, Dims...>(m: m, v: v, beta1_pow: beta1_pow, beta2_pow: beta2_pow))
}

impl<const R: i32, const C: i32> Optimizer<Muon, Tensor<f32, R, C>, AdamState<f32, R, C>> {
    fn init_state(opt, model) {
        AdamState::<f32, R, C>(m: Ring::zero(), v: Ring::zero(), beta1_pow: 1.0, beta2_pow: 1.0)
    }
    // Not inlined, as `Adam`'s. A row of one (a bias, a gain) goes to AdamW;
    // a matrix keeps its momentum in `state.m` (`v` unused), steps along the
    // orthogonalized Nesterov momentum, scaled by `sqrt(max(1, R / C))` so
    // that tall and wide matrices move alike, with AdamW's decoupled decay.
    #[no_inline]
    fn step(opt, model, grad, state) {
        if R == 1 {
            step(opt.adamw, model, grad, state)
        } else {
            let buf: Tensor<f32, R, C> = Scale::scale(state.m, opt.momentum) + Scale::scale(grad, 1.0 - opt.momentum);
            let nesterov: Tensor<f32, R, C> = Scale::scale(grad, 1.0 - opt.momentum) + Scale::scale(buf, opt.momentum);
            let r: f32 = R.to();
            let c: f32 = C.to();
            let aspect: f32 = if r > c { sqrt(r / c) } else { 1.0 };
            let update: Tensor<f32, R, C> = Scale::scale(newton_schulz5(nesterov), opt.lr * aspect);
            (Scale::scale(model, 1.0 - opt.lr * opt.weight_decay) - update,
             AdamState::<f32, R, C>(m: buf, v: state.v, beta1_pow: state.beta1_pow, beta2_pow: state.beta2_pow))
        }
    }
}

// The orthogonal matrix nearest to `g` (its polar factor, `U Vᵀ` of its SVD),
// approximated by five Newton-Schulz iterations of the quintic tuned for Muon
// (coefficients 3.4445, -4.7750, 2.0315): cheap, only matrix products. Run on
// the wide orientation (`R <= C`), so the products are `R x R`.
fn newton_schulz5<const R: i32, const C: i32>(g: Tensor<f32, R, C>) -> Tensor<f32, R, C> {
    if R > C { transpose(newton_schulz5_wide(transpose(g))) } else { newton_schulz5_wide(g) }
}

fn newton_schulz5_wide<const R: i32, const C: i32>(g: Tensor<f32, R, C>) -> Tensor<f32, R, C> {
    let mut sq = 0.0;
    for r in 0..R { for c in 0..C { sq = sq + g[r, c] * g[r, c]; }; };
    let mut x: Tensor<f32, R, C> = Scale::scale(g, 1.0 / (sqrt(sq) + 0.0000001));
    for i in 0..5 {
        let a: Tensor<f32, R, R> = matmul_transpose_b(x, x);
        let b: Tensor<f32, R, R> = Scale::scale(a, -4.7750) + Scale::scale(matmul(a, a), 2.0315);
        x = Scale::scale(x, 3.4445) + matmul(b, x);
    };
    x
}
