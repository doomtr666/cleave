// `MatMul` — rank-2-*specific*, deliberately not pack-generic like `Ring`/
// `Index` in `tensor.cleave`: matmul contracts one *specific* dimension
// (`Tensor<T,N,M>`'s own trailing `M` against `Tensor<T,M,K>`'s own leading
// `M`) — a real, individually-named relationship between two operands' own
// dimensions, not "however many dims, treated uniformly" the way
// elementwise ops or a flat index array are. `N`/`M`/`K` stay ordinary,
// individually-declared const generics; `Tensor<T,N,M>` is just an
// ordinary two-generic instantiation of `tensor.cleave`'s own pack-generic
// struct — ordinary generic-struct-reference machinery, unrelated to any
// of that file's own pack work, resolves it ordinarily.
//
// `+`/`*` on scalars resolve against the real stdlib `Ring` (always in the
// prelude) — no algebra declared for `matmul` shares a name with `mul`,
// and deliberately so: `algebras_with_fn` picks a candidate by name+arity
// alone, with no shape disambiguation at that stage (see `infer_call`,
// `registry.rs`'s `algebras_with_fn`) — a second algebra also declaring a
// 2-arg `mul` would make *every* `*` in a program ambiguous, including a
// genuinely scalar one. No qualified-call syntax exists yet to
// disambiguate (`doc/backlog.md`, "Qualified-call syntax"), so matrix
// multiplication is an ordinary named method, `matmul`, called directly —
// not wired to `*`.
algebra MatMul<A, B, C> {
    fn matmul(a: A, b: B) -> C;
    derivative matmul(a, b): add(matmul(d(a), b), matmul(a, d(b)));
    // The real linear-algebra adjoint of matrix multiplication: for
    // `Z = H*W` (`H: R^{n x m}`, `W: R^{m x k}`), `dH = dZ*W^T`, `dW = H^T*dZ`
    // — the two transposes are the two adjoints of the same bilinear map,
    // one per argument (`⟨Av,w⟩ = ⟨v,A^*w⟩`, `A^* = A^T` for a real matrix
    // under the standard inner product). Needs `Transpose<A,B>` (just
    // below) — unlike the `derivative` rule above (which recurses through
    // `d(a)`/`d(b)` and never itself needs a transpose), the reverse-mode
    // rule must physically reorient each operand to route the upstream
    // adjoint `u` back through the correct contracted dimension.
    adjoint matmul(a, b), u: (matmul(u, transpose(b)), matmul(transpose(a), u));
}

// The adjoint's own real dependency, not matmul's: `A: R^{n x m} -> A^T:
// R^{m x n}`. Deliberately its own algebra, rank-2-specific like `MatMul`
// itself (not pack-generic like `Ring`/`Index` in `tensor.cleave`) — a
// transpose permutes two *specific*, individually-named dimensions, the
// same reason `MatMul` itself isn't pack-generic either (see its own doc
// comment above).
algebra Transpose<A, B> {
    fn transpose(a: A) -> B;
}

impl<T: Float, const N: i32, const M: i32> Transpose<Tensor<T,N,M>, Tensor<T,M,N>> {
    fn transpose(a) {
        // No seed needed at all — `linalg.transpose` has no reduction
        // dimension (a pure permutation, every output element touched
        // exactly once), so `mlir_lower.rs::build_transpose_no_seed` builds
        // its own destination internally (`tensor.empty()`, genuinely
        // uninitialized) and a payload region that never reads it
        // (`linalg.yield` the input straight through) — see that function's
        // own doc comment for the full story, including why a `Ring::
        // zero()`-seeded accumulate used to sit here and is no longer
        // needed. `permutation: "array<i64: 1, 0>"` is the only 2D
        // permutation this impl needs — swap the two axes.
        mlir::linalg::transpose(a, permutation: "array<i64: 1, 0>")
    }
}

impl<T: Float, const N: i32, const M: i32, const K: i32>
    MatMul<Tensor<T,N,M>, Tensor<T,M,K>, Tensor<T,N,K>> {
    fn matmul(a, b) {
        // No seed needed at all any more, and deliberately so — this impl
        // used to build one here (`let init: Tensor<T,N,K> = Ring::zero();`,
        // still worth knowing about: `tensor.empty()`, uninitialized memory,
        // was tried *first*, and was a real, if long-latent, correctness
        // bug — `linalg.matmul` is documented as `C := A@B + C`, BLAS GEMM
        // semantics, and genuinely *loads* its own accumulator's current
        // value before adding into it, confirmed directly via `--dump-mlir-
        // lowered`; `matmul(a, Ring::zero())` gave tiny nonzero noise
        // instead of exactly `a` unchanged the moment a real allocation
        // pattern shift meant `tensor.empty()`'s own backing memory was no
        // longer accidentally zero). `Ring::zero()` fixed that correctly,
        // but cost a real, measured `memset` on every single call (VTune,
        // `examples/mnist-interop`: ~9.7% of wall time, `Dense<f32,784,
        // 512>`-sized zero-fills on every forward pass) — a real cost, not
        // a redundant copy `dps_rewrite.rs` could just elide the way it
        // does for a plain overwrite. `mlir_lower.rs::build_matmul_no_seed`
        // now builds this op directly (a `linalg.generic`, not the *named*
        // `linalg.matmul` this call used to become) whose own payload
        // region only ever reads the destination's *own* value on the
        // branch it never selects — see that function's own doc comment
        // for the full mechanism and why it's mathematically identical to
        // the zero-seeded version, at a fraction of the cost.
        mlir::linalg::matmul(a, b)
    }
}
