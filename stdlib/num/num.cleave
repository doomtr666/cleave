// Marks a type as "numeric" for defaulting/constraint purposes — see
// cleave/src/infer.rs's module docs on the numeric-literal gap this exists
// to eventually close (a literal's type variable should check membership
// here instead of defaulting blindly, regardless of what it got unified
// with along the way).
//
// No axioms/methods required — a pure existence-marker algebra. Nothing
// implements `Num` directly here — every concrete numeric type reaches it
// through `Int`/`Float`'s own bound below (`Infer::has_matching_impl`'s
// bound-inheritance walk: an `impl Int<i32>` counts as `Num<i32>` too,
// exactly because `algebra Int<T> : Num` says so).
algebra Num<T> {}

// `Int`/`Float` split `Num` along the one distinction a bare numeric
// literal's own text already carries (`1` vs `1.0`) — the language has no
// implicit conversions anywhere, integers and floats included, so a literal
// written with a `.` genuinely cannot become an integer type and vice versa;
// this is what makes that a real, checkable constraint rather than a
// defaulting-only hint. Each bounds on `Num` — an `impl Int<i32>` (below)
// is *all* that's declared for `i32`; no separate `impl Num<i32>` exists or
// is needed, `has_matching_impl` derives it from the bound.
algebra Int<T> : Num {}
algebra Float<T> : Num {}

// `#[mlir_type(...)]` declares this impl's own target type's MLIR
// representation generically — the type-level counterpart to `mlir::...`
// calls on the operation side below (`doc/hld.md`'s "one generic 'emit this
// named MLIR op' primitive" thesis, one level up: `mlir_lower.rs::ty_to_mlir`
// looks the name up here and parses the declared text via
// `melior::ir::Type::parse`, no per-type-name Rust match left at all).
#[mlir_type(i8)] impl Int<i8> {}
#[mlir_type(i16)] impl Int<i16> {}
#[mlir_type(i32)] impl Int<i32> {}
#[mlir_type(i64)] impl Int<i64> {}
// MLIR's own `index` type — an opaque, target-word-sized integer, the type
// every `memref`/`tensor` indexing op (`memref.load`, `tensor.extract`, ...)
// actually requires its own index *operands* to carry (a plain `i32` is
// rejected by the verifier) — `mlir_lower.rs`'s own array-indexing lowering
// already builds this conversion itself, internally (`to_index`, `arith.
// index_cast`), invisible to cleave source; a `#[mlir_type(...)]`-backed
// struct whose own operators are written directly in cleave source (`v[i]`
// through a real `Index<Container,Elem>` algebra impl, `stdlib/linalg/
// tensor.cleave`) needs to build that exact same conversion itself, so it
// needs a real cleave-level name for the destination type — no arithmetic
// of its own needed on it directly, `Int`'s own marker relationship (no
// required methods, matching `Num`'s identical "pure marker" shape above)
// is all a bare handle like this needs.
#[mlir_type(index)] impl Int<index> {}

#[mlir_type(f32)] impl Float<f32> {}
#[mlir_type(f64)] impl Float<f64> {}

// Real primitive arithmetic — the base case `doc/type_inference.md`'s
// "circular-primitive-impl problem" describes: a stub body like `fn add(x,
// y) { x + y }` has nothing to bottom out into, since every `+`/`*` is
// itself sugar for algebra dispatch, all the way down, with no intrinsic
// operation anywhere. A reserved `mlir::dialect::op(...)` call (recognized
// structurally, not algebra-dispatched — see `infer.rs::infer_expr`'s own
// `mlir::` branch) closes that: each impl below has a real body whose only
// content is a direct MLIR op call, the *entire* hardcoded-in-Rust surface
// for primitive operations shrinking to one generic op-builder
// (`mlir_lower.rs::lower_raw_mlir_op`) rather than a Rust match per op name.
algebra Ring<T> {
    fn add(a: T, b: T) -> T;
    fn sub(a: T, b: T) -> T;
    fn mul(a: T, b: T) -> T;
    fn div(a: T, b: T) -> T;
    fn neg(a: T) -> T;
    // The additive identity — "zero", genuinely a `Ring<T>`-owned concept
    // (it only means anything relative to `add`), not a separate algebra:
    // raised directly by the project owner while looking at `egraph.rs::
    // build_zero` (`derivative-independent-zero`'s own zero-construction),
    // which used to hand-recognize a pack-generic struct's own shape
    // *structurally*, in Rust — exactly the kind of hardcoded logic new
    // functionality is supposed to go through `algebra`+stdlib for instead.
    // Zero-arg, dispatched purely by the *expected* return type at each
    // call site (no argument of its own to pin `T` — same "output-only
    // generic" shape `MatMul`'s own `C` already needs, resolved the
    // identical way).
    fn zero() -> T;

    // Trusted as declared over every `impl Ring<T>` this algebra ever
    // gets (`hld.md`'s own v1 trust model — no per-impl soundness gate),
    // matching every impl actually shipped today (`i8`..`i64`, `f32`/`f64`,
    // and `examples/complex.cleave`'s own `Complex<T>`) — a future `impl
    // Ring<SomeNonCommutativeThing>` would need its own review before this
    // stays safe, same open risk `hld.md` already documents for this whole
    // mechanism generically, not something new introduced here.
    //
    // Feeds `egraph.rs`'s equality-saturation pass (`--dump-cps-optimized`/
    // `--dump-cps-equivalences` to inspect it directly) — applied by default
    // now, on both `--run` and `--dump-mlir` (see `main.rs`), so a real bug
    // in an axiom here is a real, silent miscompilation risk, not just a
    // wrong debug-flag output.
    axiom add_commutative(a, b): add(a, b) == add(b, a);
    axiom mul_commutative(a, b): mul(a, b) == mul(b, a);
    // Only ever fires for an integer `T` in practice — a float literal has
    // no e-graph representation yet (`egraph.rs`'s own module doc comment:
    // `CVal::Float` is out of scope for now), so a segment involving `x +
    // 0.0` simply never finishes translating far enough to match this,
    // rather than firing unsoundly on it.
    axiom add_zero(a): add(a, 0) == a;
    // Associativity of `add`/`sub` — a real, generically true ring law
    // (`a+b-c = a+(b-c)`), not a bespoke cancellation rule: this is what
    // lets a case like `10 + x - 10` actually regroup so the two literal
    // `10`s become siblings of the same node (`sub(10, 10)`) — only *then*
    // is there a genuinely fully-constant subtree for `ConstantFold` to
    // fold on its own (it can't look "through" an unrelated `x` in
    // between), after which `add_zero` above finishes the job. Composes
    // with `add_commutative`/`ConstantFold`/`add_zero` automatically —
    // equality saturation's whole point — rather than needing a dedicated
    // axiom per shape.
    axiom add_sub_assoc(a, b, c): sub(add(a, b), c) == add(a, sub(b, c));

    // `doc/backlog-done.md`'s own "Auto-diff v1 -> algebra-declared rules"
    // item — a derivative rule declared right here, alongside the axioms,
    // rather than hard-coded in `egraph.rs`: `derivative` is a real
    // `algebra_item` (`grammar.pest`), converted to an e-graph `Rewrite`
    // per reached concrete `T` by `egraph.rs::derivative_rule_to_rewrite`,
    // exactly the way an `axiom` already is. `d(x)` is sugar meaningful
    // only inside a `derivative` rule's own body — see `egraph.rs::build_
    // pattern`'s own doc comment.
    derivative add(a, b): add(d(a), d(b));
    derivative sub(a, b): sub(d(a), d(b));
    derivative mul(a, b): add(mul(a, d(b)), mul(d(a), b));
    // The quotient rule (`d(a/b) = (d(a)*b - a*d(b)) / b^2`) and negation's
    // own trivial rule (`d(-a) = -d(a)`) — `Ring`'s own remaining two ops,
    // completing the set alongside `add`/`sub`/`mul` above. Found missing
    // while chasing a real, separate gap: `sigmoid` (`stdlib/nn/nn.cleave`)
    // needs `div`'s own derivative to be differentiable at all through
    // `1.0 / (1.0 + exp(-x))`, and previously had no path to it whatsoever
    // (its own hand-differentiated closed form lived on `Activation<T>`
    // instead — see `Transcendental<T>`'s own doc comment below for why
    // that was the wrong layer).
    derivative div(a, b): div(sub(mul(d(a), b), mul(a, d(b))), mul(b, b));
    derivative neg(a): neg(d(a));

    // `doc/backlog.md`'s own "reverse-mode differentiation" item — a
    // parallel, *reverse*-mode counterpart to the `derivative` rules just
    // above, not a replacement for them (both coexist during the
    // migration). Where a `derivative` rule answers "what is d(this call)/
    // d(x)" for one differentiation variable `x` at a time (forward mode —
    // cost scales with the *number* of variables being differentiated
    // simultaneously, the real, measured blowup a large `Tensor`-shaped
    // parameter hits, `doc/backlog.md`'s own fuller story), an `adjoint`
    // rule answers "given `u`, the upstream adjoint of this call's own
    // *output*, what contribution flows back to each input" — the real
    // linear-algebra adjoint of each operation (`⟨Av,w⟩ = ⟨v,A*w⟩`, `A* =
    // A^T` for a real matrix), computed once per operation regardless of
    // how many leaves are ultimately being differentiated. `Ring<Tensor<T,
    // Dims...>>` (`stdlib/linalg/tensor.cleave`) needs no adjoint rules of
    // its own — inherits these exactly the way it already inherits the
    // `derivative` rules above, since both are declared once, here, on the
    // algebra itself.
    adjoint add(a, b), u: (u, u);
    adjoint sub(a, b), u: (u, neg(u));
    adjoint mul(a, b), u: (mul(u, b), mul(u, a));
    // Same quotient-rule shape as `derivative div`'s own adjoint would be,
    // rewritten from `d(a/b) = (d(a)*b - a*d(b))/b^2` into its own reverse
    // form: `da = u/b`, `db = -u*a/(b*b)` — verified directly (product
    // rule + quotient rule, `d(1/b) = -1/b^2`), not copied blind.
    adjoint div(a, b), u: (div(u, b), neg(div(mul(u, a), mul(b, b))));
    adjoint neg(a), u: neg(u);
}

// Integer negation has no dedicated `arith` op (unlike float — two's-
// complement negation is just `0 - a`, MLIR's own `arith` dialect doesn't
// wrap a redundant `negi`, confirmed directly against melior's own
// `dialect::arith` module) — `mlir::arith::subi(0, a)` through the exact
// same generic mechanism every other op here already uses, no special case.
impl Ring<i8> {
    fn add(a: i8, b: i8) -> i8 { mlir::arith::addi(a, b) }
    fn sub(a: i8, b: i8) -> i8 { mlir::arith::subi(a, b) }
    fn mul(a: i8, b: i8) -> i8 { mlir::arith::muli(a, b) }
    fn div(a: i8, b: i8) -> i8 { mlir::arith::divsi(a, b) }
    fn neg(a: i8) -> i8 { mlir::arith::subi(0, a) }
    fn zero() -> i8 { 0 }
}

impl Ring<i16> {
    fn add(a: i16, b: i16) -> i16 { mlir::arith::addi(a, b) }
    fn sub(a: i16, b: i16) -> i16 { mlir::arith::subi(a, b) }
    fn mul(a: i16, b: i16) -> i16 { mlir::arith::muli(a, b) }
    fn div(a: i16, b: i16) -> i16 { mlir::arith::divsi(a, b) }
    fn neg(a: i16) -> i16 { mlir::arith::subi(0, a) }
    fn zero() -> i16 { 0 }
}

impl Ring<i32> {
    fn add(a: i32, b: i32) -> i32 { mlir::arith::addi(a, b) }
    fn sub(a: i32, b: i32) -> i32 { mlir::arith::subi(a, b) }
    fn mul(a: i32, b: i32) -> i32 { mlir::arith::muli(a, b) }
    fn div(a: i32, b: i32) -> i32 { mlir::arith::divsi(a, b) }
    fn neg(a: i32) -> i32 { mlir::arith::subi(0, a) }
    fn zero() -> i32 { 0 }
}

impl Ring<i64> {
    fn add(a: i64, b: i64) -> i64 { mlir::arith::addi(a, b) }
    fn sub(a: i64, b: i64) -> i64 { mlir::arith::subi(a, b) }
    fn mul(a: i64, b: i64) -> i64 { mlir::arith::muli(a, b) }
    fn div(a: i64, b: i64) -> i64 { mlir::arith::divsi(a, b) }
    fn neg(a: i64) -> i64 { mlir::arith::subi(0, a) }
    fn zero() -> i64 { 0 }
}

impl Ring<f32> {
    fn add(a: f32, b: f32) -> f32 { mlir::arith::addf(a, b) }
    fn sub(a: f32, b: f32) -> f32 { mlir::arith::subf(a, b) }
    fn mul(a: f32, b: f32) -> f32 { mlir::arith::mulf(a, b) }
    fn div(a: f32, b: f32) -> f32 { mlir::arith::divf(a, b) }
    fn neg(a: f32) -> f32 { mlir::arith::negf(a) }
    fn zero() -> f32 { 0.0 }
}

impl Ring<f64> {
    fn add(a: f64, b: f64) -> f64 { mlir::arith::addf(a, b) }
    fn sub(a: f64, b: f64) -> f64 { mlir::arith::subf(a, b) }
    fn mul(a: f64, b: f64) -> f64 { mlir::arith::mulf(a, b) }
    fn div(a: f64, b: f64) -> f64 { mlir::arith::divf(a, b) }
    fn neg(a: f64) -> f64 { mlir::arith::negf(a) }
    fn zero() -> f64 { 0.0 }
}

// Named, individually-differentiable transcendental primitives — `exp`/
// `tanh` (more added when actually needed, not speculatively: `log`/`sin`/
// `cos`/... follow the identical shape). `Ring<T>`'s own `add`/`sub`/`mul`/
// `div`/`neg` already establish the pattern this follows: a `derivative`
// rule declared right alongside the primitive operation it belongs to, not
// wherever some downstream consumer happens to need it first.
//
// Found via a real, concrete case: `stdlib/nn/nn.cleave`'s own `Activation
// <T>::tanh` used to carry `tanh`'s own derivative rule directly (`Activation
// <T> { ... derivative tanh(x): ...; }`) — the wrong layer, an ML-specific
// algebra owning a fact that's actually about the *math function* tanh on
// `f32`/`f64`, nothing to do with activations specifically. Worse,
// `sigmoid` (built from `exp`/`neg`/`div`, all previously either
// undifferentiated raw `mlir::...` calls or missing their own rule) had no
// path to a derivative at all short of its own hand-written closed form —
// moving `exp` here (plus `Ring`'s own now-completed `div`/`neg` rules,
// just above) means `sigmoid`'s derivative now composes automatically via
// ordinary chain-rule saturation, the same mechanism that already handles
// any other multi-primitive expression (`x*x + y*y`), no hand-written
// `derivative sigmoid` needed at all.
algebra Transcendental<T> {
    fn exp(x: T) -> T;
    fn tanh(x: T) -> T;

    derivative exp(x): mul(exp(x), d(x));
    derivative tanh(x): mul(sub(1, mul(tanh(x), tanh(x))), d(x));

    // Reverse-mode counterparts — `Ring<T>`'s own `adjoint` rules just
    // above have the fuller doc comment on why these coexist with the
    // `derivative` rules rather than replacing them. Single-parameter
    // methods, so each body is a bare `expr` (the one contribution), not a
    // tuple — `grammar.pest`'s own `adjoint_rule_decl` doc comment.
    adjoint exp(x), u: mul(u, exp(x));
    adjoint tanh(x), u: mul(u, sub(1, mul(tanh(x), tanh(x))));
}

impl Transcendental<f32> {
    fn exp(x: f32) -> f32 { mlir::math::exp(x) }
    fn tanh(x: f32) -> f32 { mlir::math::tanh(x) }
}

impl Transcendental<f64> {
    fn exp(x: f64) -> f64 { mlir::math::exp(x) }
    fn tanh(x: f64) -> f64 { mlir::math::tanh(x) }
}

// Comparison — same reasoning and shape as `Ring` above. `eq`/`neq` are
// here rather than under a separate algebra of their own: every numeric
// type orders *and* equates, and splitting them would only mean two
// `impl` blocks per type instead of one for no expressive gain yet (unlike
// `Int`/`Float`, which really are independent, mutually-exclusive shapes).
//
// `arith.cmpi`/`arith.cmpf`'s own `predicate` attribute takes the *raw
// integer* enum ordinal, not the symbolic name (`Attribute::parse(context,
// "slt")` fails to parse -- MLIR's symbolic spellings like `slt` are custom
// *pretty-printer* syntax for specific ops, not something the generic
// attribute parser understands on its own; confirmed directly by testing
// both forms against a real `arith.cmpi` and checking `module.verify()`).
// Ordinals below match melior's own `arith::CmpiPredicate`/`CmpfPredicate`
// enum declaration order exactly (`melior-0.27.4/src/dialect/arith.rs`):
// `CmpiPredicate`: Eq=0, Ne=1, Slt=2, Sle=3, Sgt=4, Sge=5 (Ult/Ule/Ugt/Uge
// unused here — cleave's integers are signed).
// `CmpfPredicate`: Oeq=1, Ogt=2, Oge=3, Olt=4, Ole=5, One=6 (ordered
// comparisons — NaN-propagating, matching what this file's own arithmetic
// already implicitly assumes; the unordered `U*` variants are unused here).
algebra Ord<T> {
    fn lt(a: T, b: T) -> bool;
    fn le(a: T, b: T) -> bool;
    fn gt(a: T, b: T) -> bool;
    fn ge(a: T, b: T) -> bool;
    fn eq(a: T, b: T) -> bool;
    fn neq(a: T, b: T) -> bool;
}

impl Ord<i8> {
    fn lt(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i16> {
    fn lt(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i32> {
    fn lt(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i64> {
    fn lt(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<f32> {
    fn lt(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "4 : i64") }
    fn le(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "5 : i64") }
    fn gt(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "2 : i64") }
    fn ge(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "3 : i64") }
    fn eq(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "1 : i64") }
    fn neq(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "6 : i64") }
}

impl Ord<f64> {
    fn lt(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "4 : i64") }
    fn le(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "5 : i64") }
    fn gt(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "2 : i64") }
    fn ge(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "3 : i64") }
    fn eq(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "1 : i64") }
    fn neq(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "6 : i64") }
}

// `mod`/`rem` deliberately never became operators (`grammar.md`'s own
// "explicitly not given operator syntax" list) — always named functions,
// dispatched the same structural way every other algebra here is. Two
// distinct names because they genuinely differ on negative operands: `rem`
// is truncated-division remainder (sign follows the dividend `a`, same as
// C/Rust's own `%` and MLIR's `arith.remsi` directly), `mod` is
// mathematical/Euclidean modulo (sign follows the divisor `b`, always in
// `[0, b)` for a positive `b`). Integer-only for now — `arith.remf` exists
// for a float `rem`, but nothing has needed it yet; add when something does.
algebra Rem<T> {
    fn rem(a: T, b: T) -> T;
    fn mod(a: T, b: T) -> T;
}

// `arith.remsi`'s own result already *is* `rem` directly. `mod` has no
// single dedicated MLIR op — computed from it: `remsi`'s result and `b`
// have differing sign exactly when a floored correction is needed (`xor`
// on `< 0`, not `!=` -- `Ord<bool>` doesn't exist, only `Logic<bool>` does).
impl Rem<i8> {
    fn rem(a: i8, b: i8) -> i8 { mlir::arith::remsi(a, b) }
    fn mod(a: i8, b: i8) -> i8 {
        let r: i8 = mlir::arith::remsi(a, b);
        if r != 0 and ((r < 0) xor (b < 0)) { r + b } else { r }
    }
}

impl Rem<i16> {
    fn rem(a: i16, b: i16) -> i16 { mlir::arith::remsi(a, b) }
    fn mod(a: i16, b: i16) -> i16 {
        let r: i16 = mlir::arith::remsi(a, b);
        if r != 0 and ((r < 0) xor (b < 0)) { r + b } else { r }
    }
}

impl Rem<i32> {
    fn rem(a: i32, b: i32) -> i32 { mlir::arith::remsi(a, b) }
    fn mod(a: i32, b: i32) -> i32 {
        let r: i32 = mlir::arith::remsi(a, b);
        if r != 0 and ((r < 0) xor (b < 0)) { r + b } else { r }
    }
}

impl Rem<i64> {
    fn rem(a: i64, b: i64) -> i64 { mlir::arith::remsi(a, b) }
    fn mod(a: i64, b: i64) -> i64 {
        let r: i64 = mlir::arith::remsi(a, b);
        if r != 0 and ((r < 0) xor (b < 0)) { r + b } else { r }
    }
}

// Bitwise ops, `grammar.md`'s own explicit call: no operator syntax at all
// (sidesteps burning a precedence level *and* C's `&`/`|` vs `==` trap) --
// always named functions, integer-only (a bit pattern on a float is a
// different, not-yet-needed operation). `shr` is the *arithmetic*
// (sign-extending) right shift, `arith.shrsi` — cleave's integers are
// signed (see `Ord<T>`'s own comment on comparison predicates above), so
// that's the one that actually matches `>>`'s usual meaning on a signed
// type; `shrui` (logical/zero-filling) isn't exposed here since nothing
// has needed it yet.
algebra Bitwise<T> {
    fn bitand(a: T, b: T) -> T;
    fn bitor(a: T, b: T) -> T;
    fn bitxor(a: T, b: T) -> T;
    fn bitnot(a: T) -> T;
    fn shl(a: T, b: T) -> T;
    fn shr(a: T, b: T) -> T;
}

// No dedicated bitwise-complement op in `arith` either (mirrors `Ring<T>::
// neg`'s own `subi(0, a)` workaround above) — `a xor -1` (all bits set),
// through the exact same generic `mlir::...` mechanism as everything else.
// `-1` needs an explicit `let ...: i8 = -1;` type annotation, not a bare
// literal inline in the `mlir::...` call — an `mlir::` call's own arguments
// don't cross-unify with each other (no real declared signature to unify
// against), so an *inline* `-1` here independently defaults to `i32`
// regardless of `a`'s own width, mismatching for every width but `i32`
// itself (found by direct testing: `arith.xori requires the same type for
// all operands`, for `i8`/`i16`/`i64` specifically) — same reasoning as
// `Logic<bool>::implies`'s own explicit `let not_a: bool = ...` above.
impl Bitwise<i8> {
    fn bitand(a: i8, b: i8) -> i8 { mlir::arith::andi(a, b) }
    fn bitor(a: i8, b: i8) -> i8 { mlir::arith::ori(a, b) }
    fn bitxor(a: i8, b: i8) -> i8 { mlir::arith::xori(a, b) }
    fn bitnot(a: i8) -> i8 {
        let all_bits: i8 = -1;
        mlir::arith::xori(a, all_bits)
    }
    fn shl(a: i8, b: i8) -> i8 { mlir::arith::shli(a, b) }
    fn shr(a: i8, b: i8) -> i8 { mlir::arith::shrsi(a, b) }
}

impl Bitwise<i16> {
    fn bitand(a: i16, b: i16) -> i16 { mlir::arith::andi(a, b) }
    fn bitor(a: i16, b: i16) -> i16 { mlir::arith::ori(a, b) }
    fn bitxor(a: i16, b: i16) -> i16 { mlir::arith::xori(a, b) }
    fn bitnot(a: i16) -> i16 {
        let all_bits: i16 = -1;
        mlir::arith::xori(a, all_bits)
    }
    fn shl(a: i16, b: i16) -> i16 { mlir::arith::shli(a, b) }
    fn shr(a: i16, b: i16) -> i16 { mlir::arith::shrsi(a, b) }
}

impl Bitwise<i32> {
    fn bitand(a: i32, b: i32) -> i32 { mlir::arith::andi(a, b) }
    fn bitor(a: i32, b: i32) -> i32 { mlir::arith::ori(a, b) }
    fn bitxor(a: i32, b: i32) -> i32 { mlir::arith::xori(a, b) }
    fn bitnot(a: i32) -> i32 {
        let all_bits: i32 = -1;
        mlir::arith::xori(a, all_bits)
    }
    fn shl(a: i32, b: i32) -> i32 { mlir::arith::shli(a, b) }
    fn shr(a: i32, b: i32) -> i32 { mlir::arith::shrsi(a, b) }
}

impl Bitwise<i64> {
    fn bitand(a: i64, b: i64) -> i64 { mlir::arith::andi(a, b) }
    fn bitor(a: i64, b: i64) -> i64 { mlir::arith::ori(a, b) }
    fn bitxor(a: i64, b: i64) -> i64 { mlir::arith::xori(a, b) }
    fn bitnot(a: i64) -> i64 {
        let all_bits: i64 = -1;
        mlir::arith::xori(a, all_bits)
    }
    fn shl(a: i64, b: i64) -> i64 { mlir::arith::shli(a, b) }
    fn shr(a: i64, b: i64) -> i64 { mlir::arith::shrsi(a, b) }
}
