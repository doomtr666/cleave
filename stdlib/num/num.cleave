// Marks a type as "numeric" for defaulting/constraint purposes — see
// cleave/src/infer.rs's module docs on the numeric-literal gap this exists
// to eventually close (a literal's type variable should check membership
// here instead of defaulting blindly, regardless of what it got unified
// with along the way).
//
// No axioms/methods required — a pure existence-marker algebra. Nothing
// implements `Num` directly here — every concrete numeric type reaches it
// through `Int`/`Float`'s own bound below (`Infer::has_matching_impl`'s
// bound-inheritance walk: an `impl Int<i32>` counts as `Num<i32>` too,
// exactly because `algebra Int<T> : Num` says so).
algebra Num<T> {}

// `Int`/`Float` split `Num` along the one distinction a bare numeric
// literal's own text already carries (`1` vs `1.0`) — the language has no
// implicit conversions anywhere, integers and floats included, so a literal
// written with a `.` genuinely cannot become an integer type and vice versa;
// this is what makes that a real, checkable constraint rather than a
// defaulting-only hint. Each bounds on `Num` — an `impl Int<i32>` (below)
// is *all* that's declared for `i32`; no separate `impl Num<i32>` exists or
// is needed, `has_matching_impl` derives it from the bound.
algebra Int<T> : Num {}
algebra Float<T> : Num {}

// `#[mlir_type(...)]` declares this impl's own target type's MLIR
// representation generically — the type-level counterpart to `mlir::...`
// calls on the operation side below (`doc/hld.md`'s "one generic 'emit this
// named MLIR op' primitive" thesis, one level up: `mlir_lower.rs::ty_to_mlir`
// looks the name up here and parses the declared text via
// `melior::ir::Type::parse`, no per-type-name Rust match left at all).
#[mlir_type(i8)] impl Int<i8> {}
#[mlir_type(i16)] impl Int<i16> {}
#[mlir_type(i32)] impl Int<i32> {}
#[mlir_type(i64)] impl Int<i64> {}

#[mlir_type(f32)] impl Float<f32> {}
#[mlir_type(f64)] impl Float<f64> {}

// Real primitive arithmetic — the base case `doc/type_inference.md`'s
// "circular-primitive-impl problem" describes: a stub body like `fn add(x,
// y) { x + y }` has nothing to bottom out into, since every `+`/`*` is
// itself sugar for algebra dispatch, all the way down, with no intrinsic
// operation anywhere. A reserved `mlir::dialect::op(...)` call (recognized
// structurally, not algebra-dispatched — see `infer.rs::infer_expr`'s own
// `mlir::` branch) closes that: each impl below has a real body whose only
// content is a direct MLIR op call, the *entire* hardcoded-in-Rust surface
// for primitive operations shrinking to one generic op-builder
// (`mlir_lower.rs::lower_raw_mlir_op`) rather than a Rust match per op name.
algebra Ring<T> {
    fn add(a: T, b: T) -> T;
    fn sub(a: T, b: T) -> T;
    fn mul(a: T, b: T) -> T;
    fn neg(a: T) -> T;
}

// Integer negation has no dedicated `arith` op (unlike float — two's-
// complement negation is just `0 - a`, MLIR's own `arith` dialect doesn't
// wrap a redundant `negi`, confirmed directly against melior's own
// `dialect::arith` module) — `mlir::arith::subi(0, a)` through the exact
// same generic mechanism every other op here already uses, no special case.
impl Ring<i8> {
    fn add(a: i8, b: i8) -> i8 { mlir::arith::addi(a, b) }
    fn sub(a: i8, b: i8) -> i8 { mlir::arith::subi(a, b) }
    fn mul(a: i8, b: i8) -> i8 { mlir::arith::muli(a, b) }
    fn neg(a: i8) -> i8 { mlir::arith::subi(0, a) }
}

impl Ring<i16> {
    fn add(a: i16, b: i16) -> i16 { mlir::arith::addi(a, b) }
    fn sub(a: i16, b: i16) -> i16 { mlir::arith::subi(a, b) }
    fn mul(a: i16, b: i16) -> i16 { mlir::arith::muli(a, b) }
    fn neg(a: i16) -> i16 { mlir::arith::subi(0, a) }
}

impl Ring<i32> {
    fn add(a: i32, b: i32) -> i32 { mlir::arith::addi(a, b) }
    fn sub(a: i32, b: i32) -> i32 { mlir::arith::subi(a, b) }
    fn mul(a: i32, b: i32) -> i32 { mlir::arith::muli(a, b) }
    fn neg(a: i32) -> i32 { mlir::arith::subi(0, a) }
}

impl Ring<i64> {
    fn add(a: i64, b: i64) -> i64 { mlir::arith::addi(a, b) }
    fn sub(a: i64, b: i64) -> i64 { mlir::arith::subi(a, b) }
    fn mul(a: i64, b: i64) -> i64 { mlir::arith::muli(a, b) }
    fn neg(a: i64) -> i64 { mlir::arith::subi(0, a) }
}

impl Ring<f32> {
    fn add(a: f32, b: f32) -> f32 { mlir::arith::addf(a, b) }
    fn sub(a: f32, b: f32) -> f32 { mlir::arith::subf(a, b) }
    fn mul(a: f32, b: f32) -> f32 { mlir::arith::mulf(a, b) }
    fn neg(a: f32) -> f32 { mlir::arith::negf(a) }
}

impl Ring<f64> {
    fn add(a: f64, b: f64) -> f64 { mlir::arith::addf(a, b) }
    fn sub(a: f64, b: f64) -> f64 { mlir::arith::subf(a, b) }
    fn mul(a: f64, b: f64) -> f64 { mlir::arith::mulf(a, b) }
    fn neg(a: f64) -> f64 { mlir::arith::negf(a) }
}

// Comparison — same reasoning and shape as `Ring` above. `eq`/`neq` are
// here rather than under a separate algebra of their own: every numeric
// type orders *and* equates, and splitting them would only mean two
// `impl` blocks per type instead of one for no expressive gain yet (unlike
// `Int`/`Float`, which really are independent, mutually-exclusive shapes).
//
// `arith.cmpi`/`arith.cmpf`'s own `predicate` attribute takes the *raw
// integer* enum ordinal, not the symbolic name (`Attribute::parse(context,
// "slt")` fails to parse -- MLIR's symbolic spellings like `slt` are custom
// *pretty-printer* syntax for specific ops, not something the generic
// attribute parser understands on its own; confirmed directly by testing
// both forms against a real `arith.cmpi` and checking `module.verify()`).
// Ordinals below match melior's own `arith::CmpiPredicate`/`CmpfPredicate`
// enum declaration order exactly (`melior-0.27.4/src/dialect/arith.rs`):
// `CmpiPredicate`: Eq=0, Ne=1, Slt=2, Sle=3, Sgt=4, Sge=5 (Ult/Ule/Ugt/Uge
// unused here — cleave's integers are signed).
// `CmpfPredicate`: Oeq=1, Ogt=2, Oge=3, Olt=4, Ole=5, One=6 (ordered
// comparisons — NaN-propagating, matching what this file's own arithmetic
// already implicitly assumes; the unordered `U*` variants are unused here).
algebra Ord<T> {
    fn lt(a: T, b: T) -> bool;
    fn le(a: T, b: T) -> bool;
    fn gt(a: T, b: T) -> bool;
    fn ge(a: T, b: T) -> bool;
    fn eq(a: T, b: T) -> bool;
    fn neq(a: T, b: T) -> bool;
}

impl Ord<i8> {
    fn lt(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i8, b: i8) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i16> {
    fn lt(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i16, b: i16) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i32> {
    fn lt(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i32, b: i32) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<i64> {
    fn lt(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "2 : i64") }
    fn le(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "3 : i64") }
    fn gt(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "4 : i64") }
    fn ge(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "5 : i64") }
    fn eq(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "0 : i64") }
    fn neq(a: i64, b: i64) -> bool { mlir::arith::cmpi(a, b, predicate: "1 : i64") }
}

impl Ord<f32> {
    fn lt(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "4 : i64") }
    fn le(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "5 : i64") }
    fn gt(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "2 : i64") }
    fn ge(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "3 : i64") }
    fn eq(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "1 : i64") }
    fn neq(a: f32, b: f32) -> bool { mlir::arith::cmpf(a, b, predicate: "6 : i64") }
}

impl Ord<f64> {
    fn lt(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "4 : i64") }
    fn le(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "5 : i64") }
    fn gt(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "2 : i64") }
    fn ge(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "3 : i64") }
    fn eq(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "1 : i64") }
    fn neq(a: f64, b: f64) -> bool { mlir::arith::cmpf(a, b, predicate: "6 : i64") }
}
