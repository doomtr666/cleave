// `Vector<T,N>`/`Matrix<T,R,C>`/`Tensor<T,D0,D1,D2>` — ordinary, entirely
// stdlib-declared generic structs, no different in kind from `Complex<T>`
// (`stdlib/complex/complex.cleave`), except for their own `#[mlir_type(
// tensor)]` tag: the same mechanism that already declares a primitive's
// own MLIR representation (`stdlib/num/num.cleave`), generalized — see
// `mlir_lower.rs`'s own `tagged_struct_native_type` doc comment for the
// full design. Each one's real representation is a native MLIR
// `tensor<...>` value, an immutable SSA value, never the ordinary heap-
// allocated reference every other struct gets — `data`'s own declared
// array type is *only* how the compiler learns the shape structurally; a
// value of any of these three is never actually memref-backed at runtime.
// `use vector;` explicitly — not prelude, matching `io`/`complex`'s own
// precedent: a program that never constructs one sees zero change.
//
// Three separate, concretely-ranked structs, not one variadic-rank type —
// cleave has no variadic generics (a struct's own generic parameter list
// is always a fixed, declared arity), so "rank" isn't a parameter here,
// it's which of these three names you write. `Tensor` stops at rank 3
// (the common case for a scientific-computing workload — a 3-D field, a
// small batch of matrices, ...); a higher rank is the identical recipe,
// just not written out yet — added when something actually needs it, not
// speculatively.
//
// `doc/backlog.md` has the full story of why this looks the way it does:
// an earlier version made `Vector` a hardcoded new `Ty::Vector` Rust
// variant — exactly the "closing the loop" anti-pattern `doc/hld.md` warns
// against — reverted in favor of this, which needed no `Ty`/grammar
// changes at all. `Matrix`/`Tensor` were originally going to stay example-
// local (`Matrix` briefly lived in `examples/matmul.cleave` only) — moved
// here once it was clear all three are equally general-purpose, not
// specific to the matmul example.
struct Vector<T: Float, const N: i32> { data: [T; N] }
struct Matrix<T: Float, const R: i32, const C: i32> { data: [T; R, C] }
struct Tensor<T: Float, const D0: i32, const D1: i32, const D2: i32> { data: [T; D0, D1, D2] }

// `#[mlir_type(...)]` only ever decorates an `impl` block (`ast.rs`'s own
// `ImplDecl::attrs` — a bare `struct` declaration has no `attrs` of its
// own at all), the same way it already does for a primitive (`stdlib/num/
// num.cleave`'s `#[mlir_type(i32)] impl Int<i32> {}`) — `NativeShape<T>`
// is a trivial, zero-axiom marker algebra existing *purely* to be that
// `impl`'s own target carrier, mirroring `Int`/`Float`'s own identical
// "empty marker impl, the real content lives entirely in the tag" shape,
// just without also doubling as a real bound anything needs to check —
// `collect_mlir_types` (`cps.rs`) never even reads the algebra's own name,
// only the tagged `impl`'s target type and the attribute text itself.
algebra NativeShape<T> {}

#[mlir_type(tensor)]
impl<T: Float, const N: i32> NativeShape<Vector<T, N>> {}
#[mlir_type(tensor)]
impl<T: Float, const R: i32, const C: i32> NativeShape<Matrix<T, R, C>> {}
#[mlir_type(tensor)]
impl<T: Float, const D0: i32, const D1: i32, const D2: i32> NativeShape<Tensor<T, D0, D1, D2>> {}

// Elementwise `Ring` — `arith.addf`/`subf`/`mulf`/`divf`/`negf` already
// broadcast structurally over a `tensor<...>`-typed SSA operand, at any
// rank (confirmed directly for rank 1/2/3 alike, not assumed), so each
// impl below is the *exact* one-line-per-op shape every scalar `Ring`
// impl in `stdlib/num/num.cleave` already uses — no new mechanism, no
// awareness anywhere that these are anything but ordinary `Ring`-impl'd
// types.
impl<T: Float, const N: i32> Ring<Vector<T, N>> {
    fn add(a: Vector<T, N>, b: Vector<T, N>) -> Vector<T, N> { mlir::arith::addf(a, b) }
    fn sub(a: Vector<T, N>, b: Vector<T, N>) -> Vector<T, N> { mlir::arith::subf(a, b) }
    fn mul(a: Vector<T, N>, b: Vector<T, N>) -> Vector<T, N> { mlir::arith::mulf(a, b) }
    fn div(a: Vector<T, N>, b: Vector<T, N>) -> Vector<T, N> { mlir::arith::divf(a, b) }
    fn neg(a: Vector<T, N>) -> Vector<T, N> { mlir::arith::negf(a) }
}

impl<T: Float, const R: i32, const C: i32> Ring<Matrix<T, R, C>> {
    fn add(a: Matrix<T, R, C>, b: Matrix<T, R, C>) -> Matrix<T, R, C> { mlir::arith::addf(a, b) }
    fn sub(a: Matrix<T, R, C>, b: Matrix<T, R, C>) -> Matrix<T, R, C> { mlir::arith::subf(a, b) }
    fn mul(a: Matrix<T, R, C>, b: Matrix<T, R, C>) -> Matrix<T, R, C> { mlir::arith::mulf(a, b) }
    fn div(a: Matrix<T, R, C>, b: Matrix<T, R, C>) -> Matrix<T, R, C> { mlir::arith::divf(a, b) }
    fn neg(a: Matrix<T, R, C>) -> Matrix<T, R, C> { mlir::arith::negf(a) }
}

impl<T: Float, const D0: i32, const D1: i32, const D2: i32> Ring<Tensor<T, D0, D1, D2>> {
    fn add(a: Tensor<T, D0, D1, D2>, b: Tensor<T, D0, D1, D2>) -> Tensor<T, D0, D1, D2> { mlir::arith::addf(a, b) }
    fn sub(a: Tensor<T, D0, D1, D2>, b: Tensor<T, D0, D1, D2>) -> Tensor<T, D0, D1, D2> { mlir::arith::subf(a, b) }
    fn mul(a: Tensor<T, D0, D1, D2>, b: Tensor<T, D0, D1, D2>) -> Tensor<T, D0, D1, D2> { mlir::arith::mulf(a, b) }
    fn div(a: Tensor<T, D0, D1, D2>, b: Tensor<T, D0, D1, D2>) -> Tensor<T, D0, D1, D2> { mlir::arith::divf(a, b) }
    fn neg(a: Tensor<T, D0, D1, D2>) -> Tensor<T, D0, D1, D2> { mlir::arith::negf(a) }
}

// `v[i]`/`m[i,j]`/`t[i,j,k]` — none of `Vector`/`Matrix`/`Tensor` have a
// `.x`/`.y`/`.z` of their own to speak of (their sole field is the *whole*
// `data` array), so element read goes through an ordinary algebra instead
// of field access: `infer.rs`'s own `ExprKind::Index` handling falls back
// to dispatching `Index<Container, Elem, K>` whenever the base isn't a real
// array (see its own doc comment). A whole bracket group (`m[i,j]`, one
// `ast.rs::ExprKind::Index` node, not nested — see that type's own doc
// comment for why `m[i][j]`, written as two separate bracket pairs,
// deliberately does *not* reach this the same way) dispatches as *one*
// call: every index becomes one real `[i32; K]` array value at CPS time
// (`cps.rs`'s own `ExprKind::Index` doc comment), `K` the algebra's own
// const generic, pinned per impl below by a literal-sized `idx` parameter
// — `Vector` always passes exactly 1, `Matrix` exactly 2, `Tensor` exactly
// 3 — rather than left free the way `Sum<T, const N: i32>`'s own `N`
// (`cleave/tests/mlir_lower.rs::an_algebras_own_const_generic_actually_
// runs`) is: each of these three types has one fixed, intrinsic rank, so
// `m[i,j,k]` (3 indices on a `Matrix`) must be *rejected*, not silently
// accepted with the extra index ignored — a literal size on `idx` is what
// makes that a real, structural `no impl Index<Matrix<...>, [i32;3], ...>`
// mismatch rather than a silent bug.
//
// Unpacking the array back into individual `index`-typed operands
// (`idx[0]`, `idx[1]`, ...) is ordinary array indexing — already fully
// working — feeding `mlir::tensor::extract`'s own ordinary dynamic SSA
// index operands (unlike `vector.extract`'s simpler, compile-time-constant-
// only form, a genuinely runtime-computed index just works here, no
// restriction), needing only the `i32 -> index` conversion every `memref`/
// `tensor` index operand needs (`stdlib/num/num.cleave`'s own `index` type).
// Read-only, deliberately: mutation stays exclusively for a real array
// (see `infer.rs`'s own `StmtKind::Assign` guard) — a tensor-backed value
// is immutable by construction, no `IndexMut`-equivalent attempted.
algebra Index<Container, Elem, const K: i32> {
    fn index(c: Container, idx: [i32; K]) -> Elem;
}

impl<T: Float, const N: i32> Index<Vector<T, N>, T> {
    fn index(v: Vector<T, N>, idx: [i32; 1]) -> T {
        let i0: index = mlir::arith::index_cast(idx[0]);
        mlir::tensor::extract(v, i0)
    }
}

impl<T: Float, const R: i32, const C: i32> Index<Matrix<T, R, C>, T> {
    fn index(m: Matrix<T, R, C>, idx: [i32; 2]) -> T {
        let i0: index = mlir::arith::index_cast(idx[0]);
        let i1: index = mlir::arith::index_cast(idx[1]);
        mlir::tensor::extract(m, i0, i1)
    }
}

impl<T: Float, const D0: i32, const D1: i32, const D2: i32> Index<Tensor<T, D0, D1, D2>, T> {
    fn index(t: Tensor<T, D0, D1, D2>, idx: [i32; 3]) -> T {
        let i0: index = mlir::arith::index_cast(idx[0]);
        let i1: index = mlir::arith::index_cast(idx[1]);
        let i2: index = mlir::arith::index_cast(idx[2]);
        mlir::tensor::extract(t, i0, i1, i2)
    }
}

// `+`/`*` on scalars resolve against the real stdlib `Ring` (always in the
// prelude) — no algebra declared for `matmul` shares a name with `mul`,
// and deliberately so: `algebras_with_fn` picks a candidate by name+arity
// alone, with no shape disambiguation at that stage (see `infer_call`,
// `registry.rs`'s `algebras_with_fn`) — a second algebra also declaring a
// 2-arg `mul` would make *every* `*` in a program ambiguous, including a
// genuinely scalar one. No qualified-call syntax exists yet to
// disambiguate (`doc/backlog.md`, "Qualified-call syntax"), so matrix
// multiplication is an ordinary named method, `matmul`, called directly —
// not wired to `*`.
algebra MatMul<A, B, C> {
    fn matmul(a: A, b: B) -> C;
}

impl<T: Float, const N: i32, const M: i32, const K: i32>
    MatMul<Matrix<T,N,M>, Matrix<T,M,K>, Matrix<T,N,K>> {
    fn matmul(a, b) {
        // `tensor.empty()` — zero operands, shape from its own declared
        // result type alone — is all `linalg.matmul`'s required `outs`
        // operand needs: the op computes the *entire* result itself, it
        // never accumulates into whatever `outs` previously held, so no
        // real zero-initialization is needed the way `vector.contract`'s
        // own accumulator once needed (see `doc/backlog.md`).
        // `operandSegmentSizes` (2 `ins`, 1 `outs`) is an ordinary
        // attribute, the same generic mechanism every other `mlir::...`
        // call already uses — `linalg.matmul`'s own payload *region*
        // (the actual multiply-accumulate body) is the one place this
        // project's generic op-builder needed a real, dialect-family-wide
        // exception; see `mlir_lower.rs::build_linalg_region`'s own doc
        // comment for exactly why and how it's scoped.
        let init: Matrix<T,N,K> = mlir::tensor::empty();
        mlir::linalg::matmul(a, b, init, operandSegmentSizes: "array<i32: 2, 1>")
    }
}
