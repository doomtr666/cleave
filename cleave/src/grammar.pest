// cleave surface grammar — first pass, matches doc/grammar.md
// Scope: matches Phase 1 (see doc/hld.md) for semantic processing (no closures yet).
// while/for parse (the grammar is a funnel, wider than what the rest of the
// pipeline processes yet) but aren't wired into CPS conversion/the e-graph.

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* }

program = { SOI ~ item* ~ EOI }

item = { use_decl | struct_decl | algebra_decl | impl_decl | fn_decl }

// ---------------------------------------------------------------- crates
// `use linalg;` (or `use linalg::Matrix;`) is the only mechanism — no separate
// declaration to discover files. Resolution (compiler-driver concern, not Pest's):
// search a path list (project source root, then the shipped standard library) for
// a directory literally named `linalg`; every `.cleave` file in it is crate `linalg`
// (a directory *is* a crate, strictly — no file elsewhere can claim to contribute to
// it, no per-file redeclaration). Language-owned discovery (no external build tool
// decides membership, the point that mattered from the Rust-vs-CMake comparison),
// without Rust's separate mod-vs-crate distinction or its file=namespace 1:1 tax,
// and without Go's domain-qualified naming + `replace`-escape-hatch friction (crate
// names are short, local, human-chosen — not resolved yet: global uniqueness across
// a public package ecosystem, deferred, not needed at this project's current scope).
use_decl = { "use" ~ path ~ ";" }
path     = { ident ~ ("::" ~ ident)* }

// ---------------------------------------------------------------- fn

// `#[mlir(mlir_f32_add_instruction)]` -- a general annotation mechanism,
// though the one real case so far is a body-justifying attribute on an
// otherwise-bodyless algebra-impl method (see `fn_decl`'s own trailing
// `(block | ";")` below). `attribute_arg` stays a bare `ident` on purpose --
// not a general `expr` -- the same "don't accept more than the one real
// case needs yet" restriction `array_repeat`'s own count already uses;
// nothing here is evaluated, just a name the eventual MLIR-lowering pass
// will read back out.
attribute     = { "#" ~ "[" ~ ident ~ ("(" ~ attribute_arg ~ ("," ~ attribute_arg)* ~ ")")? ~ "]" }
attribute_arg = { ident }

// The trailing `(block | ";")` is deliberately permissive here -- *every*
// `fn` (top-level, algebra-impl, inherent-impl) may omit its body at the
// grammar level; "must have one unless it's an algebra-impl method carrying
// a recognized body-justifying attribute" is a *semantic* check
// (`infer.rs`), not a grammatical one -- same posture `const R: Int`
// parsing fine and being rejected later already established.
fn_decl = { attribute* ~ "fn" ~ ident ~ generic_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_)? ~ (block | ";") }

generic_params = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ">" }
generic_param  = { "const" ~ ident ~ ":" ~ type_ | ident ~ (":" ~ bound_list)? }
bound_list     = { ident ~ ("+" ~ ident)* }

param_list = { param ~ ("," ~ param)* }
param      = { ident ~ (":" ~ type_)? }

// ---------------------------------------------------------------- struct
struct_decl = { "struct" ~ ident ~ generic_params? ~ "{" ~ field_list? ~ "}" }
field_list  = { field ~ ("," ~ field)* ~ ","? }
field       = { ident ~ ":" ~ type_ }

// ---------------------------------------------------------------- algebra
// "algebra" is the working keyword from hld.md's closing section; naming
// (vs. a separate axiom-free "signature") is still open, see conversation notes.
algebra_decl = { "algebra" ~ ident ~ generic_params? ~ (":" ~ bound_list)? ~ "{" ~ algebra_item* ~ "}" }
algebra_item = { fn_sig | axiom_decl }
fn_sig       = { "fn" ~ ident ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_)? ~ ";" }
// the equality itself is just an ordinary `expr` (comparison already handles `==`);
// no separate "==" token here, or it would conflict with comparison's own greedy parse.
axiom_decl   = { "axiom" ~ ident ~ "(" ~ param_list? ~ ")" ~ ":" ~ expr ~ ";" }

// ---------------------------------------------------------------- impl
// Two shapes: an *algebra* impl (dispatches `add`/`gt`/... through the
// registry, see `infer.rs`) and an *inherent* impl (ordinary methods
// belonging directly to one `struct`, no algebra involved — `v.len()`
// dispatches by looking `len` up among `Vec2`'s own inherent methods, not
// through any registry-mediated interface).
//
// A genuinely ambiguous case forced a real disambiguator here, not just
// alternative ordering — found by testing: `impl<T> Boxed<T> { ... }`
// parses *identically* either way (`algebra_impl`: algebra `Boxed`, target
// the bare type `T`; `inherent_impl`: target the single type `Boxed<T>`),
// since a struct with exactly *one* generic parameter produces the exact
// same character sequence as an algebra name immediately followed by its
// own single-type target. Trying `algebra_impl` first (as an earlier
// version of this grammar did) doesn't fail cleanly on this input the way
// it does for a genuinely non-algebra shape — it *fully matches*, wrongly,
// silently treating `Boxed` as an algebra name. This is exactly the
// problem Rust's own `impl Trait for Type` vs. `impl Type` solves with a
// `for` keyword; the leading `struct` keyword plays the identical role
// here (reusing an existing token rather than inventing a new one) —
// required on *every* inherent impl, not just the ambiguous generic case,
// for one uniform rule rather than two special-cased shapes.
impl_decl = { algebra_impl | inherent_impl }
// `impl<T: Float> TestAlg<Complex<T>> { ... }` — an impl's own generic
// parameters (distinct from the *algebra*'s own `<T>` in `algebra
// TestAlg<T> { ... }`), needed once the target itself is generic
// (`Complex<T>`, not a bare concrete type) — reuses `generic_params`, the
// same shape `fn_decl`/`struct_decl`/`algebra_decl` already declare theirs
// with. One or more targets, comma-separated, positionally matching the
// algebra's own generic parameter list — `algebra Ring<T>` (one generic)
// still only ever takes one (`impl Ring<Vec2>`, the overwhelmingly common
// case, unchanged), but a genuinely heterogeneous algebra like
// `algebra MatMul<A, B, C>` needs `impl<...> MatMul<Matrix<T,N,M>,
// Matrix<T,M,K>, Matrix<T,N,K>>` — three independently-typed parameters, not
// one type substituted for all three (see `infer.rs`'s own module docs on
// why a single-target impl can't express that).
algebra_impl  = { "impl" ~ generic_params? ~ ident ~ "<" ~ type_ ~ ("," ~ type_)* ~ ">" ~ "{" ~ fn_decl* ~ "}" }
// `impl struct Vec2 { fn len(v) { ... } }` — no algebra name, no dispatch
// through the registry; `target` is an ordinary `type_` (usually just a
// bare struct name, `Vec2`, but can carry its own generic arguments the
// same way a field/parameter type can, `impl<T> struct Matrix<T, R, C>`).
// The first parameter of a method declared here plays the role a `self`
// parameter would in a language with one — ordinary, explicit, no special
// syntax, same "nothing magic, just the first positional argument" stance
// this project already takes everywhere else (see `grammar.md`).
inherent_impl = { "impl" ~ generic_params? ~ "struct" ~ type_ ~ "{" ~ fn_decl* ~ "}" }

// ---------------------------------------------------------------- types
// arrays are the 1D primitive (see grammar.md, "Primitives + arrays") — Matrix/Tensor
// (multi-dim, strided) are algebras built on top, not a separate native array type.
type_       = { fn_type | array_type | path ~ ("<" ~ generic_arg ~ ("," ~ generic_arg)* ~ ">")? }
// A function type, for annotating a higher-order-function parameter
// (`fn apply(f: (i32) -> i32, x: i32) -> i32 { f(x) }`) — mirrors `Ty::Fn`
// (already used internally for a lambda's own inferred type) with actual
// surface syntax to *write* one, previously missing entirely. `(` can't
// otherwise start a `type_` (no parenthesized-type grouping exists), so
// there's no ambiguity to resolve by ordering here, unlike `expr`'s own
// `(` overload (parenthesized expr vs. call arguments) — `type_` has no
// such second meaning for a leading `(` to compete with. The return type is
// mandatory, unlike `fn_decl`'s own optional `-> type_` (a function
// *declaration* can leave its return type to be inferred from its body;
// a type *annotation* has no body to infer anything from, so nothing to
// default to `()` from — matches every other type-annotation position in
// this grammar, all of which are fully explicit, never partially inferred).
fn_type     = { "(" ~ (type_ ~ ("," ~ type_)*)? ~ ")" ~ "->" ~ type_ }
// a generic argument is either a type or a const-generic value — numeric (`Matrix<f64, 3,
// 3>`'s dimensions) or boolean (`Grid<true>`'s flag). `numeric_lit`/`bool_lit` are tried
// *before* `type_`, not after: a bare number could never start a `path` (idents can't begin
// with a digit) so that half is unambiguous either way, but `true`/`false` *would* otherwise
// parse as an ordinary (bogus) `path` — `ident` has no keyword exclusion anywhere in this
// grammar (see `primary`'s own `literal | path` ordering for the same reason) — so `type_`
// must lose that race, not win it.
generic_arg = { numeric_lit | bool_lit | type_ }
// Fortran-style sugar: `[f64; 3, 4]` for a fixed-size 3x4 block, desugars (at AST-building
// time, not here) to the nested form `[[f64; 4]; 3]` — same semantics/layout either way.
array_type  = { "[" ~ type_ ~ ";" ~ expr ~ ("," ~ expr)* ~ "]" }

// ---------------------------------------------------------------- statements / blocks
block       = { "{" ~ stmt* ~ expr? ~ "}" }
stmt        = { let_stmt | assign_stmt | expr_stmt }
// `mut` wrapped in its own rule (rather than a bare literal) so its presence
// is actually visible as a pair — a bare string literal leaves no trace at
// all in pest's output, making "was `mut` there?" undetectable otherwise.
let_stmt    = { "let" ~ mut_kw? ~ ident ~ (":" ~ type_)? ~ "=" ~ expr ~ ";" }
mut_kw      = { "mut" }
// reassignment of an existing `let mut` binding — bare `=`, no `let` (see grammar.md).
// The target can be a plain name (`x = v;`) or a field/index chain into one
// (`arr[i] = v;`, `arr[i,j] = v;`, `self.values[i] = v;`) — same shape as
// `postfix_op` (see below) minus the call-args/method-call alternative, since
// you can't assign through a method call.
assign_stmt   = { assign_target ~ "=" ~ expr ~ ";" }
assign_target = { ident ~ assign_suffix* }
assign_suffix = { "." ~ ident | "[" ~ expr ~ ("," ~ expr)* ~ "]" }
expr_stmt   = { expr ~ ";" }

// ---------------------------------------------------------------- expressions
// precedence, low to high:
// implication -> logical (and/or/xor) -> comparison -> additive -> multiplicative -> unary -> postfix -> primary
expr = { implication }

// standard propositional-logic precedence: implication binds looser than and/or/xor
// (`a and b implies c or d` reads as `(a and b) implies (c or d)`).
implication = { logical ~ (implies_op ~ logical)* }
implies_op  = { "implies" }

logical    = { comparison ~ (logical_op ~ comparison)* }
logical_op = { "and" | "or" | "xor" }

comparison = { additive ~ (comp_op ~ additive)* }
comp_op    = { "<=" | ">=" | "==" | "!=" | "<" | ">" }

additive = { multiplicative ~ (add_op ~ multiplicative)* }
add_op   = { "+" | "-" }

multiplicative = { unary ~ (mul_op ~ unary)* }
mul_op         = { "*" | "/" }

unary = { "-" ~ unary | postfix }

postfix     = { primary ~ postfix_op* }
// `a[i, j]` — Fortran-style sugar for nested indexing `a[i][j]`, same desugaring principle
// as the multi-dim array_type above.
// `call_args` wrapped in its own rule so its mere *presence* (even with zero
// arguments, `.f()`) is visible — otherwise `.x` (field access) and `.f()`
// (zero-arg method call) both produce identical pairs (just `ident`), since
// an empty `arg_list?` and an absent one are indistinguishable on their own.
postfix_op  = { "." ~ ident ~ call_args? | "[" ~ expr ~ ("," ~ expr)* ~ "]" }
call_args   = { "(" ~ arg_list? ~ ")" }

// `call_expr` before `struct_lit`, deliberately: `f()` (a zero-arg call) and
// `Empty()` (a zero-*field* struct construction) are syntactically
// identical, and PEG commits to the first alternative that fully matches —
// `arg_list?`/`field_init_list?` are both optional, so an empty `()` always
// matches `call_expr` first. This resolves correctly for the common case
// (`make()`, an ordinary call, must never be mistaken for constructing a
// struct named `make`) at the cost of a narrow remaining gap: a *genuinely*
// zero-field struct's own construction syntax is indistinguishable from a
// zero-arg call at parse time and falls through to `call_expr` too — see
// `infer_call`'s own fallback, which special-cases exactly this one
// remaining case (a zero-arg call naming a known, zero-field struct) rather
// than leaving it as a silent "unresolved call".
primary = { if_expr | while_expr | for_expr | array_lit | lambda_expr | call_expr | struct_lit | literal | path | "(" ~ expr ~ ")" | block }

// `fn(a, b) { a + b }` — the same shape as `fn_decl`, minus the name: an
// anonymous function value is "a `fn` without a name", not a separate
// syntactic concept (deliberately not Rust's `|a, b| ...` — see conversation
// notes: this project collapses near-duplicate constructs rather than
// growing a second one, same reasoning that collapsed trait+signature into
// `algebra` and mod+module into `use`). No generics here — a generic
// anonymous value isn't a need this surfaces yet; can be added later without
// disrupting this shape. Calling a lambda *literal* directly
// (`(fn(a,b){a+b})(1,2)`) isn't supported yet — only calling a `let` binding
// that holds one (`postfix`'s `call_expr` still requires a bare `path` as
// callee) — deliberately deferred, see infer.rs's module docs.
lambda_expr = { "fn" ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_)? ~ block }

// qualified calls (`Ring::add(a, b)`) need the same path as plain references —
// `path`'s single-segment case still covers a bare `add(a, b)`.
call_expr = { path ~ turbofish? ~ "(" ~ arg_list? ~ ")" }
arg_list  = { expr ~ ("," ~ expr)* }

// `fibonacci::<f64>(x)` / `Matrix::<f64, 4, 4>(values: ...)` — explicit type/const-generic
// arguments at a call or struct-construction site, for when nothing about the arguments
// themselves pins the instantiation down (see `infer.rs`'s own doc comment on
// `ExprKind::Call`/`StructLit` for why relying on an incidentally-suffixed literal to
// propagate the right type through unification was a real, reported ergonomics problem, not
// just cosmetic). The double-colon isn't decorative: bare `f<T>(...)` in *expression*
// position is genuinely ambiguous with `f < T > (...)` (three chained `<`/`>` comparisons) —
// this grammar has no semantic lookahead to disambiguate the way a hand-written parser might,
// so `::<` has to be its own unambiguous token sequence, exactly the reasoning Rust's own
// turbofish exists for. `generic_arg` reused verbatim — same shape as a type's own `<...>`
// argument list.
turbofish = { "::" ~ "<" ~ generic_arg ~ ("," ~ generic_arg)* ~ ">" }

// Struct construction: `Vec2(x: 1.0, y: 2.0)` — named-argument call syntax,
// deliberately *not* Rust's `Vec2 { x: 1.0, y: 2.0 }`. Braces-after-path
// would collide with `if`/`while`/`for`'s own condition-then-block shape
// (`if x { y }` — is `x { y }` a struct literal, or is `{ y }` the `if`'s
// block?), which is exactly the ambiguity Rust itself has to special-case
// away (disallowing a bare struct literal in condition position). Reusing
// `(...)` sidesteps it entirely — this parses identically to an ordinary
// call, distinguished only by its arguments being `ident ":" expr` pairs
// instead of bare expressions; `call_expr` is still tried *before*
// `struct_lit` in `primary` (see that rule's own comment — a *zero-arg* call
// and a *zero-field* struct construction are otherwise indistinguishable),
// so this only ever gets reached once `call_expr` has already failed to
// consume a field's `:`. Every field must be named (no positional struct
// construction) — matches the "closing the loop" instinct of writing the
// field name at every
// construction site, not just relying on argument order to line up with a
// declaration that might be far away.
struct_lit      = { path ~ turbofish? ~ "(" ~ field_init_list? ~ ")" }
field_init_list = { field_init ~ ("," ~ field_init)* }
field_init      = { ident ~ ":" ~ expr }

if_expr = { "if" ~ expr ~ block ~ ("else" ~ (if_expr | block))? }

// parses (funnel grammar), not yet wired into CPS conversion/the e-graph — see top-of-file note.
while_expr = { "while" ~ expr ~ block }
for_expr   = { "for" ~ ident ~ "in" ~ additive ~ ".." ~ additive ~ block }

// `[value; N]` -- repeat sugar. `N` a literal `numeric_lit` desugars at
// *lowering* time (not inference time, unlike `array_type`'s own `[T; N]`
// size slot) into N copies of `value` -- lowering is a purely syntactic pass
// with no unification machinery, so it can only expand a count it can
// already read off the token stream. `N` an `ident` instead names a const
// generic of the enclosing fn/impl (`[0.0; N]`); lowering can't expand that
// (its value isn't known until monomorphization), so it stays a real
// `ExprKind::ArrayRepeat` node, resolved through ordinary type inference
// (see `infer.rs`) like everything else -- deliberately restricted to
// `numeric_lit | ident` rather than a general `expr`: this names a
// compile-time integer (a literal or a const-generic reference), not a
// computation. `array_repeat`/`array_list` are distinct named rules (not
// just two shapes folded into one), so lowering can tell which one actually
// matched -- both produce a flat sequence of `expr` children on their own,
// indistinguishable from each other without this.
array_lit    = { "[" ~ (array_repeat | array_list)? ~ "]" }
array_repeat = { expr ~ ";" ~ (numeric_lit | ident) }
array_list   = { expr ~ ("," ~ expr)* }

// ---------------------------------------------------------------- literals
literal = { imaginary_lit | numeric_lit | bool_lit }

// digits, optional fraction, optional exponent — int vs. float is a semantic
// distinction (presence of '.'/exponent), not a separate grammar production,
// to avoid the ordered-choice partial-match pitfall (see conversation notes).
number_body   = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
imaginary_lit = @{ number_body ~ "i" }
numeric_lit   = @{ number_body ~ type_suffix? }
type_suffix   = { ":" ~ ident }
bool_lit      = { "true" | "false" }

// Unicode identifier syntax (Unicode Standard Annex #31, XID_Start/XID_Continue) —
// the same standard Rust itself uses, not a hand-picked "just Greek letters" range.
// Superset of the plain-ASCII rule this replaces (XID_Start/Continue include ASCII).
ident = @{ (XID_START | "_") ~ XID_CONTINUE* }
