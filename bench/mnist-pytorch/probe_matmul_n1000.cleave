use nn;
use linalg;
use io;

fn main() -> i32 {
    rand_seed(1);
    let a: Tensor<f32, 32, 784> = Init::xavier();
    let b: Tensor<f32, 784, 512> = Init::xavier();
    let mut total: f32 = 0.0;
    for i in 0..1000 {
        let c = matmul(a, b);
        total = total + c[0, 0];
    };
    println(total);
    0
}
