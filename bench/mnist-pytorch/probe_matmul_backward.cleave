use nn;
use linalg;
use io;

fn loss(x: Tensor<f32, 32, 784>, w: Tensor<f32, 784, 512>) -> f32 {
    let z = matmul(x, w);
    sum(z * z)
}

grad_loss = grad(loss);

export fn probe() -> f32 {
    rand_seed(1);
    let x: Tensor<f32, 32, 784> = Init::xavier();
    let w: Tensor<f32, 784, 512> = Init::xavier();
    let g = grad_loss(x, w);
    sum(g.1)
}
